---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="H2H Laptop" description="Bandingkan dua laptop secara head-to-head berdasarkan spesifikasi lengkap.">
  <style>
    .page-header {
      margin-bottom: 28px;
      background:
        linear-gradient(135deg, rgba(18,4,2,0.92) 0%, rgba(28,6,3,0.82) 40%, rgba(15,4,2,0.90) 100%),
        url('/planet-mars.jpg') center/cover no-repeat;
      border: 1px solid rgba(239,68,68,0.25);
      border-radius: 16px; padding: 48px 40px; position: relative; overflow: hidden;
      box-shadow: 0 0 60px rgba(239,68,68,0.10);
    }
    .page-header::before {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background:
        radial-gradient(ellipse at 50% 50%, rgba(239,68,68,0.20) 0%, transparent 58%),
        radial-gradient(ellipse at 80% 25%, rgba(251,146,60,0.12) 0%, transparent 45%);
    }
    .page-header h1 { font-size: 2rem; font-weight: 800; color: #e2e8f0; margin-bottom: 6px; position: relative; z-index: 1; text-shadow: 0 0 32px rgba(239,68,68,0.65); }
    .page-header p { color: rgba(255,255,255,0.7); position: relative; z-index: 1; }

    /* FILTER BUTTONS */
    .filter-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
    .filter-row label { font-size: 0.78rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap; }
    .filter-btns { display: flex; gap: 8px; flex-wrap: wrap; }
    .filter-btn {
      padding: 6px 14px; border: 1px solid rgba(255,255,255,0.1);
      border-radius: 20px; font-size: 0.82rem; font-weight: 600; cursor: pointer;
      background: rgba(255,255,255,0.04); color: #94a3b8; transition: all 0.15s;
    }
    .filter-btn:hover { border-color: rgba(96,165,250,0.4); color: #60a5fa; }
    .filter-btn.active { background: rgba(96,165,250,0.15); color: #60a5fa; border-color: rgba(96,165,250,0.4); }
    .gpu-btn.active { background: rgba(167,139,250,0.15); color: #a78bfa; border-color: rgba(167,139,250,0.4); }

    /* SELECTOR */
    .selector-wrap { display: grid; grid-template-columns: 1fr auto 1fr; gap: 16px; align-items: center; margin-bottom: 28px; }
    .selector-box { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.09); border-radius: 12px; padding: 20px; }
    .selector-box label { display: block; font-size: 0.78rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }
    .custom-select { position: relative; }
    .cs-input {
      width: 100%; padding: 10px 12px; border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px; font-size: 0.95rem; color: #e2e8f0;
      background: rgba(255,255,255,0.06); cursor: text; box-sizing: border-box;
    }
    .cs-input:focus { outline: none; border-color: rgba(96,165,250,0.5); background: rgba(96,165,250,0.06); }
    .cs-input::placeholder { color: #475569; }
    .cs-dropdown {
      position: absolute; top: calc(100% + 4px); left: 0; right: 0;
      background: #0d1130; border: 1px solid rgba(96,165,250,0.2);
      border-radius: 8px; max-height: 260px; overflow-y: auto; z-index: 200; display: none;
      box-shadow: 0 8px 32px rgba(0,0,0,0.5);
    }
    .cs-dropdown.open { display: block; }
    .cs-option { padding: 10px 12px; font-size: 0.88rem; cursor: pointer; color: #cbd5e1; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .cs-option:last-child { border-bottom: none; }
    .cs-option:hover { background: rgba(96,165,250,0.1); color: #60a5fa; }
    .cs-option.selected { background: rgba(96,165,250,0.12); color: #60a5fa; font-weight: 600; }
    /* LIGHT MODE: dropdown & input agar terbaca (sebelumnya panel gelap di background terang) */
    :global(html[data-theme="light"]) .cs-dropdown { background: #ffffff; border-color: rgba(37,99,235,0.25); box-shadow: 0 8px 32px rgba(15,23,42,0.15); }
    :global(html[data-theme="light"]) .cs-option { color: #1e293b; border-bottom-color: rgba(15,23,42,0.08); }
    :global(html[data-theme="light"]) .cs-input { color: #0f172a; background: #f1f5f9; border-color: rgba(15,23,42,0.15); }
    :global(html[data-theme="light"]) .cs-input::placeholder { color: #94a3b8; }
    .vs-badge {
      text-align: center; font-size: 1.3rem; font-weight: 900; color: #60a5fa;
      background: rgba(96,165,250,0.12); border-radius: 50%;
      width: 52px; height: 52px; display: flex; align-items: center; justify-content: center;
      margin: 0 auto; border: 1px solid rgba(96,165,250,0.3);
      box-shadow: 0 0 20px rgba(96,165,250,0.2);
    }

    .placeholder {
      background: rgba(255,255,255,0.03); border: 2px dashed rgba(255,255,255,0.1);
      border-radius: 12px; padding: 60px 24px; text-align: center; color: #475569; font-size: 1rem;
    }
    .compare-wrap { display: none; }
    .compare-wrap.show { display: block; }

    /* HEADER CARDS with win counter */
    .laptop-headers { display: grid; grid-template-columns: 200px 1fr 1fr; gap: 0; margin-bottom: 0; }
    .header-empty { background: transparent; }
    .laptop-card {
      border: 2px solid rgba(255,255,255,0.1); border-radius: 12px 12px 0 0;
      padding: 18px 20px; text-align: center; position: relative;
    }
    .laptop-card.card-a { border-color: rgba(96,165,250,0.5); background: rgba(96,165,250,0.07); }
    .laptop-card.card-b { border-color: rgba(167,139,250,0.5); background: rgba(167,139,250,0.07); }
    .card-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 6px; }
    .card-a .card-label { color: #60a5fa; }
    .card-b .card-label { color: #a78bfa; }
    .card-name { font-size: 0.95rem; font-weight: 700; color: #e2e8f0; margin-bottom: 4px; }
    .card-price { font-size: 1rem; font-weight: 800; color: #34d399; margin-bottom: 10px; }
    .win-counter {
      display: inline-flex; align-items: center; gap: 5px;
      font-size: 0.82rem; font-weight: 700; padding: 4px 12px;
      border-radius: 20px;
    }
    .card-a .win-counter { background: rgba(96,165,250,0.15); color: #93c5fd; border: 1px solid rgba(96,165,250,0.25); }
    .card-b .win-counter { background: rgba(167,139,250,0.15); color: #c4b5fd; border: 1px solid rgba(167,139,250,0.25); }

    /* SPEC TABLE */
    .spec-table { width: 100%; border-collapse: collapse; border: 1px solid rgba(255,255,255,0.09); border-top: none; }
    .spec-table tr:nth-child(even) { background: rgba(255,255,255,0.015); }
    .spec-table td {
      padding: 12px 16px; border-bottom: 1px solid rgba(255,255,255,0.05);
      font-size: 0.9rem; vertical-align: middle; color: #cbd5e1;
    }
    .spec-table td:first-child {
      width: 200px; font-weight: 600; color: #64748b; font-size: 0.8rem;
      text-transform: uppercase; letter-spacing: 0.03em;
      background: rgba(255,255,255,0.02); border-right: 1px solid rgba(255,255,255,0.07);
    }
    /* Section header rows */
    .spec-table tr.section-row td {
      background: rgba(255,255,255,0.04); color: #94a3b8;
      font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em;
      text-transform: uppercase; padding: 8px 16px;
      border-top: 1px solid rgba(255,255,255,0.08);
    }
    .spec-table tr.section-row td:first-child { color: #94a3b8; background: rgba(255,255,255,0.04); border-right: none; }

    /* Draw */
    .spec-table td.draw { color: #94a3b8; }

    /* Win — green highlight */
    .spec-table td.win-a,
    .spec-table td.win-b {
      background: rgba(52,211,153,0.12);
      font-weight: 700; color: #6ee7b7;
      border-left: 3px solid rgba(52,211,153,0.6);
    }
    .win-icon { display: none; }

    .badge-gpu { display: inline-block; padding: 3px 10px; border-radius: 6px; font-size: 0.82rem; font-weight: 700; background: rgba(251,191,36,0.15); color: #fbbf24; }
    .badge-cpu-intel { background: rgba(96,165,250,0.12); color: #60a5fa; display: inline-block; padding: 3px 10px; border-radius: 6px; font-size: 0.82rem; font-weight: 700; }
    .badge-cpu-amd { background: rgba(239,68,68,0.12); color: #f87171; display: inline-block; padding: 3px 10px; border-radius: 6px; font-size: 0.82rem; font-weight: 700; }
    .check { color: #34d399; font-weight: 700; }
    .dash { color: #334155; }
    .no-data { color: #475569; font-style: italic; font-size: 0.82rem; }

    /* VERDICT */
    .verdict {
      margin-top: 0; background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08); border-top: none;
      border-radius: 0 0 12px 12px; padding: 24px;
    }
    .verdict h3 { font-size: 1rem; font-weight: 700; margin-bottom: 16px; color: #e2e8f0; }
    .verdict-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
    .verdict-col { padding: 16px; border-radius: 10px; }
    .verdict-col.col-a { background: rgba(96,165,250,0.07); border: 1px solid rgba(96,165,250,0.2); }
    .verdict-col.col-b { background: rgba(167,139,250,0.07); border: 1px solid rgba(167,139,250,0.2); }
    .verdict-col h4 { font-size: 0.82rem; font-weight: 700; margin-bottom: 10px; }
    .col-a h4 { color: #60a5fa; }
    .col-b h4 { color: #a78bfa; }
    .verdict-col ul { list-style: none; padding: 0; margin: 0; }
    .verdict-col ul li { font-size: 0.85rem; color: #94a3b8; padding: 3px 0; }
    .verdict-col ul li::before { content: "✓ "; color: #34d399; font-weight: 700; }
    .winner-banner {
      padding: 14px 20px; border-radius: 8px; font-weight: 700; font-size: 0.95rem; text-align: center;
      background: rgba(52,211,153,0.1); color: #34d399; border: 1px solid rgba(52,211,153,0.3);
    }

    @media (max-width: 640px) {
      .page-header { padding: 36px 20px; }
      .selector-wrap { grid-template-columns: 1fr; }
      .laptop-headers { grid-template-columns: 100px 1fr 1fr; }
      .spec-table td:first-child { width: 100px; font-size: 0.72rem; }
    }
  </style>

  <div class="page-header">
    <h1>⚔️ H2H Laptop</h1>
    <p>Pilih dua laptop dan bandingkan spesifikasi mereka secara langsung.</p>
  </div>

  <!-- BUDGET FILTER -->
  <div class="filter-row">
    <label>Budget:</label>
    <div class="filter-btns">
      <button class="filter-btn active" data-min="0" data-max="999" id="b-all">Semua</button>
      <button class="filter-btn" data-min="0" data-max="8">Di bawah 8 Jt</button>
      <button class="filter-btn" data-min="8" data-max="10">8–10 Jt</button>
      <button class="filter-btn" data-min="10" data-max="12">10–12 Jt</button>
      <button class="filter-btn" data-min="12" data-max="15">12–15 Jt</button>
      <button class="filter-btn" data-min="15" data-max="18">15–18 Jt</button>
      <button class="filter-btn" data-min="18" data-max="21">18–21 Jt</button>
      <button class="filter-btn" data-min="21" data-max="24">21–24 Jt</button>
      <button class="filter-btn" data-min="24" data-max="999">24 Jt ke atas</button>
    </div>
  </div>
  <div class="filter-row">
    <label>GPU:</label>
    <div class="filter-btns">
      <button class="filter-btn gpu-btn active" data-gpu="all">Semua</button>
      <button class="filter-btn gpu-btn" data-gpu="integrated">Integrated</button>
      <button class="filter-btn gpu-btn" data-gpu="dedicated">Dedicated</button>
      <button class="filter-btn gpu-btn" data-gpu="RTX 3050">RTX 3050</button>
      <button class="filter-btn gpu-btn" data-gpu="RTX 4050">RTX 4050</button>
      <button class="filter-btn gpu-btn" data-gpu="RTX 5050">RTX 5050</button>
      <button class="filter-btn gpu-btn" data-gpu="RTX 5060">RTX 5060</button>
      <button class="filter-btn gpu-btn" data-gpu="RTX 5070">RTX 5070</button>
      <button class="filter-btn gpu-btn" data-gpu="RTX 5070 Ti">RTX 5070 Ti</button>
      <button class="filter-btn gpu-btn" data-gpu="RTX 5080">RTX 5080</button>
    </div>
  </div>

  <!-- SELECTOR -->
  <div class="selector-wrap">
    <div class="selector-box">
      <label>Laptop A</label>
      <div class="custom-select" id="cs-a">
        <input type="text" class="cs-input" id="sel-a-input" placeholder="Cari laptop..." autocomplete="off">
        <div class="cs-dropdown" id="sel-a-dropdown"></div>
      </div>
    </div>
    <div class="vs-badge">VS</div>
    <div class="selector-box">
      <label>Laptop B</label>
      <div class="custom-select" id="cs-b">
        <input type="text" class="cs-input" id="sel-b-input" placeholder="Cari laptop..." autocomplete="off">
        <div class="cs-dropdown" id="sel-b-dropdown"></div>
      </div>
    </div>
  </div>

  <div class="placeholder" id="placeholder">
    Pilih dua laptop di atas untuk melihat perbandingan spesifikasi lengkap.
  </div>

  <div class="compare-wrap" id="compare-wrap">
    <div class="laptop-headers">
      <div class="header-empty"></div>
      <div class="laptop-card card-a">
        <div class="card-label">Laptop A</div>
        <div class="card-name" id="name-a">—</div>
        <div class="card-price" id="price-a">—</div>
        <div class="win-counter" id="wins-a">0 unggul</div>
      </div>
      <div class="laptop-card card-b">
        <div class="card-label">Laptop B</div>
        <div class="card-name" id="name-b">—</div>
        <div class="card-price" id="price-b">—</div>
        <div class="win-counter" id="wins-b">0 unggul</div>
      </div>
    </div>

    <table class="spec-table">
      <tbody id="spec-tbody"></tbody>
    </table>

    <div class="verdict">
      <h3>📊 Kesimpulan Perbandingan</h3>
      <div class="verdict-grid">
        <div class="verdict-col col-a">
          <h4 id="verdict-name-a">Laptop A</h4>
          <ul id="verdict-pros-a"></ul>
        </div>
        <div class="verdict-col col-b">
          <h4 id="verdict-name-b">Laptop B</h4>
          <ul id="verdict-pros-b"></ul>
        </div>
      </div>
      <div class="winner-banner" id="winner-banner"></div>
    </div>
  </div>

