---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="H2H Laptop" description="Bandingkan dua laptop secara head-to-head berdasarkan spesifikasi lengkap.">
  <style>
    .page-header { margin-bottom: 28px; }
    .page-header h1 { font-size: 2rem; font-weight: 800; margin-bottom: 6px; }
    .page-header p { color: #6b7280; }

    /* SELECTOR */
    .selector-wrap {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 16px;
      align-items: center;
      margin-bottom: 32px;
    }

    .selector-box {
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 20px;
    }

    .selector-box label {
      display: block;
      font-size: 0.78rem;
      font-weight: 700;
      color: #6b7280;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 8px;
    }

    .custom-select { position: relative; }

    .cs-input {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      font-size: 0.95rem;
      color: #111;
      background: #f9fafb;
      cursor: text;
      box-sizing: border-box;
    }

    .cs-input:focus { outline: none; border-color: #2563eb; background: white; }

    .cs-dropdown {
      position: absolute;
      top: calc(100% + 4px);
      left: 0; right: 0;
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      max-height: 260px;
      overflow-y: auto;
      z-index: 200;
      display: none;
      box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    }

    .cs-dropdown.open { display: block; }

    .cs-option {
      padding: 10px 12px;
      font-size: 0.88rem;
      cursor: pointer;
      color: #111;
      border-bottom: 1px solid #f3f4f6;
    }

    .cs-option:last-child { border-bottom: none; }
    .cs-option:hover { background: #eff6ff; color: #2563eb; }
    .cs-option.selected { background: #eff6ff; color: #2563eb; font-weight: 600; }
    .cs-option.hidden { display: none; }

    .vs-badge {
      text-align: center;
      font-size: 1.5rem;
      font-weight: 900;
      color: #2563eb;
      background: #eff6ff;
      border-radius: 50%;
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto;
      border: 2px solid #bfdbfe;
    }

    /* PLACEHOLDER */
    .placeholder {
      background: white;
      border: 2px dashed #e5e7eb;
      border-radius: 12px;
      padding: 60px 24px;
      text-align: center;
      color: #9ca3af;
      font-size: 1rem;
    }

    /* COMPARISON TABLE */
    .compare-wrap { display: none; }
    .compare-wrap.show { display: block; }

    /* HEADER CARDS */
    .laptop-headers {
      display: grid;
      grid-template-columns: 220px 1fr 1fr;
      gap: 0;
      margin-bottom: 0;
    }

    .header-empty { background: transparent; }

    .laptop-card {
      background: white;
      border: 2px solid #e5e7eb;
      border-radius: 12px 12px 0 0;
      padding: 20px;
      text-align: center;
    }

    .laptop-card.card-a { border-color: #2563eb; }
    .laptop-card.card-b { border-color: #7c3aed; }

    .laptop-card .card-label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 8px;
    }

    .card-a .card-label { color: #2563eb; }
    .card-b .card-label { color: #7c3aed; }

    .laptop-card .card-name {
      font-size: 1rem;
      font-weight: 700;
      color: #111;
      margin-bottom: 4px;
    }

    .laptop-card .card-price {
      font-size: 1.1rem;
      font-weight: 800;
      color: #059669;
    }

    /* TABLE */
    .spec-table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      border: 1px solid #e5e7eb;
      border-top: none;
      border-radius: 0 0 12px 12px;
      overflow: hidden;
    }

    .spec-table tr:nth-child(even) { background: #f9fafb; }

    .spec-table td {
      padding: 13px 16px;
      border-bottom: 1px solid #f3f4f6;
      font-size: 0.9rem;
      vertical-align: middle;
    }

    .spec-table td:first-child {
      width: 220px;
      font-weight: 600;
      color: #6b7280;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      background: #f9fafb;
      border-right: 1px solid #e5e7eb;
    }

    .spec-table td.win-a { background: #eff6ff; font-weight: 700; color: #1d4ed8; }
    .spec-table td.win-b { background: #f5f3ff; font-weight: 700; color: #6d28d9; }
    .spec-table td.draw { color: #374151; }

    .badge-gpu {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 6px;
      font-size: 0.82rem;
      font-weight: 700;
      background: #fef3c7;
      color: #92400e;
    }

    .badge-cpu-intel { background: #eff6ff; color: #1e40af; display: inline-block; padding: 3px 10px; border-radius: 6px; font-size: 0.82rem; font-weight: 700; }
    .badge-cpu-amd { background: #fff7ed; color: #c2410c; display: inline-block; padding: 3px 10px; border-radius: 6px; font-size: 0.82rem; font-weight: 700; }

    .check { color: #059669; font-weight: 700; }
    .dash { color: #9ca3af; }

    /* VERDICT */
    .verdict {
      margin-top: 24px;
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 24px;
    }

    .verdict h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 16px; color: #111; }

    .verdict-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

    .verdict-col { padding: 16px; border-radius: 8px; }
    .verdict-col.col-a { background: #eff6ff; border: 1px solid #bfdbfe; }
    .verdict-col.col-b { background: #f5f3ff; border: 1px solid #ddd6fe; }

    .verdict-col h4 { font-size: 0.85rem; font-weight: 700; margin-bottom: 8px; }
    .col-a h4 { color: #1d4ed8; }
    .col-b h4 { color: #6d28d9; }

    .verdict-col ul { list-style: none; padding: 0; }
    .verdict-col ul li { font-size: 0.875rem; color: #374151; padding: 3px 0; }
    .verdict-col ul li::before { content: "✓ "; color: #059669; font-weight: 700; }

    .winner-banner {
      margin-top: 16px;
      padding: 14px 20px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.95rem;
      text-align: center;
      background: #f0fdf4;
      color: #166534;
      border: 1px solid #bbf7d0;
    }
    /* BUDGET FILTER */
    .budget-filter {
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .budget-filter label {
      font-size: 0.78rem;
      font-weight: 700;
      color: #6b7280;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      white-space: nowrap;
    }

    .budget-btns {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .budget-btn {
      padding: 6px 14px;
      border: 1px solid #e5e7eb;
      border-radius: 20px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      background: white;
      color: #374151;
      transition: all 0.15s;
    }

    .budget-btn:hover { border-color: #2563eb; color: #2563eb; }
    .budget-btn.active { background: #2563eb; color: white; border-color: #2563eb; }

    /* GPU FILTER */
    .gpu-filter {
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .gpu-filter label {
      font-size: 0.78rem;
      font-weight: 700;
      color: #6b7280;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      white-space: nowrap;
    }
    .gpu-btns {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .gpu-btn {
      padding: 6px 14px;
      border: 1px solid #e5e7eb;
      border-radius: 20px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      background: white;
      color: #374151;
      transition: all 0.15s;
    }
    .gpu-btn:hover { border-color: #7c3aed; color: #7c3aed; }
    .gpu-btn.active { background: #7c3aed; color: white; border-color: #7c3aed; }
  </style>

  <div class="page-header">
    <h1>⚔️ H2H Laptop</h1>
    <p>Pilih dua laptop dan bandingkan spesifikasi mereka secara langsung.</p>
  </div>

  <!-- BUDGET FILTER -->
  <div class="budget-filter">
    <label>Filter Budget:</label>
    <div class="budget-btns">
      <button class="budget-btn active" data-min="0" data-max="999">Semua</button>
      <button class="budget-btn" data-min="0" data-max="8">Di bawah 8 Jt</button>
      <button class="budget-btn" data-min="8" data-max="10">8–10 Jt</button>
      <button class="budget-btn" data-min="10" data-max="12">10–12 Jt</button>
      <button class="budget-btn" data-min="12" data-max="999">12 Jt ke atas</button>
    </div>
  </div>

  <!-- GPU FILTER -->
  <div class="gpu-filter">
    <label>Filter GPU:</label>
    <div class="gpu-btns">
      <button class="gpu-btn active" data-gpu="all">Semua</button>
      <button class="gpu-btn" data-gpu="integrated">Integrated</button>
      <button class="gpu-btn" data-gpu="dedicated">Dedicated</button>
      <button class="gpu-btn" data-gpu="RTX 3050">RTX 3050</button>
      <button class="gpu-btn" data-gpu="RTX 4050">RTX 4050</button>
      <button class="gpu-btn" data-gpu="RTX 5050">RTX 5050</button>
    </div>
  </div>

  <!-- SELECTOR -->
  <div class="selector-wrap">
    <div class="selector-box">
      <label>Laptop A</label>
      <div class="custom-select" id="cs-a">
        <input type="text" class="cs-input" id="sel-a-input" placeholder="Cari laptop..." autocomplete="off">
        <div class="cs-dropdown" id="sel-a-dropdown"></div>
      </div>
    </div>
    <div class="vs-badge">VS</div>
    <div class="selector-box">
      <label>Laptop B</label>
      <div class="custom-select" id="cs-b">
        <input type="text" class="cs-input" id="sel-b-input" placeholder="Cari laptop..." autocomplete="off">
        <div class="cs-dropdown" id="sel-b-dropdown"></div>
      </div>
    </div>
  </div>

  <!-- PLACEHOLDER -->
  <div class="placeholder" id="placeholder">
    Pilih dua laptop di atas untuk melihat perbandingan spesifikasi lengkap.
  </div>

  <!-- COMPARISON -->
  <div class="compare-wrap" id="compare-wrap">
    <div class="laptop-headers">
      <div class="header-empty"></div>
      <div class="laptop-card card-a">
        <div class="card-label">Laptop A</div>
        <div class="card-name" id="name-a">—</div>
        <div class="card-price" id="price-a">—</div>
      </div>
      <div class="laptop-card card-b">
        <div class="card-label">Laptop B</div>
        <div class="card-name" id="name-b">—</div>
        <div class="card-price" id="price-b">—</div>
      </div>
    </div>

    <table class="spec-table">
      <tbody id="spec-tbody"></tbody>
    </table>

    <div class="verdict">
      <h3>📊 Kesimpulan</h3>
      <div class="verdict-grid">
        <div class="verdict-col col-a">
          <h4 id="verdict-name-a">Laptop A</h4>
          <ul id="verdict-pros-a"></ul>
        </div>
        <div class="verdict-col col-b">
          <h4 id="verdict-name-b">Laptop B</h4>
          <ul id="verdict-pros-b"></ul>
        </div>
      </div>
      <div class="winner-banner" id="winner-banner"></div>
    </div>
  </div>

