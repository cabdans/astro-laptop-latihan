    const selA = document.getElementById('sel-a');
    const selB = document.getElementById('sel-b');
    const placeholder = document.getElementById('placeholder');
    const compareWrap = document.getElementById('compare-wrap');

    // Populate selects
    laptops.forEach(l => {
      [selA, selB].forEach(sel => {
        const opt = document.createElement('option');
        opt.value = l.id;
        opt.textContent = `${l.nama} (${l.harga})`;
        sel.appendChild(opt);
      });
    });

    function cpuBadge(cpu, merk) {
      const cls = merk === 'Intel' ? 'badge-cpu-intel' : 'badge-cpu-amd';
      return `<span class="${cls}">${merk}</span> ${cpu}`;
    }

    function gpuBadge(gpu) {
      if (gpu === 'Integrated') return '<span style="color:#6b7280">Integrated</span>';
      return `<span class="badge-gpu">${gpu}</span>`;
    }

    function srgbBadge(v) {
      return v ? '<span class="check">✅ Ada</span>' : '<span class="dash">—</span>';
    }

    function render() {
      const a = laptops.find(l => l.id === selA.value);
      const b = laptops.find(l => l.id === selB.value);

      if (!a || !b || a.id === b.id) {
        placeholder.style.display = '';
        compareWrap.classList.remove('show');
        if (a && b && a.id === b.id) placeholder.textContent = 'Pilih dua laptop yang berbeda.';
        else placeholder.textContent = 'Pilih dua laptop di atas untuk melihat perbandingan spesifikasi lengkap.';
        return;
      }

      placeholder.style.display = 'none';
      compareWrap.classList.add('show');

      document.getElementById('name-a').textContent = a.nama;
      document.getElementById('price-a').textContent = a.harga;
      document.getElementById('name-b').textContent = b.nama;
      document.getElementById('price-b').textContent = b.harga;

      // Rows: [label, valA, valB, compareType]
      // compareType: 'higher' (lebih besar = menang), 'lower' (lebih kecil = menang), 'equal' (tidak ada pemenang)
      const rows = [
        ['Kategori', a.kategori, b.kategori, 'equal'],
        ['Merk', a.merk, b.merk, 'equal'],
        ['Harga', a.harga, b.harga, 'lower', a.hargaNum, b.hargaNum],
        ['CPU', cpuBadge(a.cpu, a.cpuMerk), cpuBadge(b.cpu, b.cpuMerk), 'equal'],
        ['GPU', gpuBadge(a.gpu), gpuBadge(b.gpu), 'higher', a.gpuNum, b.gpuNum],
        ['RAM', a.ram, b.ram, 'equal'],
        ['Kapasitas RAM', `${a.ramSize} GB`, `${b.ramSize} GB`, 'higher', a.ramSize, b.ramSize],
        ['Layar', a.layar, b.layar, 'equal'],
        ['Refresh Rate', `${a.layarHz} Hz`, `${b.layarHz} Hz`, 'higher', a.layarHz, b.layarHz],
        ['100% sRGB', srgbBadge(a.srgb), srgbBadge(b.srgb), 'higher', a.srgb ? 1 : 0, b.srgb ? 1 : 0],
        ['Baterai', a.baterai, b.baterai, 'equal'],
        ['Berat', a.berat, b.berat, 'equal'],
        ['Garansi', a.garansi, b.garansi, 'equal'],
        ['OS', a.os, b.os, 'equal'],
      ];

      let winsA = 0, winsB = 0;
      const prosA = [], prosB = [];

      const tbody = document.getElementById('spec-tbody');
      tbody.innerHTML = '';

      rows.forEach(([label, vA, vB, type, numA, numB]) => {
        let clsA = 'draw', clsB = 'draw';
        if (type !== 'equal' && numA !== undefined) {
          if (numA !== numB) {
            const aWins = type === 'higher' ? numA > numB : numA < numB;
            if (aWins) { clsA = 'win-a'; winsA++; prosA.push(label); }
            else { clsB = 'win-b'; winsB++; prosB.push(label); }
          }
        }
        tbody.innerHTML += `<tr>
          <td>${label}</td>
          <td class="${clsA}">${vA}</td>
          <td class="${clsB}">${vB}</td>
        </tr>`;
      });

      // Verdict
      document.getElementById('verdict-name-a').textContent = a.nama;
      document.getElementById('verdict-name-b').textContent = b.nama;

      const ulA = document.getElementById('verdict-pros-a');
      const ulB = document.getElementById('verdict-pros-b');
      ulA.innerHTML = prosA.length ? prosA.map(p => `<li>${p}</li>`).join('') : '<li style="color:#9ca3af;list-style:none">Tidak unggul di kategori ini</li>';
      ulB.innerHTML = prosB.length ? prosB.map(p => `<li>${p}</li>`).join('') : '<li style="color:#9ca3af;list-style:none">Tidak unggul di kategori ini</li>';

      const banner = document.getElementById('winner-banner');
      if (winsA > winsB) banner.textContent = `🏆 ${a.nama} unggul di lebih banyak kategori (${winsA} vs ${winsB})`;
      else if (winsB > winsA) banner.textContent = `🏆 ${b.nama} unggul di lebih banyak kategori (${winsB} vs ${winsA})`;
      else banner.textContent = `🤝 Kedua laptop seimbang (${winsA} vs ${winsB})`;
    }

    selA.addEventListener('change', render);
    selB.addEventListener('change', render);
  </script>
</BaseLayout>
