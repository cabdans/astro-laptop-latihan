      { id:"acer-nitro-v15", nama:"Acer Nitro V15 RTX 5050", harga:"Rp 15–16 Jt", hargaNum:15.5, merk:"Acer", kategori:"Gaming", cpu:"Intel Core i5-13420H", cpuMerk:"Intel", gpu:"RTX 5050", gpuNum:5, ram:"DDR4", ramSize:16, layar:"15\" FHD 180Hz", layarHz:180, srgb:true, baterai:"57Wh", berat:"2.2 kg", garansi:"2 Tahun", os:"Windows 11", tdp:"45W", tgp:"75W", slug:"/review/gaming/acer-nitro-v15-5050", charger:"135W" },
      { id:"asus-tuf-a16", nama:"ASUS TUF Gaming A16 FA607NUG", harga:"Rp 17–18 Jt", hargaNum:17.5, merk:"ASUS", kategori:"Gaming", cpu:"AMD Ryzen 7 7445HS", cpuMerk:"AMD", gpu:"RTX 4050", gpuNum:4, ram:"DDR5", ramSize:16, layar:"16\" WUXGA 165Hz", layarHz:165, srgb:true, baterai:"90Wh", berat:"2.2 kg", garansi:"2 Tahun", os:"Windows 11", tdp:"35–54W", tgp:"115W+25W", slug:"/review/gaming/asus-tuf-gaming-a16", charger:"240W" },
      { id:"asus-tuf-a16-rtx5050", nama:"ASUS TUF A16 FA608UH RTX 5050", harga:"Rp 19–20 Jt", hargaNum:19.5, merk:"ASUS", kategori:"Gaming", cpu:"AMD Ryzen AI 7 260", cpuMerk:"AMD", gpu:"RTX 5050", gpuNum:5, ram:"DDR5", ramSize:16, layar:"16\" WUXGA 165Hz", layarHz:165, srgb:true, baterai:"90Wh", berat:"2.2 kg", garansi:"2 Tahun", os:"Windows 11", tdp:"28W", tgp:"115W", slug:"/review/gaming/asus-tuf-a16-fa608uh-rtx5050", charger:"240W" }
    ];

    const placeholder = document.getElementById('placeholder');
    const compareWrap = document.getElementById('compare-wrap');
    let selectedA = '', selectedB = '';

    function buildDropdown(inputId, dropdownId, onSelect) {
      const input = document.getElementById(inputId);
      const dropdown = document.getElementById(dropdownId);
      laptops.forEach(l => {
        const div = document.createElement('div');
        div.className = 'cs-option';
        div.dataset.value = l.id;
        div.textContent = l.nama + ' (' + l.harga + ')';
        div.addEventListener('mousedown', e => {
          e.preventDefault();
          onSelect(l.id, l.nama + ' (' + l.harga + ')');
          dropdown.classList.remove('open');
        });
        dropdown.appendChild(div);
      });
      input.addEventListener('focus', () => { dropdown.classList.add('open'); filterOptions(input, dropdown); });
      input.addEventListener('blur', () => setTimeout(() => dropdown.classList.remove('open'), 150));
      input.addEventListener('input', () => filterOptions(input, dropdown));
    }

    function filterOptions(input, dropdown) {
      const q = input.value.toLowerCase().trim();
      dropdown.querySelectorAll('.cs-option').forEach(opt => {
        const laptop = laptops.find(l => l.id === opt.dataset.value);
        const inFilters = !laptop || matchesFilters(laptop);
        const matchSearch = !q || opt.textContent.toLowerCase().includes(q);
        opt.style.display = (inFilters && matchSearch) ? '' : 'none';
      });
    }

    function setSelected(dropdownId, value) {
      document.getElementById(dropdownId).querySelectorAll('.cs-option').forEach(opt => {
        opt.classList.toggle('selected', opt.dataset.value === value);
      });
    }

    buildDropdown('sel-a-input', 'sel-a-dropdown', (id, label) => {
      selectedA = id; document.getElementById('sel-a-input').value = label;
      setSelected('sel-a-dropdown', id); render();
    });
    buildDropdown('sel-b-input', 'sel-b-dropdown', (id, label) => {
      selectedB = id; document.getElementById('sel-b-input').value = label;
      setSelected('sel-b-dropdown', id); render();
    });

    let budgetMin = 0, budgetMax = 999, gpuFilter = 'all';

    function matchesFilters(laptop) {
      if (!laptop) return true;
      const inBudget = laptop.hargaNum >= budgetMin && laptop.hargaNum <= budgetMax;
      let inGpu = gpuFilter === 'all' ? true
        : gpuFilter === 'integrated' ? laptop.gpu === 'Integrated'
        : gpuFilter === 'dedicated' ? laptop.gpu !== 'Integrated'
        : laptop.gpu === gpuFilter;
      return inBudget && inGpu;
    }

    function applyFilters() {
      ['sel-a-dropdown','sel-b-dropdown'].forEach(id => {
        document.getElementById(id).querySelectorAll('.cs-option').forEach(opt => {
          const laptop = laptops.find(l => l.id === opt.dataset.value);
          opt.style.display = matchesFilters(laptop) ? '' : 'none';
        });
      });
    }

    document.querySelectorAll('.filter-row .filter-btn:not(.gpu-btn)').forEach(btn => {
      btn.addEventListener('click', () => {
        btn.closest('.filter-btns').querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        budgetMin = parseFloat(btn.dataset.min); budgetMax = parseFloat(btn.dataset.max);
        ['sel-a-input','sel-b-input'].forEach((inpId, i) => {
          const id = i === 0 ? selectedA : selectedB;
          const lp = laptops.find(l => l.id === id);
          if (lp && !matchesFilters(lp)) { if (i===0) selectedA=''; else selectedB=''; document.getElementById(inpId).value=''; }
        });
        applyFilters(); render();
      });
    });

    document.querySelectorAll('.gpu-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.gpu-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        gpuFilter = btn.dataset.gpu;
        ['sel-a-input','sel-b-input'].forEach((inpId, i) => {
          const id = i === 0 ? selectedA : selectedB;
          const lp = laptops.find(l => l.id === id);
          if (lp && !matchesFilters(lp)) { if (i===0) selectedA=''; else selectedB=''; document.getElementById(inpId).value=''; }
        });
        applyFilters(); render();
      });
    });

    const cpuBench = {
      'Intel Core i5-13420H':     { nano:46, pmS:3357,  pmM:16934, eff:57 },
      'Intel Core Ultra 5 125H':  { nano:53, pmS:3336,  pmM:20314, eff:68 },
      'Intel Core Ultra 5 115U':  { nano:40, pmS:2950,  pmM:10800, eff:65 },
      'Intel Core i3-1315U':      { nano:41, pmS:3285,  pmM:11109, eff:60 },
      'Intel Core 5 210H':        { nano:50, pmS:3525,  pmM:18310, eff:66 },
      'AMD Ryzen 5 7535HS':       { nano:46, pmS:3105,  pmM:17651, eff:68 },
      'AMD Ryzen 5 8640HS':       { nano:52, pmS:3523,  pmM:19897, eff:76 },
      'AMD Ryzen 5 7430U':        { nano:43, pmS:2929,  pmM:15484, eff:70 },
      'AMD Ryzen 7 8840HS':       { nano:58, pmS:3589,  pmM:24807, eff:76 },
      'AMD Ryzen 7 8745HS':       { nano:61, pmS:3727,  pmM:28675, eff:77 },
      'AMD Ryzen 7 7735HS':       { nano:52, pmS:3251,  pmM:22369, eff:68 },
    };

    function getBench(cpu) { return cpuBench[cpu] || null; }

    function benchCell(b, key) {
      if (!b) return { html:'<span class="no-data">No Data</span>', num: null };
      return { html: b[key].toLocaleString('id-ID'), num: b[key] };
    }

    function cpuBadge(cpu, merk) {
      const cls = merk === 'Intel' ? 'badge-cpu-intel' : 'badge-cpu-amd';
      const model = cpu.replace(/^(Intel|AMD)\s+/i, '');
      return '<span class="' + cls + '">' + merk + '</span> ' + model;
    }

    function parseWh(s) { const m = s.match(/(\d+)/); return m ? parseInt(m[1]) : 0; }
    function parseKg(s) { const m = s.match(/([\d.]+)/); return m ? parseFloat(m[1]) : 999; }
    function parseTgp(s) { const m = s.replace(/[±~]/g,'').match(/(\d+)/); return m ? parseInt(m[1]) : 0; }
    function ramRank(r) { return r==='DDR5'||r==='LPDDR5X'||r==='LPDDR5' ? 2 : r==='DDR4'||r==='LPDDR4X' ? 1 : 0; }
    function chargerBadge(c) {
      if (!c) return '—';
      const isTypeC = c.includes('Type-C');
      return c + (isTypeC ? ' <span style="color:#22d3ee;font-size:0.75rem;font-weight:700">⚡USB-C</span>' : '');
    }
    function batteryChargerBadge(l) {
      const bat = l.baterai || '—';
      const chg = l.charger || '—';
      const typec = chg.includes('Type-C') ? ' <span style="color:#22d3ee;font-size:0.75rem;font-weight:700">⚡USB-C</span>' : '';
      const chgNum = chg.replace(' Type-C','');
      return bat + ' <span style="color:#64748b;font-size:0.85rem">/ ' + chgNum + '</span>' + typec;
    }

    function gpuBadge(gpu) {
      return gpu === 'Integrated'
        ? '<span style="color:#6b7280">Integrated</span>'
        : '<span class="badge-gpu">' + gpu + '</span>';
    }

    function srgbBadge(v) {
      return v ? '<span class="check">✅ Ada</span>' : '<span class="dash">—</span>';
    }

    function render() {
      const a = laptops.find(l => l.id === selectedA);
      const b = laptops.find(l => l.id === selectedB);
      if (!a || !b || a.id === b.id) {
        placeholder.style.display = '';
        compareWrap.classList.remove('show');
        placeholder.textContent = (a && b && a.id===b.id) ? 'Pilih dua laptop yang berbeda.' : 'Pilih dua laptop di atas untuk melihat perbandingan spesifikasi lengkap.';
        return;
      }
      placeholder.style.display = 'none';
      compareWrap.classList.add('show');

      document.getElementById('name-a').textContent = a.nama;
      document.getElementById('price-a').textContent = a.harga;
      document.getElementById('name-b').textContent = b.nama;
      document.getElementById('price-b').textContent = b.harga;

      const bA = getBench(a.cpu), bB = getBench(b.cpu);

      // Section headers + data rows
      // [type, label, htmlA, htmlB, numA, numB]
      // type: 'section' | 'row-equal' | 'row-higher' | 'row-lower'
      const rows = [
        ['section', 'Identitas', '', '', null, null],
        ['row-equal', 'Kategori', a.kategori, b.kategori, null, null],
        ['row-equal', 'Merk', a.merk, b.merk, null, null],
        ['row-lower', 'Harga', a.harga, b.harga, a.hargaNum, b.hargaNum],
        ['section', 'Layar & Baterai', '', '', null, null],
        ['row-equal', 'Layar', a.layar, b.layar, null, null],
        ['row-higher', 'Refresh Rate', a.layarHz + ' Hz', b.layarHz + ' Hz', a.layarHz, b.layarHz],
        ['row-higher', '100% sRGB', srgbBadge(a.srgb), srgbBadge(b.srgb), a.srgb?1:0, b.srgb?1:0],
        ['row-higher', 'Baterai / Charger', batteryChargerBadge(a), batteryChargerBadge(b), parseWh(a.baterai), parseWh(b.baterai)],
        ['section', 'Hardware', '', '', null, null],
        ['row-equal', 'CPU', cpuBadge(a.cpu, a.cpuMerk), cpuBadge(b.cpu, b.cpuMerk), null, null],
        ['row-higher', 'GPU', gpuBadge(a.gpu), gpuBadge(b.gpu), a.gpuNum, b.gpuNum],
        ['row-higher', 'Tipe RAM', a.ram, b.ram, ramRank(a.ram), ramRank(b.ram)],
        ['row-higher', 'Kapasitas RAM', a.ramSize + ' GB', b.ramSize + ' GB', a.ramSize, b.ramSize],
        ['section', 'Fisik & Garansi', '', '', null, null],
        ['row-lower', 'Bobot', a.berat, b.berat, parseKg(a.berat), parseKg(b.berat)],
        ['row-equal', 'Garansi', a.garansi, b.garansi, null, null],
        ['row-equal', 'OS', a.os, b.os, null, null],
        ['row-equal', 'TDP (CPU)', a.tdp||'—', b.tdp||'—', null, null],
        ['row-higher', 'TGP (GPU)', a.tgp||'—', b.tgp||'—', parseTgp(a.tgp||'0'), parseTgp(b.tgp||'0')],
        ['section', 'Benchmark CPU', '', '', null, null],
        ['row-higher', 'NanoReview Score', benchCell(bA,'nano').html, benchCell(bB,'nano').html, benchCell(bA,'nano').num, benchCell(bB,'nano').num],
        ['row-higher', 'Power Efficiency', benchCell(bA,'eff').html, benchCell(bB,'eff').html, benchCell(bA,'eff').num, benchCell(bB,'eff').num],
        ['row-higher', 'Passmark Single-Thread', benchCell(bA,'pmS').html, benchCell(bB,'pmS').html, benchCell(bA,'pmS').num, benchCell(bB,'pmS').num],
        ['row-higher', 'Passmark Multi-Thread', benchCell(bA,'pmM').html, benchCell(bB,'pmM').html, benchCell(bA,'pmM').num, benchCell(bB,'pmM').num],
      ];

      let winsA = 0, winsB = 0;
      const prosA = [], prosB = [];
      const tbody = document.getElementById('spec-tbody');
      tbody.innerHTML = '';

      rows.forEach(([type, label, vA, vB, numA, numB]) => {
        if (type === 'section') {
          tbody.innerHTML += '<tr class="section-row"><td colspan="3">' + label + '</td></tr>';
          return;
        }
        let clsA = 'draw', clsB = 'draw', iconA = '', iconB = '';
        if (type !== 'row-equal' && numA !== null && numB !== null) {
          if (numA !== numB) {
            const aWins = type === 'row-higher' ? numA > numB : numA < numB;
            if (aWins) { clsA = 'win-a'; iconA = '<span class="win-icon">🏆</span>'; winsA++; prosA.push(label); }
            else { clsB = 'win-b'; iconB = '<span class="win-icon">🏆</span>'; winsB++; prosB.push(label); }
          }
        }
        tbody.innerHTML += '<tr><td>' + label + '</td><td class="' + clsA + '">' + vA + iconA + '</td><td class="' + clsB + '">' + vB + iconB + '</td></tr>';
      });

      // Update win counters in header
      document.getElementById('wins-a').textContent = '🏆 ' + winsA + ' unggul';
      document.getElementById('wins-b').textContent = '🏆 ' + winsB + ' unggul';

      document.getElementById('verdict-name-a').textContent = a.nama;
      document.getElementById('verdict-name-b').textContent = b.nama;
      const ulA = document.getElementById('verdict-pros-a');
      const ulB = document.getElementById('verdict-pros-b');
      ulA.innerHTML = prosA.length ? prosA.map(p => '<li>' + p + '</li>').join('') : '<li style="color:#475569;font-style:italic">Tidak unggul di kategori ini</li>';
      ulB.innerHTML = prosB.length ? prosB.map(p => '<li>' + p + '</li>').join('') : '<li style="color:#475569;font-style:italic">Tidak unggul di kategori ini</li>';

      const banner = document.getElementById('winner-banner');
      if (winsA > winsB) banner.textContent = '🏆 ' + a.nama + ' unggul di lebih banyak kategori (' + winsA + ' vs ' + winsB + ')';
      else if (winsB > winsA) banner.textContent = '🏆 ' + b.nama + ' unggul di lebih banyak kategori (' + winsB + ' vs ' + winsA + ')';
      else banner.textContent = '🤝 Kedua laptop seimbang (' + winsA + ' vs ' + winsB + ')';
    }

    document.getElementById('sel-a').addEventListener('change', render);
    document.getElementById('sel-b').addEventListener('change', render);
    render();
  </script>
</BaseLayout>