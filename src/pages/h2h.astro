    const placeholder = document.getElementById('placeholder');
    const compareWrap = document.getElementById('compare-wrap');

    // Custom searchable dropdown
    let selectedA = '', selectedB = '';

    function buildDropdown(inputId, dropdownId, onSelect) {
      const input = document.getElementById(inputId);
      const dropdown = document.getElementById(dropdownId);

      // Populate options
      laptops.forEach(l => {
        const div = document.createElement('div');
        div.className = 'cs-option';
        div.dataset.value = l.id;
        div.textContent = `${l.nama} (${l.harga})`;
        div.addEventListener('mousedown', (e) => {
          e.preventDefault();
          onSelect(l.id, `${l.nama} (${l.harga})`);
          dropdown.classList.remove('open');
        });
        dropdown.appendChild(div);
      });

      input.addEventListener('focus', () => {
        dropdown.classList.add('open');
        filterOptions(input, dropdown);
      });

      input.addEventListener('blur', () => {
        setTimeout(() => dropdown.classList.remove('open'), 150);
      });

      input.addEventListener('input', () => filterOptions(input, dropdown));
    }

    function filterOptions(input, dropdown) {
      const q = input.value.toLowerCase().trim();
      dropdown.querySelectorAll('.cs-option').forEach(opt => {
        const laptop = laptops.find(l => l.id === opt.dataset.value);
        const inFilters = !laptop || matchesFilters(laptop);
        const matchSearch = !q || opt.textContent.toLowerCase().includes(q);
        opt.style.display = (inFilters && matchSearch) ? '' : 'none';
      });
    }

    function setSelected(dropdownId, value) {
      const dropdown = document.getElementById(dropdownId);
      dropdown.querySelectorAll('.cs-option').forEach(opt => {
        opt.classList.toggle('selected', opt.dataset.value === value);
      });
    }

    buildDropdown('sel-a-input', 'sel-a-dropdown', (id, label) => {
      selectedA = id;
      document.getElementById('sel-a-input').value = label;
      setSelected('sel-a-dropdown', id);
      render();
    });

    buildDropdown('sel-b-input', 'sel-b-dropdown', (id, label) => {
      selectedB = id;
      document.getElementById('sel-b-input').value = label;
      setSelected('sel-b-dropdown', id);
      render();
    });

    // Filters
    let budgetMin = 0, budgetMax = 999;
    let gpuFilter = 'all';

    function matchesFilters(laptop) {
      if (!laptop) return true;
      const inBudget = laptop.hargaNum >= budgetMin && laptop.hargaNum <= budgetMax;
      let inGpu = true;
      if (gpuFilter === 'integrated') inGpu = laptop.gpu === 'Integrated';
      else if (gpuFilter === 'dedicated') inGpu = laptop.gpu !== 'Integrated';
      else if (gpuFilter !== 'all') inGpu = laptop.gpu === gpuFilter;
      return inBudget && inGpu;
    }

    function applyFilters() {
      ['sel-a-dropdown', 'sel-b-dropdown'].forEach(dropId => {
        const drop = document.getElementById(dropId);
        drop.querySelectorAll('.cs-option').forEach(opt => {
          const laptop = laptops.find(l => l.id === opt.dataset.value);
          opt.style.display = matchesFilters(laptop) ? '' : 'none';
        });
      });
    }

    document.querySelectorAll('.budget-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.budget-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        budgetMin = parseFloat(btn.dataset.min);
        budgetMax = parseFloat(btn.dataset.max);
        const a = laptops.find(l => l.id === selectedA);
        const b = laptops.find(l => l.id === selectedB);
        if (a && !matchesFilters(a)) { selectedA = ''; document.getElementById('sel-a-input').value = ''; }
        if (b && !matchesFilters(b)) { selectedB = ''; document.getElementById('sel-b-input').value = ''; }
        applyFilters();
        render();
      });
    });

    document.querySelectorAll('.gpu-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.gpu-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        gpuFilter = btn.dataset.gpu;
        const a = laptops.find(l => l.id === selectedA);
        const b = laptops.find(l => l.id === selectedB);
        if (a && !matchesFilters(a)) { selectedA = ''; document.getElementById('sel-a-input').value = ''; }
        if (b && !matchesFilters(b)) { selectedB = ''; document.getElementById('sel-b-input').value = ''; }
        applyFilters();
        render();
      });
    });

    function cpuBadge(cpu, merk) {
      const cls = merk === 'Intel' ? 'badge-cpu-intel' : 'badge-cpu-amd';
      return `<span class="${cls}">${merk}</span> ${cpu}`;
    }

    function gpuBadge(gpu) {
      if (gpu === 'Integrated') return '<span style="color:#6b7280">Integrated</span>';
      return `<span class="badge-gpu">${gpu}</span>`;
    }

    function srgbBadge(v) {
      return v ? '<span class="check">✅ Ada</span>' : '<span class="dash">—</span>';
    }

    function render() {
      const a = laptops.find(l => l.id === selectedA);
      const b = laptops.find(l => l.id === selectedB);

      if (!a || !b || a.id === b.id) {
        placeholder.style.display = '';
        compareWrap.classList.remove('show');
        if (a && b && a.id === b.id) placeholder.textContent = 'Pilih dua laptop yang berbeda.';
        else placeholder.textContent = 'Pilih dua laptop di atas untuk melihat perbandingan spesifikasi lengkap.';
        return;
      }

      placeholder.style.display = 'none';
      compareWrap.classList.add('show');

      document.getElementById('name-a').textContent = a.nama;
      document.getElementById('price-a').textContent = a.harga;
      document.getElementById('name-b').textContent = b.nama;
      document.getElementById('price-b').textContent = b.harga;

      // Rows: [label, valA, valB, compareType]
      // compareType: 'higher' (lebih besar = menang), 'lower' (lebih kecil = menang), 'equal' (tidak ada pemenang)
      const rows = [
        ['Kategori', a.kategori, b.kategori, 'equal'],
        ['Merk', a.merk, b.merk, 'equal'],
        ['Harga', a.harga, b.harga, 'lower', a.hargaNum, b.hargaNum],
        ['CPU', cpuBadge(a.cpu, a.cpuMerk), cpuBadge(b.cpu, b.cpuMerk), 'equal'],
        ['GPU', gpuBadge(a.gpu), gpuBadge(b.gpu), 'higher', a.gpuNum, b.gpuNum],
        ['RAM', a.ram, b.ram, 'equal'],
        ['Kapasitas RAM', `${a.ramSize} GB`, `${b.ramSize} GB`, 'higher', a.ramSize, b.ramSize],
        ['Layar', a.layar, b.layar, 'equal'],
        ['Refresh Rate', `${a.layarHz} Hz`, `${b.layarHz} Hz`, 'higher', a.layarHz, b.layarHz],
        ['100% sRGB', srgbBadge(a.srgb), srgbBadge(b.srgb), 'higher', a.srgb ? 1 : 0, b.srgb ? 1 : 0],
        ['Baterai', a.baterai, b.baterai, 'equal'],
        ['Berat', a.berat, b.berat, 'equal'],
        ['Garansi', a.garansi, b.garansi, 'equal'],
        ['OS', a.os, b.os, 'equal'],
        ['TDP (CPU)', a.tdp || '—', b.tdp || '—', 'equal'],
        ['TGP (GPU)', a.tgp || '—', b.tgp || '—', 'equal'],
        // Benchmark rows
        ['NanoReview Score', benchVal(getBench(a.cpu), 'nano'), benchVal(getBench(b.cpu), 'nano'), 'higher',
          getBench(a.cpu) ? getBench(a.cpu).nano : null, getBench(b.cpu) ? getBench(b.cpu).nano : null],
        ['Power Efficiency', benchVal(getBench(a.cpu), 'eff'), benchVal(getBench(b.cpu), 'eff'), 'higher',
          getBench(a.cpu) ? getBench(a.cpu).eff : null, getBench(b.cpu) ? getBench(b.cpu).eff : null],
        ['Passmark Single-Thread', benchVal(getBench(a.cpu), 'pmS'), benchVal(getBench(b.cpu), 'pmS'), 'higher',
          getBench(a.cpu) ? getBench(a.cpu).pmS : null, getBench(b.cpu) ? getBench(b.cpu).pmS : null],
        ['Passmark Multi-Thread', benchVal(getBench(a.cpu), 'pmM'), benchVal(getBench(b.cpu), 'pmM'), 'higher',
          getBench(a.cpu) ? getBench(a.cpu).pmM : null, getBench(b.cpu) ? getBench(b.cpu).pmM : null],
      ];

      let winsA = 0, winsB = 0;
      const prosA = [], prosB = [];

      const tbody = document.getElementById('spec-tbody');
      tbody.innerHTML = '';

      rows.forEach(([label, vA, vB, type, numA, numB]) => {
        let clsA = 'draw', clsB = 'draw';
        if (type !== 'equal' && numA !== undefined && numA !== null && numB !== null) {
          if (numA !== numB) {
            const aWins = type === 'higher' ? numA > numB : numA < numB;
            if (aWins) { clsA = 'win-a'; winsA++; prosA.push(label); }
            else { clsB = 'win-b'; winsB++; prosB.push(label); }
          }
        }
        tbody.innerHTML += `<tr>
          <td>${label}</td>
          <td class="${clsA}">${vA}</td>
          <td class="${clsB}">${vB}</td>
        </tr>`;
      });

      // Verdict
      document.getElementById('verdict-name-a').textContent = a.nama;
      document.getElementById('verdict-name-b').textContent = b.nama;

      const ulA = document.getElementById('verdict-pros-a');
      const ulB = document.getElementById('verdict-pros-b');
      ulA.innerHTML = prosA.length ? prosA.map(p => `<li>${p}</li>`).join('') : '<li style="color:#9ca3af;list-style:none">Tidak unggul di kategori ini</li>';
      ulB.innerHTML = prosB.length ? prosB.map(p => `<li>${p}</li>`).join('') : '<li style="color:#9ca3af;list-style:none">Tidak unggul di kategori ini</li>';

      const banner = document.getElementById('winner-banner');
      if (winsA > winsB) banner.textContent = `🏆 ${a.nama} unggul di lebih banyak kategori (${winsA} vs ${winsB})`;
      else if (winsB > winsA) banner.textContent = `🏆 ${b.nama} unggul di lebih banyak kategori (${winsB} vs ${winsA})`;
      else banner.textContent = `🤝 Kedua laptop seimbang (${winsA} vs ${winsB})`;
    }

  </script>
</BaseLayout>
