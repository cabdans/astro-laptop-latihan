<ReviewLayout
  title="Acer Swift Go 14 SFG14 Ultra 5 125H"
  harga="Rp 10.000.000 – 11.000.000"
  rating={4.2}
  kategori="Ultrabook"
  tanggal="22 Juli 2026"
  ringkasan="Acer Swift Go 14 SFG14 varian Ultra 5 125H membawa panel 14 inch 2.8K WQXGA+ 100% sRGB, charger 100 W Type-C, OHS bawaan, dan garansi 2 tahun dengan 3 tahun service plus 1 tahun ADP di rentang Rp10 juta - Rp11 juta. Namun tradeoffnya adalah panelnya IPS, bukan OLED seperti varian lain."
>

  <h2>Spesifikasi</h2>
  <table class="spek-table">
    <tr><td>CPU</td><td>Intel Core Ultra 5 125H</td></tr>
    <tr><td>GPU</td><td>Integrated / iGPU (tidak tercantum di sumber)</td></tr>
    <tr><td>Layar</td><td>14" 2.8K WQXGA+ (2880x1800)</td></tr>
    <tr><td>Panel</td><td>IPS / LCD</td></tr>
    <tr><td>Warna</td><td>100% sRGB</td></tr>
    <tr><td>RAM</td><td>LPDDR5 (soldered)</td></tr>
    <tr><td>Opsi Upgrade</td><td>SSD</td></tr>
    <tr><td>Baterai / Charger</td><td>65Wh / 100W Type-C</td></tr>
    <tr><td>Cooling</td><td>2× Fan, 2× Heatpipe</td></tr>
    <tr><td>Bobot</td><td>No Data</td></tr>
    <tr><td>Garansi</td><td>2Y / 3Y Svc + 1Y ADP</td></tr>
    <tr><td>OHS (Office)</td><td>Ada ✓</td></tr>
    <tr><td>Backlit</td><td>Ada ✓</td></tr>
    <tr><td>Numpad</td><td>Tidak</td></tr>
    <tr><td>Layar Sentuh</td><td>Tidak</td></tr>
    <tr><td>OS</td><td>Windows 11</td></tr>
    <tr><td>Merk</td><td>Acer</td></tr>
