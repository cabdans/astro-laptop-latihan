      </div>
      <div style="background:#e5e7eb;border-radius:4px;height:6px;"><div style="background:#1e3a8a;height:6px;border-radius:4px;width:74%;"></div></div>
    </div>
    <div>
      <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
        <span style="font-size:0.88rem;color:#374151;">Multi-Core Performance</span>
        <span style="font-weight:700;background:#e5e7eb;color:#374151;padding:2px 10px;border-radius:4px;font-size:0.85rem;border:1px solid #d1d5db;">27</span>
      </div>
      <div style="background:#e5e7eb;border-radius:4px;height:6px;"><div style="background:#1e3a8a;height:6px;border-radius:4px;width:27%;"></div></div>
    </div>
    <div>
      <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
        <span style="font-size:0.88rem;color:#374151;">Power Efficiency</span>
        <span style="font-weight:700;background:#e5e7eb;color:#374151;padding:2px 10px;border-radius:4px;font-size:0.85rem;border:1px solid #d1d5db;">77</span>
