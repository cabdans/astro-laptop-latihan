    <tr><td>Baterai / Charger</td><td>52 Wh</td></tr>
    <tr><td>Cooling</td><td>Fanless</td></tr>
    <tr><td>Bobot</td><td>No Data</td></tr>
    <tr><td>Garansi</td><td>1 Tahun</td></tr>
