    <tr><td>CPU</td><td>Intel Core Ultra 9 275HX</td></tr>
    <tr><td>GPU</td><td>NVIDIA RTX 5080 16 GB - TGP 175 W</td></tr>
    <tr><td>Layar</td><td>16" WQXGA (2560x1600) 240 Hz, 100% sRGB</td></tr>
    <tr><td>RAM</td><td>32 GB DDR5 (upgradeable)</td></tr>
    <tr><td>Upgrade</td><td>RAM & SSD (slot tersedia)</td></tr>
    <tr><td>Baterai / Charger</td><td>90 Wh / 330 W</td></tr>
    <tr><td>Cooling</td><td>2x Fan, 6x Heatpipe</td></tr>
    <tr><td>Bobot</td><td>±2.7 kg</td></tr>
    <tr><td>Garansi</td><td>3 Tahun + 1 Tahun ADP</td></tr>
    <tr><td>OS</td><td>Windows 11</td></tr>
    <tr><td>Merk</td><td>MSI</td></tr>
