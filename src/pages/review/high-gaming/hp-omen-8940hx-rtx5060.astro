    <tr><td>CPU</td><td>AMD Ryzen 9 8940HX</td></tr>
    <tr><td>GPU</td><td>NVIDIA RTX 5060 8 GB - TGP 115 W</td></tr>
    <tr><td>Layar</td><td>16" 2K (2560x1440) 165 Hz, 100% sRGB</td></tr>
    <tr><td>RAM</td><td>24 GB DDR5 SO-DIMM (upgradeable)</td></tr>
    <tr><td>Upgrade</td><td>RAM & SSD (slot tersedia)</td></tr>
    <tr><td>Baterai / Charger</td><td>70 Wh / 230 W</td></tr>
