    <tr><td>Layar</td><td>15" WQXGA (2560x1600) 165 Hz OLED</td></tr>
    <tr><td>RAM</td><td>DDR5 SO-DIMM (upgradeable)</td></tr>
    <tr><td>Upgrade</td><td>RAM & SSD (slot tersedia)</td></tr>
    <tr><td>Baterai / Charger</td><td>80 Wh / 245 W</td></tr>
    <tr><td>Cooling</td><td>No Data</td></tr>
    <tr><td>Bobot</td><td>±1.9 kg</td></tr>
