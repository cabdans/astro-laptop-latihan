---
import ReviewLayout from '../../../layouts/ReviewLayout.astro';
---

<ReviewLayout
  title="MSI Crosshair A16 HX Ryzen 9 7945HX RTX 5070"
  harga="Rp 24.000.000 - 25.000.000"
  rating={4.4}
  kategori="High Gaming"
  tanggal="22 Juli 2026"
  ringkasan="MSI Crosshair A16 HX varian RTX 5070 memakai Ryzen 9 7945HX dengan GPU di TGP 115 W, panel 16 inch WQXGA 240 Hz, dan baterai 90 Wh di rentang Rp24 juta - Rp25 juta. Tier GPU-nya naik dari varian RTX 5060, namun tradeoffnya adalah VRAM yang tetap 8 GB."
>

  <h2>Spesifikasi</h2>
  <table class="spek-table">
    <tr><td>CPU</td><td>AMD Ryzen 9 7945HX</td></tr>
    <tr><td>GPU</td><td>NVIDIA RTX 5070 8 GB - TGP 115 W</td></tr>
    <tr><td>Layar</td><td>16" WQXGA (2560x1600) 240 Hz</td></tr>
    <tr><td>RAM</td><td>DDR5 SO-DIMM (upgradeable)</td></tr>
    <tr><td>Upgrade</td><td>RAM & SSD (slot tersedia)</td></tr>
    <tr><td>Baterai / Charger</td><td>90 Wh / 240 W</td></tr>
    <tr><td>Cooling</td><td>No Data</td></tr>
    <tr><td>Bobot</td><td>±2.5 kg</td></tr>
    <tr><td>Garansi</td><td>2 Tahun + 1 Tahun ADP</td></tr>
    <tr><td>OS</td><td>Windows 11</td></tr>
    <tr><td>Merk</td><td>MSI</td></tr>
    <tr><td>Harga</td><td>Rp 24.000.000 - 25.000.000</td></tr>
  </table>


  <h2>Benchmark CPU: AMD Ryzen 9 7945HX</h2>
