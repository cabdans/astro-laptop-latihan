  <script>
    const rows = document.querySelectorAll('#table-body tr:not(#no-result)');
    const noResult = document.getElementById('no-result');
    const resultCount = document.getElementById('result-count');

    const fHarga    = document.getElementById('f-harga');
    const fGpu      = document.getElementById('f-gpu');
    const fCpu      = document.getElementById('f-cpu');
    const fRam      = document.getElementById('f-ram');
    const fSrgb     = document.getElementById('f-srgb');
    const fKategori = document.getElementById('f-kategori');
    const fSearch   = document.getElementById('search-input');

    function applyFilters() {
      const harga    = fHarga.value;
      const gpu      = fGpu.value;
      const cpu      = fCpu.value;
      const ram      = fRam.value;
      const srgb     = fSrgb.value;
      const kategori = fKategori.value;
      const search   = fSearch.value.toLowerCase().trim();

      let visible = 0;

      rows.forEach(row => {
        const rHarga    = parseFloat(row.dataset.harga);
        const rGpu      = row.dataset.gpu;
        const rCpu      = row.dataset.cpu;
        const rRam      = row.dataset.ram;
        const rSrgb     = row.dataset.srgb;
        const rKategori = row.dataset.kategori;
        const rText     = row.textContent.toLowerCase();

        let show = true;

        if (harga) {
          const [min, max] = harga.split('-').map(Number);
          if (rHarga < min || rHarga > max) show = false;
        }
        if (gpu      && rGpu      !== gpu)      show = false;
        if (cpu      && rCpu      !== cpu)      show = false;
        if (ram      && rRam      !== ram)      show = false;
        if (srgb     && rSrgb     !== srgb)     show = false;
        if (kategori && rKategori !== kategori) show = false;
        if (search   && !rText.includes(search)) show = false;

        row.classList.toggle('hidden', !show);
        if (show) visible++;
      });

      resultCount.textContent = visible;
      noResult.classList.toggle('show', visible === 0);
    }

    [fHarga, fGpu, fCpu, fRam, fSrgb, fKategori].forEach(f => f.addEventListener('change', applyFilters));
    fSearch.addEventListener('input', applyFilters);

    document.getElementById('btn-reset').addEventListener('click', () => {
      [fHarga, fGpu, fCpu, fRam, fSrgb, fKategori].forEach(f => f.value = '');
      fSearch.value = '';
      applyFilters();
    });

