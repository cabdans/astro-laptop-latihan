  <script>
    const rows = document.querySelectorAll('#table-body tr:not(#no-result)');
    const noResult = document.getElementById('no-result');
    const resultCount = document.getElementById('result-count');

    const fHarga    = document.getElementById('f-harga');
    const fGpu      = document.getElementById('f-gpu');
    const fCpu      = document.getElementById('f-cpu');
    const fRam      = document.getElementById('f-ram');
    const fSrgb     = document.getElementById('f-srgb');
    const fKategori = document.getElementById('f-kategori');
    const fSearch   = document.getElementById('search-input');

    function applyFilters() {
      const harga    = fHarga.value;
      const gpu      = fGpu.value;
      const cpu      = fCpu.value;
      const ram      = fRam.value;
      const srgb     = fSrgb.value;
      const kategori = fKategori.value;
      const search   = fSearch.value.toLowerCase().trim();

      let visible = 0;

      rows.forEach(row => {
        const rHarga    = row.dataset.harga ? parseFloat(row.dataset.harga) : 0;
        const rGpu      = row.dataset.gpu   || '';
        const rCpu      = row.dataset.cpu   || '';
        const rRam      = row.dataset.ram   || '';
        const rSrgb     = row.dataset.srgb  || '';
        const rKategori = row.dataset.kategori || '';
        const rText     = row.textContent.toLowerCase();

        let show = true;

        if (harga === 'bawah10')   { if (rHarga >= 10) show = false; }
        else if (harga === '10-13') { if (rHarga < 10 || rHarga > 13) show = false; }
        else if (harga === '13-17') { if (rHarga < 13 || rHarga > 17) show = false; }
        else if (harga === 'atas17') { if (rHarga <= 17) show = false; }

        if (gpu      && rGpu      !== gpu)      show = false;
        if (cpu      && rCpu      !== cpu)      show = false;
        if (ram      && rRam      !== ram)      show = false;
        if (srgb     && rSrgb     !== srgb)     show = false;
        if (kategori && rKategori !== kategori) show = false;
        if (search   && !rText.includes(search)) show = false;

        row.classList.toggle('hidden', !show);
        if (show) visible++;
      });

      resultCount.textContent = visible;
      noResult.classList.toggle('show', visible === 0);
    }

    [fHarga, fGpu, fCpu, fRam, fSrgb, fKategori].forEach(f =>
      f.addEventListener('change', applyFilters)
    );
    fSearch.addEventListener('input', applyFilters);

    document.getElementById('btn-reset').addEventListener('click', () => {
      [fHarga, fGpu, fCpu, fRam, fSrgb, fKategori].forEach(f => f.value = '');
      fSearch.value = '';
      applyFilters();
    });

    // Sort
    let sortCol = '', sortDir = 1;
    document.querySelectorAll('th[data-col]').forEach(th => {
      th.addEventListener('click', () => {
        const col = th.dataset.col;
        if (sortCol === col) {
          sortDir *= -1;
        } else {
          sortCol = col;
          sortDir = 1;
        }

        document.querySelectorAll('th').forEach(t => t.classList.remove('sort-asc','sort-desc'));
        th.classList.add(sortDir === 1 ? 'sort-asc' : 'sort-desc');

        const tbody = document.getElementById('table-body');
        const rowsArr = Array.from(rows);

        const colMap = { nama: 1, merk: 2, cpu: 3, gpu: 4, ram: 5, layar: 6, srgb: 7, score: 8, harga: 9 };
        const colIdx = colMap[col] || 1;

        rowsArr.sort((a, b) => {
          if (col === 'harga') {
            return (parseFloat(a.dataset.harga) - parseFloat(b.dataset.harga)) * sortDir;
          }
          if (col === 'score') {
            const getScore = row => {
              const badge = row.querySelector('.score-badge');
              return badge ? parseInt(badge.textContent.trim()) : null;
            };
            const sA = getScore(a), sB = getScore(b);
            // No Data always goes to bottom
            if (sA === null && sB === null) return 0;
            if (sA === null) return 1;
            if (sB === null) return -1;
            return (sA - sB) * sortDir;
          }
          const aVal = a.querySelector(`td:nth-child(${colIdx})`)?.textContent?.trim() || '';
          const bVal = b.querySelector(`td:nth-child(${colIdx})`)?.textContent?.trim() || '';
          return aVal.localeCompare(bVal) * sortDir;
        });

        rowsArr.forEach(row => tbody.insertBefore(row, noResult));
        applyFilters();
      });
    });
  </script>

