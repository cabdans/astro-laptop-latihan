const totalLink = deals.filter(d => d.link).length;
---

<BaseLayout title="Hot Deals" description="Rekomendasi laptop terbaik bulan Agustus 2026 dengan link pembelian langsung.">
  <style>
    .page-header {
      margin-bottom: 28px;
      background:
        linear-gradient(135deg, rgba(20,4,4,0.92) 0%, rgba(30,8,6,0.82) 40%, rgba(12,3,3,0.90) 100%),
        url('/planet-mars.jpg') center/cover no-repeat;
      border: 1px solid rgba(248,113,113,0.28);
      border-radius: 16px; padding: 48px 40px; position: relative; overflow: hidden;
      box-shadow: 0 0 60px rgba(248,113,113,0.12);
    }
    .page-header::before {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background:
        radial-gradient(ellipse at 50% 50%, rgba(248,113,113,0.18) 0%, transparent 55%),
        radial-gradient(ellipse at 20% 30%, rgba(251,146,60,0.12) 0%, transparent 45%);
    }
    .page-header h1 {
      font-size: 2rem; font-weight: 800; color: #e2e8f0; margin-bottom: 6px;
      position: relative; z-index: 1; text-shadow: 0 0 32px rgba(248,113,113,0.55);
    }
    .page-header p { color: rgba(255,255,255,0.72); position: relative; z-index: 1; }

    .meta-bar {
      display: flex; flex-wrap: wrap; gap: 10px 18px; align-items: center;
      font-size: 0.85rem; color: #64748b; margin-bottom: 20px;
    }
    .meta-bar strong { color: #e2e8f0; }
    .badge-periode {
      background: rgba(248,113,113,0.12); color: #f87171;
      border: 1px solid rgba(248,113,113,0.3);
      padding: 3px 12px; border-radius: 20px; font-weight: 700; font-size: 0.78rem;
    }

    .deals-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
      gap: 18px; margin-bottom: 32px;
    }
    .deal-card {
      background: rgba(10,10,42,0.85);
      border: 1px solid rgba(96,165,250,0.15);
      border-top: 3px solid var(--accent, #f87171);
      border-radius: 14px; overflow: hidden;
      display: flex; flex-direction: column;
      transition: border-color 0.25s, transform 0.25s;
    }
    .deal-card:hover { border-color: rgba(248,113,113,0.55); transform: translateY(-3px); }

    .deal-body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
    .deal-nama { font-size: 1rem; font-weight: 700; color: #e2e8f0; line-height: 1.35; }
    .deal-nama a { color: inherit; text-decoration: none; }
    .deal-nama a:hover { color: #60a5fa; }

    .deal-harga { font-size: 1.35rem; font-weight: 800; color: #34d399; letter-spacing: -0.01em; }

    .deal-kat {
      display: inline-block; font-size: 0.7rem; font-weight: 700;
      padding: 3px 10px; border-radius: 20px; width: fit-content;
      background: rgba(248,113,113,0.12); color: #f87171;
      border: 1px solid rgba(248,113,113,0.25);
    }

    .deal-spek { display: grid; gap: 5px; font-size: 0.82rem; color: #94a3b8; }
    .deal-spek div { display: flex; gap: 8px; }
    .deal-spek span:first-child { color: #64748b; min-width: 62px; flex-shrink: 0; }
    .deal-spek span:last-child { color: #cbd5e1; }

    .deal-catatan {
      font-size: 0.8rem; color: #94a3b8; line-height: 1.5;
      border-left: 2px solid rgba(96,165,250,0.3); padding-left: 10px;
    }

    .deal-actions { display: flex; gap: 8px; margin-top: auto; padding-top: 4px; }
    .btn-beli-deal {
      flex: 1; text-align: center; text-decoration: none;
      background: linear-gradient(135deg, #16a34a, #22c55e); color: white;
      padding: 10px 14px; border-radius: 8px; font-weight: 700; font-size: 0.85rem;
      transition: opacity 0.2s;
    }
    .btn-beli-deal:hover { opacity: 0.85; }
    .btn-beli-deal.soon {
      background: rgba(255,255,255,0.07); color: #94a3b8;
      border: 1px solid rgba(255,255,255,0.12);
    }
    .btn-review {
      text-align: center; text-decoration: none; white-space: nowrap;
      background: rgba(96,165,250,0.1); color: #60a5fa;
      border: 1px solid rgba(96,165,250,0.3);
      padding: 10px 14px; border-radius: 8px; font-weight: 700; font-size: 0.85rem;
      transition: background 0.2s;
    }
    .btn-review:hover { background: rgba(96,165,250,0.2); }

    .disclaimer-box {
      background: rgba(251,191,36,0.06); border: 1px solid rgba(251,191,36,0.22);
      border-radius: 12px; padding: 16px 20px; font-size: 0.85rem;
      color: #94a3b8; line-height: 1.6;
    }
    .disclaimer-box strong { color: #fbbf24; }

    /* ── Light mode ── */
    html[data-theme="light"] .deal-card {
      background: rgba(255,255,255,0.92);
      border-color: rgba(0,0,0,0.1);
      box-shadow: 0 2px 12px rgba(0,0,0,0.07);
    }
    html[data-theme="light"] .deal-nama { color: #1e293b; }
    html[data-theme="light"] .deal-harga { color: #059669; }
    html[data-theme="light"] .deal-spek { color: #475569; }
    html[data-theme="light"] .deal-spek span:last-child { color: #334155; }
    html[data-theme="light"] .deal-catatan { color: #475569; }
    html[data-theme="light"] .meta-bar strong { color: #1e293b; }
    html[data-theme="light"] .disclaimer-box { color: #475569; }

    @media (max-width: 640px) {
      .page-header { padding: 32px 22px; }
      .page-header h1 { font-size: 1.5rem; }
      .deals-grid { grid-template-columns: 1fr; }
    }
  </style>

  <div class="page-header">
    <h1>🔥 Hot Deals Agustus 2026</h1>
    <p>Rekomendasi laptop pilihan bulan ini, langsung terhubung ke halaman pembelian.</p>
  </div>

  <div class="meta-bar">
    <span class="badge-periode">Periode Agustus 2026</span>
    <span><strong>{deals.length}</strong> laptop rekomendasi</span>
    <span><strong>{totalLink}</strong> siap dibeli</span>
    <span>Harga Rp {Math.min(...deals.map(d => d.hargaNum))} – {Math.max(...deals.map(d => d.hargaNum))} juta</span>
  </div>

  <div class="deals-grid">
    {deals.map(d => (
      <article class="deal-card">
        <div class="deal-body">
          <span class="deal-kat">{d.kategori}</span>
          <h2 class="deal-nama"><a href={d.slug}>{d.nama}</a></h2>
          <div class="deal-harga">{d.harga}</div>

          <div class="deal-spek">
            <div><span>CPU</span><span>{d.cpu}</span></div>
            <div><span>GPU</span><span>{d.gpu}</span></div>
            <div><span>RAM</span><span>{d.ram}</span></div>
            <div><span>Storage</span><span>{d.storage}</span></div>
            <div><span>Layar</span><span>{d.layar}</span></div>
            <div><span>Garansi</span><span>{d.garansi}</span></div>
          </div>

          <p class="deal-catatan">{d.catatan}</p>

          <div class="deal-actions">
            {d.link
              ? <a class="btn-beli-deal" href={d.link} target="_blank" rel="nofollow sponsored noopener">🛒 Beli Sekarang</a>
              : <a class="btn-beli-deal soon" href={d.slug}>Lihat Detail Dulu</a>}
            <a class="btn-review" href={d.slug}>Review →</a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="disclaimer-box">
    <strong>Catatan.</strong> Harga di halaman ini adalah harga promo Agustus 2026 dan bisa berbeda
    dengan rentang harga di halaman review, karena review memakai kisaran harga pasar sepanjang tahun.
    Harga juga berubah tergantung toko, waktu, dan promo yang sedang berjalan.
    Tautan pembelian merupakan tautan afiliasi, jadi AstroLaptop bisa memperoleh komisi
    tanpa menambah harga yang Anda bayar.
  </div>
</BaseLayout>
