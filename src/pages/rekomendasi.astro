<BaseLayout title="Temukan Laptop" description="Filter wizard 5 langkah untuk menemukan laptop paling sesuai budget dan kebutuhanmu">
<style>
  .rekomen-hero {
    text-align: center;
    padding: 48px 20px 32px;
  }
  .rekomen-hero h1 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 800;
    background: linear-gradient(135deg, #e2e8f0, #93c5fd, #c4b5fd);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0 0 10px;
  }
  .rekomen-hero p {
    color: var(--text-muted);
    font-size: 1rem;
    margin: 0;
  }

  /* Filter wizard */
  .filter-wizard {
    max-width: 780px;
    margin: 0 auto 48px;
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .filter-bar {
    background: rgba(10,10,42,0.85);
    border: 1px solid rgba(96,165,250,0.15);
    border-radius: 14px;
    padding: 20px 22px;
    transition: border-color 0.3s;
  }
  .filter-bar.has-selection {
    border-color: rgba(96,165,250,0.4);
  }
  .filter-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 14px;
  }
  .filter-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: rgba(96,165,250,0.15);
    border: 1px solid rgba(96,165,250,0.3);
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary);
    flex-shrink: 0;
  }
  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.04);
    color: var(--text-muted);
    font-size: 0.84rem;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .chip:hover {
    border-color: rgba(96,165,250,0.4);
    color: var(--text);
    background: rgba(96,165,250,0.08);
  }
  .chip.active {
    background: var(--primary);
    border-color: var(--primary);
    color: #02020e;
    font-weight: 700;
    box-shadow: 0 0 16px rgba(96,165,250,0.4);
  }
  .reset-btn {
    padding: 9px 24px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.15);
    background: transparent;
    color: var(--text-muted);
    font-size: 0.84rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .reset-btn:hover {
    color: var(--text);
    border-color: rgba(255,255,255,0.3);
  }

  /* Results */
  .results-section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 16px 64px;
  }
  .results-header {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 20px;
    padding-left: 4px;
  }
  .results-header strong {
    color: var(--primary);
    font-weight: 700;
  }
  .fallback-note {
    display: inline-block;
    margin-bottom: 16px;
    padding: 8px 16px;
    background: rgba(251,191,36,0.08);
    border: 1px solid rgba(251,191,36,0.25);
    border-radius: 8px;
    color: #fbbf24;
    font-size: 0.84rem;
  }
  .results-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (max-width: 900px) {
    .results-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .filter-bar { padding: 16px; }
    .chip { font-size: 0.8rem; padding: 7px 13px; }
    .results-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
  }
  @media (max-width: 400px) {
    .results-grid { grid-template-columns: 1fr; }
  }

  /* ── LIGHT MODE OVERRIDES ────────────────────────────────── */
  :global(html[data-theme="light"]) .filter-bar {
    background: rgba(255,255,255,0.88);
    border-color: rgba(37,99,235,0.15);
    box-shadow: 0 2px 14px rgba(0,0,0,0.07);
  }
  :global(html[data-theme="light"]) .filter-bar.has-selection {
    border-color: rgba(37,99,235,0.4);
  }
  :global(html[data-theme="light"]) .chip {
    border-color: rgba(0,0,0,0.14);
    background: rgba(0,0,0,0.04);
    color: #475569;
  }
  :global(html[data-theme="light"]) .chip:hover {
    border-color: rgba(37,99,235,0.35);
    background: rgba(37,99,235,0.07);
    color: #2563eb;
  }
  :global(html[data-theme="light"]) .chip.active {
    background: #2563eb;
    border-color: #2563eb;
    color: #fff;
  }
  :global(html[data-theme="light"]) .reset-btn {
    border-color: rgba(0,0,0,0.18);
    color: #475569;
  }
  :global(html[data-theme="light"]) .reset-btn:hover {
    border-color: rgba(37,99,235,0.4);
    color: #2563eb;
  }
  :global(html[data-theme="light"]) .rekomen-hero h1 {
    background: linear-gradient(135deg, #1e293b, #2563eb, #7c3aed);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>

