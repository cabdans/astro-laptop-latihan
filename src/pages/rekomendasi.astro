<BaseLayout title="Temukan Laptop" description="Filter wizard 5 langkah untuk menemukan laptop paling sesuai budget dan kebutuhanmu">
<style>
  .rekomen-hero {
    text-align: center;
    padding: 48px 20px 32px;
  }
  .rekomen-hero h1 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 800;
    background: linear-gradient(135deg, #e2e8f0, #93c5fd, #c4b5fd);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0 0 10px;
  }
  .rekomen-hero p {
    color: var(--text-muted);
    font-size: 1rem;
    margin: 0;
  }

  /* Filter wizard */
  .filter-wizard {
    max-width: 780px;
    margin: 0 auto 48px;
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .filter-bar {
    background: rgba(10,10,42,0.85);
    border: 1px solid rgba(96,165,250,0.15);
    border-radius: 14px;
    padding: 20px 22px;
    transition: border-color 0.3s;
  }
  .filter-bar.has-selection {
    border-color: rgba(96,165,250,0.4);
  }
  .filter-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 14px;
  }
  .filter-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: rgba(96,165,250,0.15);
    border: 1px solid rgba(96,165,250,0.3);
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary);
    flex-shrink: 0;
  }
  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.04);
    color: var(--text-muted);
    font-size: 0.84rem;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .chip:hover {
    border-color: rgba(96,165,250,0.4);
    color: var(--text);
    background: rgba(96,165,250,0.08);
  }
  .chip.active {
    background: var(--primary);
    border-color: var(--primary);
    color: #02020e;
    font-weight: 700;
    box-shadow: 0 0 16px rgba(96,165,250,0.4);
  }
  .reset-btn {
    padding: 9px 24px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.15);
    background: transparent;
    color: var(--text-muted);
    font-size: 0.84rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .reset-btn:hover {
    color: var(--text);
    border-color: rgba(255,255,255,0.3);
  }

  /* Results */
  .results-section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 16px 64px;
  }
  .results-header {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 20px;
    padding-left: 4px;
  }
  .results-header strong {
    color: var(--primary);
    font-weight: 700;
  }
  .fallback-note {
    display: inline-block;
    margin-bottom: 16px;
    padding: 8px 16px;
    background: rgba(251,191,36,0.08);
    border: 1px solid rgba(251,191,36,0.25);
    border-radius: 8px;
    color: #fbbf24;
    font-size: 0.84rem;
  }
  /* Atribut hidden menerapkan display:none lewat stylesheet bawaan browser,
     tapi aturan display:flex di bawah punya prioritas lebih tinggi dan
     membatalkannya. Selektor [hidden] di bawah mengembalikan perilaku yang
     benar — tanpa ini, filter tetap terlihat walau gate belum diisi. */
  .filter-wizard[hidden],
  .gate-halo[hidden],
  .gate-box[hidden],
  .results-section[hidden] { display: none !important; }

  /* ── Diagnosa saat hasil kosong ── */
  .diagnosa {
    margin: 14px 0 20px; padding: 16px 18px;
    background: rgba(251,191,36,0.05);
    border: 1px solid rgba(251,191,36,0.22);
    border-left: 3px solid rgba(251,191,36,0.7);
    border-radius: 10px;
  }
  .diagnosa :global(.diag-utama) {
    margin: 0 0 10px; font-size: 0.9rem; color: #e2e8f0; line-height: 1.6;
  }
  .diagnosa :global(.diag-utama strong) { color: #fbbf24; }
  .diagnosa :global(.diag-sub) {
    margin: 0 0 8px; font-size: 0.85rem; color: #94a3b8; line-height: 1.6;
  }
  .diagnosa :global(.diag-sub strong) { color: #cbd5e1; }
  .diagnosa :global(.diag-list) {
    margin: 0 0 10px; padding-left: 20px;
    font-size: 0.85rem; color: #94a3b8; line-height: 1.75;
  }
  .diagnosa :global(.diag-list strong) { color: #cbd5e1; }
  .diagnosa :global(.diag-detail) {
    margin-top: 4px; font-size: 0.82rem; color: #64748b;
    border-top: 1px solid rgba(251,191,36,0.15); padding-top: 10px;
  }
  .diagnosa :global(.diag-detail summary) {
    cursor: pointer; color: #94a3b8; user-select: none;
  }
  .diagnosa :global(.diag-detail summary:hover) { color: #fbbf24; }
  .diagnosa :global(.diag-detail ul) { margin-top: 8px; }

  :global(html[data-theme="light"]) .diagnosa {
    background: rgba(251,191,36,0.08); border-color: rgba(180,83,9,0.28);
    border-left-color: rgba(180,83,9,0.6);
  }
  :global(html[data-theme="light"]) .diagnosa :global(.diag-utama) { color: #1e293b; }
  :global(html[data-theme="light"]) .diagnosa :global(.diag-utama strong) { color: #b45309; }
  :global(html[data-theme="light"]) .diagnosa :global(.diag-sub),
  :global(html[data-theme="light"]) .diagnosa :global(.diag-list) { color: #475569; }
  :global(html[data-theme="light"]) .diagnosa :global(.diag-sub strong),
  :global(html[data-theme="light"]) .diagnosa :global(.diag-list strong) { color: #1e293b; }

  /* ── Gate nama + email ── */
  .gate-box {
    max-width: 620px; margin: 0 auto 28px; padding: 26px 28px;
    background: rgba(255,255,255,0.035);
    border: 1px solid rgba(96,165,250,0.28);
    border-radius: 16px;
  }
  .gate-head { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 20px; }
