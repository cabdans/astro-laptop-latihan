<script define:vars={{ laptops }}>
  /* ═══════════════════════════════════════════════════════════════
     KONFIGURASI PENGUMPULAN DATA — ISI 3 BARIS DI BAWAH INI

     Cara mendapatkannya:
     1. Buat Google Form baru berisi 3 pertanyaan jawaban singkat:
          - Nama
          - Email
          - Pilihan Filter
     2. Klik "Send" > tab link > salin ID formnya.
        Dari https://docs.google.com/forms/d/e/XXXXXXXX/viewform
        yang dipakai adalah bagian XXXXXXXX.
     3. Buka form versi isian, klik kanan di kotak "Nama" > Inspect,
        cari teks entry.1234567890. Ulangi untuk Email dan Pilihan Filter.

     Selama masih kosong, gate tetap berfungsi normal — pengguna bisa
     masuk seperti biasa, datanya saja yang belum terkirim ke mana pun.
     ═══════════════════════════════════════════════════════════════ */
  const FORM_ID     = '1FAIpQLScF8mn2jb8cLEIWD6P1GahA-dDIgYW-0JCULdZfCbF0OyldPg';
  const ENTRY_NAMA  = 'entry.55387959';     // kolom "Nama"
  const ENTRY_EMAIL = 'entry.1765805379';   // kolom "Email"
  const ENTRY_FILTER= 'entry.1028152146';   // kolom "Pilihan Filter"

  const KUNCI_SIMPAN = 'astrolaptop_pengguna';

  /* Kirim satu baris ke Google Form. Memakai mode no-cors karena Google
     tidak mengirim header CORS — konsekuensinya kita tidak bisa membaca
     balasannya, jadi kegagalan tidak akan terdeteksi. Itu disengaja:
     pengumpulan data tidak boleh sampai menghalangi pengguna memakai situs. */
  function kirimKeForm(nama, email, ringkasanFilter) {
    if (!FORM_ID || !ENTRY_NAMA || !ENTRY_EMAIL) return;   // belum dikonfigurasi
    try {
      const data = new FormData();
      data.append(ENTRY_NAMA, nama);
      data.append(ENTRY_EMAIL, email);
      if (ENTRY_FILTER) data.append(ENTRY_FILTER, ringkasanFilter || '(belum memilih)');
      fetch(`https://docs.google.com/forms/d/e/${FORM_ID}/formResponse`, {
        method: 'POST', mode: 'no-cors', body: data,
      }).catch(() => {});
    } catch (e) { /* diabaikan dengan sengaja */ }
  }

  // State
  const state = { budget: null, ram: null, editing: null, performa: null, brand: null };

  // Filter logic
  /* Rentang bucket harga, dalam juta rupiah. Batas bawah inklusif, batas atas
     eksklusif — [lo, hi) — supaya laptop berharga tunggal (mis. tepat Rp 20 juta)
     jatuh di tepat satu bucket, bukan dua atau nol. */
  const BUDGET_BUCKETS = {
    under10: [0,  10],
    '10to15': [10, 15],
    '15to20': [15, 20],
    '20to25': [20, 25],
    over25:  [25, Infinity],
  };

  function budgetPass(l, val) {
    if (!val) return true;
    // Laptop tanpa data harga (hMin=0) tidak boleh lolos filter budget spesifik —
    // sebelumnya "return true" membuat laptop mahal (mis. RTX 5080) muncul di semua rentang budget.
    if (l.hMin === 0) return false;
    const bucket = BUDGET_BUCKETS[val];
    if (!bucket) return true;
    const [lo, hi] = bucket;
    /* Cocokkan berdasarkan IRISAN rentang, bukan "harus muat seluruhnya".
       Versi lama memakai `hMin >= lo && hMax <= hi`, sehingga laptop yang
       harganya menyeberang batas bucket (mis. Rp 9–11 juta) tidak masuk bucket
       mana pun dan hilang total dari hasil. Dengan irisan, laptop seperti itu
       muncul di kedua bucket yang disentuhnya — yang memang benar. */
    return l.hMin < hi && l.hMax >= lo;
  }

  /* Parameter s dibuat opsional supaya fungsi ini bisa dipakai ulang untuk
     menguji state hipotetis — dipakai oleh diagnosaKosong() saat mencari
     filter mana yang membuat hasilnya nol. */
  function passesAllFilters(l, s = state) {
    if (!budgetPass(l, s.budget)) return false;
    // Bar 2: RAM upgradeable — "ya" wajib upgradeable, "tidak" tidak membatasi
    if (s.ram === 'ya' && !l.ramUp) return false;
    // Bar 3: Editing — ringan butuh 100% sRGB, berat butuh sRGB + GPU dedicated
    if (s.editing === 'light' && !l.srgb) return false;
    if (s.editing === 'heavy' && (!l.srgb || !l.gpuDed)) return false;
    // Bar 4: Prioritas performa
    if (s.performa === 'ringan' && l.gpuDed) return false;
    if (s.performa === 'gaming' && !l.gpuDed) return false;
    // 'produktivitas': tidak ada hard filter, hanya memengaruhi urutan (pmMulti tertinggi)
    if (s.brand === 'lokal' && !l.lokal) return false;
    if (s.brand === 'luar' && l.lokal) return false;
    return true;
  }

  function scoreClosest(l) {
    let s = 0;
    if (budgetPass(l, state.budget)) s += 2;
    if (!state.ram || state.ram === 'tidak' || l.ramUp) s++;
    if (!state.editing || state.editing === 'none') s++;
    else if (state.editing === 'light' && l.srgb) s++;
    else if (state.editing === 'heavy' && l.srgb && l.gpuDed) s++;
    // 'produktivitas' tidak punya hard filter, jadi selalu terpenuhi
    if (!state.performa || state.performa === 'produktivitas') s++;
    else if (state.performa === 'ringan' && !l.gpuDed) s++;
    else if (state.performa === 'gaming' && l.gpuDed) s++;
    if (!state.brand || state.brand === 'all') s++;
    else if (state.brand === 'lokal' && l.lokal) s++;
    else if (state.brand === 'luar' && !l.lokal) s++;
    return s;
  }

  // Sort hasil berdasarkan pilihan Bar 4
  /* Efficiency score untuk mode Ringan & Awet Baterai.
     Komponen (semua dari data yang sudah ada di project):
     - Tidak ada GPU dedicated (+60)  → hemat daya paling signifikan
     - GPU TGP tinggi (-0.45/Watt)    → makin boros listrik, makin rendah
     - Bobot ringan (+12 per 0.1 kg)   → chassis kecil biasanya baterai lebih awet
     - pmMulti tinggi (+1/2000)       → proxy efisiensi CPU (performa per watt)
  */
  function efficiencyScore(l) {
    let s = 0;
    if (!l.gpuDed)    s += 60;
    if (l.gpuTgp > 0) s -= l.gpuTgp * 0.45;
    if (l.bobot > 0)  s += (3.2 - l.bobot) * 12;
    if (l.pmMulti > 0) s += l.pmMulti / 2000;
    return s;
  }

  function sortByPerforma(list) {
    const p = state.performa;
    if (p === 'gaming') {
      // Gaming mode: TGP GPU tertinggi → VRAM terbesar
      return [...list].sort((a, b) =>
        b.gpuTgp !== a.gpuTgp ? b.gpuTgp - a.gpuTgp : b.gpuVram - a.gpuVram
      );
    }
    if (p === 'produktivitas') {
      // Produktivitas mode: Passmark Multi-Thread tertinggi
      return [...list].sort((a, b) => b.pmMulti - a.pmMulti);
    }
    if (p === 'ringan') {
      // Ringan mode: efficiency score tertinggi (no-dGPU bonus, TGP penalty, bobot, pmMulti)
      return [...list].sort((a, b) => efficiencyScore(b) - efficiencyScore(a));
    }
    return list;
  }

  function hasAnyFilter() {
    return state.budget || state.ram || state.editing || state.performa || state.brand;
  }

  /* ═══════════ DIAGNOSA SAAT HASIL KOSONG ═══════════
     Menjelaskan filter mana yang membuat hasilnya nol, bukan sekadar
     memberi tahu bahwa hasilnya kosong. Caranya: lepas satu filter,
     hitung ulang; kalau hasilnya jadi ada, filter itulah penyebabnya. */

  const NAMA_BAR = { budget:'Budget', ram:'RAM upgradeable', editing:'Kebutuhan editing',
                     performa:'Prioritas performa', brand:'Preferensi brand' };

  /* Label diambil langsung dari teks chip di halaman, jadi kalau suatu saat
     teksnya diubah, penjelasan ini ikut berubah tanpa perlu disunting lagi. */
  function labelChip(grup, val) {
    const el = document.querySelector(`.filter-chips[data-group="${grup}"] .chip[data-val="${val}"]`);
    return el ? el.textContent.trim() : val;
  }

  /* Alasan semantik untuk kombinasi yang memang mustahil secara logika.
     Ditulis manual karena penjelasannya butuh konteks yang tidak bisa
     disimpulkan otomatis dari data. */
  function alasanKombinasi(a, b) {
    const pasangan = [a, b].sort().join('|');
    const peta = {
      'editing:heavy|performa:ringan':
        'Editing berat mensyaratkan GPU dedicated, sementara Ringan &amp; Awet Baterai justru hanya menampilkan laptop tanpa GPU dedicated. Dua kriteria ini saling meniadakan.',
      'editing:light|performa:ringan':
        'Editing ringan mensyaratkan panel 100% sRGB, dan di antara laptop tanpa GPU dedicated jumlahnya terbatas.',
      'editing:heavy|performa:gaming':
        'Keduanya mensyaratkan GPU dedicated, jadi yang menyempitkan hasil kemungkinan besar syarat panel 100% sRGB dari editing berat.',
    };
    return peta[pasangan] || null;
  }

  function diagnosaKosong() {
    // Hanya hitung filter yang benar-benar membatasi. Nilai seperti
    // "Tidak", "Tidak ada", dan "Semua brand" tidak menyaring apa pun.
    const aktif = Object.entries(state)
      .filter(([, v]) => v && !['none', 'all', 'tidak'].includes(v));
    if (aktif.length === 0) return '';

    const jml = (s) => laptops.filter(l => passesAllFilters(l, s)).length;

    // Tahap 1: cari filter tunggal yang kalau dilepas langsung membuka hasil
    const tunggal = [];
    for (const [k, v] of aktif) {
      const n = jml({ ...state, [k]: null });
      if (n > 0) tunggal.push({ k, v, n });
    }

    const bagian = [];

    /* Kontradiksi yang sudah dikenali diperiksa lebih dulu. Kalau dua kriteria
       memang saling meniadakan, menjelaskan sebabnya lebih berguna daripada
       menyalahkan salah satunya secara sepihak. */
    let kontradiksi = null;
    for (let i = 0; i < aktif.length && !kontradiksi; i++) {
      for (let j = i + 1; j < aktif.length && !kontradiksi; j++) {
        const [k1, v1] = aktif[i], [k2, v2] = aktif[j];
        const alasan = alasanKombinasi(`${k1}:${v1}`, `${k2}:${v2}`);
        if (alasan) kontradiksi = { k1, v1, k2, v2, alasan };
      }
    }

    if (kontradiksi) {
      const { k1, v1, k2, v2, alasan } = kontradiksi;
      bagian.push(`<p class="diag-utama"><strong>${NAMA_BAR[k1]}</strong> (&ldquo;${labelChip(k1, v1)}&rdquo;) dan <strong>${NAMA_BAR[k2]}</strong> (&ldquo;${labelChip(k2, v2)}&rdquo;) saling bertentangan.</p>`);
      bagian.push(`<p class="diag-sub">${alasan}</p>`);
      const opsi = tunggal.map(x =>
        `<li>Lepas <strong>${NAMA_BAR[x.k]}</strong> (&ldquo;${labelChip(x.k, x.v)}&rdquo;) &rarr; <strong>${x.n} laptop</strong> cocok</li>`
      ).join('');
      if (opsi) bagian.push(`<p class="diag-sub">Yang bisa dicoba:</p><ul class="diag-list">${opsi}</ul>`);
    } else if (tunggal.length > 0) {
      tunggal.sort((a, b) => b.n - a.n);
      const t = tunggal[0];
      bagian.push(`<p class="diag-utama">Penyebabnya ada di <strong>${NAMA_BAR[t.k]}</strong>, yaitu pilihan &ldquo;${labelChip(t.k, t.v)}&rdquo;. Tidak ada laptop yang memenuhi kriteria itu sekaligus kriteria lain yang kamu pilih.</p>`);
      const opsi = tunggal.map(x =>
        `<li>Lepas <strong>${NAMA_BAR[x.k]}</strong> (&ldquo;${labelChip(x.k, x.v)}&rdquo;) &rarr; <strong>${x.n} laptop</strong> cocok</li>`
      ).join('');
      bagian.push(`<p class="diag-sub">Yang bisa dicoba:</p><ul class="diag-list">${opsi}</ul>`);
    } else {
      // Tahap 2: tidak ada satu pun filter yang cukup dilepas sendirian,
      // berarti ada dua kriteria yang saling bertentangan.
      let ketemu = null;
      for (let i = 0; i < aktif.length && !ketemu; i++) {
        for (let j = i + 1; j < aktif.length && !ketemu; j++) {
          const [k1, v1] = aktif[i], [k2, v2] = aktif[j];
          if (jml({ ...state, [k1]: null, [k2]: null }) > 0) ketemu = [[k1, v1], [k2, v2]];
        }
      }
      if (ketemu) {
        const [[k1, v1], [k2, v2]] = ketemu;
        const alasan = alasanKombinasi(`${k1}:${v1}`, `${k2}:${v2}`);
        bagian.push(`<p class="diag-utama">Kombinasi <strong>${NAMA_BAR[k1]}</strong> (&ldquo;${labelChip(k1, v1)}&rdquo;) dan <strong>${NAMA_BAR[k2]}</strong> (&ldquo;${labelChip(k2, v2)}&rdquo;) tidak bisa dipenuhi bersamaan.</p>`);
        if (alasan) bagian.push(`<p class="diag-sub">${alasan}</p>`);
        bagian.push(`<p class="diag-sub">Lepas salah satu dari keduanya untuk melihat hasil.</p>`);
      } else {
        bagian.push(`<p class="diag-utama">Kriteria yang kamu pilih terlalu ketat untuk 88 laptop yang ada. Coba lepas satu atau dua pilihan.</p>`);
      }
    }

    // Info tambahan: berapa laptop yang lolos tiap filter kalau berdiri sendiri
    const sendiri = aktif.map(([k, v]) => {
      const s = { budget:null, ram:null, editing:null, performa:null, brand:null, [k]: v };
      return `<li>${NAMA_BAR[k]} &ldquo;${labelChip(k, v)}&rdquo; saja &rarr; ${jml(s)} laptop</li>`;
    }).join('');
    bagian.push(`<details class="diag-detail"><summary>Rincian tiap kriteria</summary><ul class="diag-list">${sendiri}</ul></details>`);

    return `<div class="diagnosa">${bagian.join('')}</div>`;
  }

  // Warna aksen per kategori
  const katColor = {
    'Budget':       '#60a5fa',
    'Produktivitas':'#a78bfa',
    'Gaming':       '#f97316',
    'High Gaming':  '#ef4444',
    'Ultrabook':    '#06b6d4',
  };

  // Deteksi tema aktif (light/dark) untuk inline styles card yang theme-aware
  function isLightTheme() {
    return document.documentElement.getAttribute('data-theme') === 'light';
  }

  // Build card HTML — fully inline styles (Astro scoped CSS tidak berlaku pada innerHTML)
  // FIX P1: warna inline kini menyesuaikan light/dark mode (sebelumnya selalu dark).
  function buildCard(l) {
    const accent = katColor[l.kategori] || '#60a5fa';
    const light = isLightTheme();
    // Token warna per tema
    const cardBg      = light ? 'rgba(255,255,255,0.92)' : 'rgba(10,10,42,0.85)';
    const cardBorder  = light ? 'rgba(0,0,0,0.1)'        : 'rgba(96,165,250,0.15)';
    const nameColor   = light ? '#1e293b'                : '#e2e8f0';
    const specColor   = light ? '#475569'                : '#94a3b8';
    const footerLine  = light ? 'rgba(0,0,0,0.08)'       : 'rgba(255,255,255,0.06)';
    const seeColor    = light ? '#64748b'                : '#64748b';
    const cardShadow  = light ? 'box-shadow:0 2px 12px rgba(0,0,0,0.07);' : '';

    const badges = [];
    if (l.srgb)   badges.push(`<span style="display:inline-block;font-size:0.68rem;font-weight:600;padding:2px 8px;border-radius:4px;background:rgba(52,211,153,0.15);color:${light ? '#059669' : '#34d399'};border:1px solid rgba(52,211,153,0.3);">✓ 100% sRGB</span>`);
    if (l.gpuDed) badges.push(`<span style="display:inline-block;font-size:0.68rem;font-weight:600;padding:2px 8px;border-radius:4px;background:rgba(167,139,250,0.15);color:${light ? '#7c3aed' : '#a78bfa'};border:1px solid rgba(167,139,250,0.3);">GPU Dedicated</span>`);
    if (l.ramUp)  badges.push(`<span style="display:inline-block;font-size:0.68rem;font-weight:600;padding:2px 8px;border-radius:4px;background:rgba(251,191,36,0.12);color:${light ? '#b45309' : '#fbbf24'};border:1px solid rgba(251,191,36,0.25);">RAM Upgradeable</span>`);
    if (l.lokal)  badges.push(`<span style="display:inline-block;font-size:0.68rem;font-weight:600;padding:2px 8px;border-radius:4px;background:rgba(249,115,22,0.12);color:${light ? '#c2410c' : '#fb923c'};border:1px solid rgba(249,115,22,0.25);">Brand Lokal</span>`);

    const hargaColor = l.hMin === 0 ? (light ? '#d97706' : '#fbbf24') : (light ? '#2563eb' : '#60a5fa');

    return `
      <a href="/review/${l.slug}" style="
        display:flex;flex-direction:column;
        background:${cardBg};
        border:1px solid ${cardBorder};
        border-top:3px solid ${accent};
        border-radius:14px;overflow:hidden;
        text-decoration:none;${cardShadow}
        transition:border-color 0.25s,transform 0.25s;
      " onmouseover="this.style.borderColor='${accent}';this.style.transform='translateY(-3px)'"
         onmouseout="this.style.borderColor='${cardBorder}';this.style.transform='none'">
        <div style="padding:14px 16px 16px;display:flex;flex-direction:column;gap:10px;flex:1;">

          <!-- Kategori -->
          <div style="display:flex;align-items:center;justify-content:space-between;">
            <span style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:${accent};">${l.kategori}</span>
          </div>

          <!-- Nama laptop -->
          <div style="font-size:0.9rem;font-weight:700;color:${nameColor};line-height:1.35;">${l.nama}</div>

          <!-- Spesifikasi -->
          <div style="display:flex;flex-direction:column;gap:4px;">
            <div style="font-size:0.76rem;color:${specColor};">🖥️ ${l.cpu}</div>
            <div style="font-size:0.76rem;color:${specColor};">🎮 ${l.gpu}</div>
            <div style="font-size:0.76rem;color:${specColor};">💾 ${l.ram}</div>
            ${state.performa === 'gaming' && l.gpuTgp ? `<div style="font-size:0.76rem;color:${light ? '#ea580c' : '#f97316'};">⚡ TGP: ${l.gpuTgp}W · VRAM: ${l.gpuVram}GB</div>` : ''}
            ${state.performa === 'produktivitas' && l.pmMulti ? `<div style="font-size:0.76rem;color:${light ? '#2563eb' : '#60a5fa'};">🖥️ Passmark Multi: ${l.pmMulti.toLocaleString('id-ID')}</div>` : ''}
            ${state.performa === 'ringan' ? `<div style="font-size:0.76rem;color:${light ? '#059669' : '#34d399'};">${!l.gpuDed ? '🔋 Tanpa dGPU' : ''}${l.bobot ? (l.gpuDed ? '' : ' · ') + '⚖️ ' + l.bobot + ' kg' : ''}${l.pmMulti ? ' · eff: ' + Math.round(efficiencyScore(l)) : ''}</div>` : ''}
          </div>

          <!-- Badges -->
          ${badges.length ? `<div style="display:flex;flex-wrap:wrap;gap:5px;">${badges.join('')}</div>` : ''}

          <!-- Footer: harga + link -->
          <div style="display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:8px;border-top:1px solid ${footerLine};">
            <span style="font-size:0.83rem;font-weight:700;color:${hargaColor};">${l.harga}</span>
            <span style="font-size:0.75rem;color:${seeColor};">Lihat review →</span>
          </div>

        </div>
      </a>`;
  }

  function render() {
    const header = document.getElementById('resultsHeader');
    const grid = document.getElementById('resultsGrid');
    const fallbackNote = document.getElementById('fallbackNote');

    if (!hasAnyFilter()) {
      header.innerHTML = `Pilih filter di atas untuk menemukan laptop yang pas.`;
      fallbackNote.style.display = 'none';
      grid.innerHTML = '';
      return;
    }

    const matched = laptops.filter(l => passesAllFilters(l));

    if (matched.length > 0) {
      fallbackNote.style.display = 'none';
      fallbackNote.innerHTML = '';   // bersihkan diagnosa lama supaya tidak tertinggal
      header.innerHTML = `<strong>${matched.length} laptop</strong> cocok dengan pilihanmu`;
      grid.innerHTML = sortByPerforma(matched).map(l => buildCard(l)).join('');
    } else {
      // Fallback: tampilkan 3 laptop dengan skor tertinggi.
      // sortByPerforma() dijalankan lebih dulu supaya jadi tiebreak — Array.sort
      // bersifat stabil, jadi laptop berskor sama tetap urut sesuai prioritas
      // performa yang dipilih user, bukan urutan acak dari array sumber.
      const scored = sortByPerforma(laptops.map(l => ({ ...l, _score: scoreClosest(l) })))
        .sort((a, b) => b._score - a._score)
        .slice(0, 3);

      fallbackNote.style.display = 'block';
      fallbackNote.innerHTML =
        `<span class="fallback-note">⚠️ Tidak ada laptop yang 100% cocok. Ini yang paling mendekati kebutuhanmu:</span>`
        + diagnosaKosong();
      header.innerHTML = `Tidak ada laptop yang cocok 100% — menampilkan <strong>${scored.length} yang paling mendekati</strong>`;
      grid.innerHTML = scored.map(l => buildCard(l)).join('');
    }
  }

  // Chip click handling
  document.querySelectorAll('.filter-chips').forEach(group => {
    const groupName = group.dataset.group;
    group.querySelectorAll('.chip').forEach(chip => {
      chip.addEventListener('click', () => {
        // Toggle: kalau sudah aktif → deselect
        const isActive = chip.classList.contains('active');
        group.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
        const bar = group.closest('.filter-bar');
        if (isActive) {
          state[groupName] = null;
          bar.classList.remove('has-selection');
        } else {
          chip.classList.add('active');
          state[groupName] = chip.dataset.val;
          bar.classList.add('has-selection');
        }
        render();
        catatPilihanFilter();
      });
    });
  });

  // Reset
  document.getElementById('resetBtn').addEventListener('click', () => {
    Object.keys(state).forEach(k => state[k] = null);
    document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
    document.querySelectorAll('.filter-bar').forEach(b => b.classList.remove('has-selection'));
    render();
  });

  // Re-render hasil saat tema berubah agar warna card (inline styles) ikut menyesuaikan
  new MutationObserver(() => {
    if (hasAnyFilter()) render();
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  /* ═══════════ GATE: nama + email ═══════════ */
  const gateBox    = document.getElementById('gateBox');
  const gateHalo   = document.getElementById('gateHalo');
  const wizard     = document.getElementById('filterWizard');
  const gateForm   = document.getElementById('gateForm');
  const inpNama    = document.getElementById('gNama');
  const inpEmail   = document.getElementById('gEmail');
  const errNama    = document.getElementById('errNama');
  const errEmail   = document.getElementById('errEmail');
  const gateBtn    = document.getElementById('gateBtn');

  let pengguna = null;
  const pilihanGate = { okupansi: null, kebutuhan: null };

  /* Chip okupansi & kebutuhan — satu pilihan per grup, bisa dibatalkan
     dengan mengklik ulang chip yang sudah aktif. */
  document.querySelectorAll('.gate-pilihan').forEach(grup => {
    const nama = grup.dataset.grup;
    grup.querySelectorAll('.gate-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        const sudahAktif = chip.classList.contains('aktif');
        grup.querySelectorAll('.gate-chip').forEach(c => c.classList.remove('aktif'));
        if (sudahAktif) {
          pilihanGate[nama] = null;
        } else {
          chip.classList.add('aktif');
          pilihanGate[nama] = chip.dataset.val;
        }
        grup.classList.remove('salah');
      });
    });
  });

  function bacaSimpanan() {
    try {
      const raw = localStorage.getItem(KUNCI_SIMPAN);
      if (!raw) return null;
      const o = JSON.parse(raw);
      return (o && o.nama && o.email) ? o : null;
    } catch (e) { return null; }
  }

  /* Catatan: okupansi & kebutuhan SENGAJA tidak memengaruhi filter apa pun.
     Keduanya murni data untuk analisis. Filter 5 pertanyaan tetap berdiri
     sendiri dan selalu dimulai dari kondisi kosong. */

  function ringkasProfil(u) {
    return `okupansi=${u.okupansi || '-'} | kebutuhan=${u.kebutuhan || '-'}`;
  }

  function bukaKunci(u, baruDaftar) {
    pengguna = u;
    gateBox.hidden = true;
    wizard.hidden = false;
    document.querySelector('.results-section').hidden = false;
    document.getElementById('haloNama').textContent = u.nama;
    document.getElementById('haloProfil').textContent =
      [u.okupansi, u.kebutuhan].filter(Boolean).join(' · ');
    gateHalo.hidden = false;
    if (baruDaftar) kirimKeForm(u.nama, u.email, `(baru mendaftar) ${ringkasProfil(u)}`);
  }

  /* Validasi email: cukup longgar supaya tidak menolak alamat yang sah,
     tapi tetap menangkap salah ketik yang jelas seperti "budi@" atau "budi.com". */
  function emailValid(s) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(s.trim()); }

  gateForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const nama  = inpNama.value.trim();
    const email = inpEmail.value.trim();
    let ok = true;

    errNama.textContent = ''; inpNama.classList.remove('salah');
    errEmail.textContent = ''; inpEmail.classList.remove('salah');
    document.getElementById('errOkupansi').textContent = '';
    document.getElementById('errKebutuhan').textContent = '';
    document.querySelectorAll('.gate-pilihan').forEach(g => g.classList.remove('salah'));

    if (nama.length < 2) {
      errNama.textContent = 'Nama minimal 2 huruf.';
      inpNama.classList.add('salah'); ok = false;
    }
    if (!emailValid(email)) {
      errEmail.textContent = 'Format email belum benar. Contoh: nama@email.com';
      inpEmail.classList.add('salah'); ok = false;
    }
    if (!pilihanGate.okupansi) {
      document.getElementById('errOkupansi').textContent = 'Pilih salah satu.';
      document.querySelector('.gate-pilihan[data-grup="okupansi"]').classList.add('salah'); ok = false;
    }
    if (!pilihanGate.kebutuhan) {
      document.getElementById('errKebutuhan').textContent = 'Pilih salah satu.';
      document.querySelector('.gate-pilihan[data-grup="kebutuhan"]').classList.add('salah'); ok = false;
    }
    if (!ok) return;

    gateBtn.disabled = true;
    gateBtn.textContent = 'Membuka…';

    const u = {
      nama, email,
      okupansi: pilihanGate.okupansi,
      kebutuhan: pilihanGate.kebutuhan,
      waktu: new Date().toISOString(),
    };
    try { localStorage.setItem(KUNCI_SIMPAN, JSON.stringify(u)); } catch (err) {}
    bukaKunci(u, true);
  });

  document.getElementById('gateReset').addEventListener('click', () => {
    try { localStorage.removeItem(KUNCI_SIMPAN); } catch (e) {}
    pengguna = null;
    gateHalo.hidden = true;
    wizard.hidden = true;
    document.querySelector('.results-section').hidden = true;
    gateBox.hidden = false;
    gateBtn.disabled = false;
    gateBtn.textContent = 'Buka Pencarian →';
    inpNama.value = ''; inpEmail.value = '';
    pilihanGate.okupansi = null; pilihanGate.kebutuhan = null;
    document.querySelectorAll('.gate-chip').forEach(c => c.classList.remove('aktif'));
    gateBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  /* Rekam pilihan filter untuk analisis. Dikirim sekali saja per kunjungan,
     5 detik setelah pengguna berhenti mengubah pilihan, supaya satu sesi
     tidak menghasilkan puluhan baris di spreadsheet. */
  let timerFilter = null, sudahKirimFilter = false;
  function catatPilihanFilter() {
    if (!pengguna || sudahKirimFilter || !ENTRY_FILTER) return;
    clearTimeout(timerFilter);
    timerFilter = setTimeout(() => {
      const isi = Object.entries(state).filter(([, v]) => v);
      if (isi.length === 0) return;
      const ringkasan = isi.map(([k, v]) => `${k}=${v}`).join(', ');
      const jml = laptops.filter(l => passesAllFilters(l)).length;
      kirimKeForm(pengguna.nama, pengguna.email,
        `${ringkasProfil(pengguna)} | ${ringkasan} | hasil: ${jml} laptop`);
      sudahKirimFilter = true;
    }, 5000);
  }

  // Init
  const tersimpan = bacaSimpanan();
  if (tersimpan) {
    bukaKunci(tersimpan, false);
  } else {
    wizard.hidden = true;
    document.querySelector('.results-section').hidden = true;
  }
  render();
</script>
</BaseLayout>
