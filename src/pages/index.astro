<BaseLayout title="Home" description="Review laptop Indonesia jujur & terpercaya — dari budget hingga gaming">
  <style>
    /* ── HERO ────────────────────────────────────────────────── */
    .hero {
      border-radius: 20px; margin-bottom: 36px;
      overflow: hidden; position: relative;
      background: linear-gradient(135deg,#020210 0%,#07071f 40%,#0c1040 100%);
      border: 1px solid rgba(96,165,250,0.22);
      box-shadow: 0 0 80px rgba(96,165,250,0.07);
      animation: glow-pulse 4s ease-in-out infinite;
    }
    .hero::before {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background:
        radial-gradient(ellipse at 20% 60%, rgba(167,139,250,0.18) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 15%, rgba(34,211,238,0.12) 0%, transparent 45%),
        radial-gradient(ellipse at 55% 95%, rgba(96,165,250,0.08) 0%, transparent 40%);
    }
    .hero-inner {
      display: flex; align-items: stretch; min-height: 340px;
    }
    .hero-text {
      flex: 1; padding: 52px 44px;
      display: flex; flex-direction: column; justify-content: center;
      position: relative; z-index: 1;
    }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 6px;
      background: rgba(96,165,250,0.12); border: 1px solid rgba(96,165,250,0.3);
      color: #93c5fd; font-size: 0.75rem; font-weight: 600;
      padding: 5px 14px; border-radius: 20px; margin-bottom: 18px;
      width: fit-content;
      animation: badge-in 0.6s cubic-bezier(.22,1,.36,1) both;
    }
    .hero h1 {
      font-size: 2.4rem; font-weight: 800;
      line-height: 1.15; margin-bottom: 14px;
      background: linear-gradient(135deg, #e2e8f0 0%, #93c5fd 50%, #c4b5fd 100%);
      background-size: 200% auto;
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: shimmer 4s linear infinite;
    }
    .hero p {
      font-size: 1rem; color: rgba(226,232,240,0.8);
      max-width: 400px; margin-bottom: 28px; line-height: 1.65;
    }
    .hero-btns { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 0; }
    .hero-btn {
      background: linear-gradient(135deg,#3b82f6,#2563eb);
      color: white; padding: 13px 28px; border-radius: 10px;
      font-weight: 700; text-decoration: none; font-size: 0.95rem;
      display: inline-block; transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 0 24px rgba(59,130,246,0.45);
      letter-spacing: 0.01em;
    }
    .hero-btn:hover { transform: translateY(-2px); box-shadow: 0 0 36px rgba(59,130,246,0.65); }
    .hero-btn-outline {
      background: rgba(255,255,255,0.06); color: #e2e8f0;
      border: 1.5px solid rgba(255,255,255,0.25); padding: 13px 28px;
      border-radius: 10px; font-weight: 600; text-decoration: none;
      font-size: 0.95rem; display: inline-block; transition: all 0.2s;
      backdrop-filter: blur(8px);
    }
    .hero-btn-outline:hover { background: rgba(255,255,255,0.12); border-color: rgba(255,255,255,0.5); }
    .hero-disclaimer {
      font-size: 0.78rem; margin-top: 20px; line-height: 1.55; max-width: 440px;
      background: rgba(251,191,36,0.1); border: 1px solid rgba(251,191,36,0.28);
      border-radius: 8px; padding: 11px 14px; color: #fde68a;
      display: flex; flex-direction: column; gap: 7px;
    }
    .hero-disclaimer p { margin: 0; }
    .hero-disclaimer a { color: #fbbf24; font-weight: 600; text-decoration: underline; }
    .hero-disclaimer a:hover { color: #fef3c7; }
    .hd-status { font-weight: 600; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .hd-badge {
      background: rgba(251,191,36,0.9); color: #431407;
      font-size: 0.64rem; font-weight: 800; letter-spacing: 0.08em;
      padding: 2px 8px; border-radius: 4px; white-space: nowrap;
    }
    .hd-afiliasi {
      font-size: 0.72rem; color: rgba(253,230,138,0.72); line-height: 1.5;
      border-top: 1px solid rgba(251,191,36,0.22); padding-top: 7px;
    }
    .hero-img {
      width: 340px; flex-shrink: 0; position: relative; overflow: hidden;
      background: linear-gradient(135deg,#050518,#0c1444);
    }
    .hero-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

    /* ── STATS ───────────────────────────────────────────────── */
    .stats-bar {
      display: grid; grid-template-columns: repeat(4,1fr);
      gap: 14px; margin-bottom: 40px;
    }
    .stat-card {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 14px; padding: 20px 16px; text-align: center;
      transition: border-color 0.3s, box-shadow 0.3s;
      position: relative; overflow: hidden;
    }
    .stat-card::before {
      content: ""; position: absolute; inset: 0; opacity: 0;
      background: radial-gradient(ellipse at 50% 0%, rgba(96,165,250,0.12), transparent 70%);
      transition: opacity 0.3s;
    }
    .stat-card:hover::before { opacity: 1; }
    .stat-card:hover { border-color: rgba(96,165,250,0.4); }
    .stat-angka {
      font-size: 2rem; font-weight: 800; color: #60a5fa;
      line-height: 1; margin-bottom: 5px;
      text-shadow: 0 0 20px rgba(96,165,250,0.4);
    }
    .stat-label { font-size: 0.75rem; color: #64748b; font-weight: 500; letter-spacing: 0.03em; }

    /* ── SECTIONS ────────────────────────────────────────────── */
    .section-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 18px;
    }
    .section-title {
      font-size: 1.35rem; font-weight: 700; color: #e2e8f0;
      display: flex; align-items: center; gap: 8px;
    }
    .section-title::before {
      content: ""; display: inline-block; width: 3px; height: 18px;
      background: linear-gradient(to bottom,#60a5fa,#a78bfa);
      border-radius: 2px;
    }
    .section-link {
      font-size: 0.82rem; color: #60a5fa; text-decoration: none;
      font-weight: 500; opacity: 0.85; transition: opacity 0.2s;
    }
    .section-link:hover { opacity: 1; text-decoration: underline; }

    /* ── KATEGORI CARDS ──────────────────────────────────────── */
    .kategori-grid {
      display: grid; grid-template-columns: repeat(4,1fr);
      gap: 14px; margin-bottom: 40px;
    }
    .kat-card {
      border-radius: 16px; overflow: hidden;
      text-decoration: none; color: inherit;
      transition: transform 0.28s cubic-bezier(.22,1,.36,1), box-shadow 0.28s;
      position: relative; aspect-ratio: 3/2;
      display: flex; flex-direction: column; justify-content: flex-end;
      border: 1px solid rgba(255,255,255,0.08);
    }
    .kat-bg {
      position: absolute; inset: 0;
      background-size: cover; background-position: center;
      filter: brightness(0.4) saturate(1.1);
      transition: filter 0.3s, transform 0.4s;
    }
    .kat-card:hover .kat-bg { filter: brightness(0.55) saturate(1.3); transform: scale(1.04); }
    .kat-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top,rgba(2,2,14,0.92) 0%,rgba(2,2,14,0.2) 100%);
    }
    .kat-content {
      position: relative; z-index: 1; padding: 16px;
    }
    .kat-icon { font-size: 1.6rem; display: block; margin-bottom: 4px; }
    .kat-name { font-size: 0.95rem; font-weight: 700; color: #f1f5f9; }
    .kat-count { font-size: 0.72rem; color: #94a3b8; margin-top: 2px; }
    .kat-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(0,0,0,0.5); }

    /* ── REVIEW CARDS ────────────────────────────────────────── */
    .review-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px,1fr));
      gap: 18px; margin-bottom: 48px;
    }
    .review-card {
      background: rgba(255,255,255,0.04); border-radius: 16px;
      border: 1px solid rgba(255,255,255,0.08);
      transition: transform 0.28s cubic-bezier(.22,1,.36,1), border-color 0.25s, box-shadow 0.28s;
      text-decoration: none; color: inherit; display: block;
      overflow: hidden;
    }
    .review-card:hover {
      border-color: rgba(96,165,250,0.4); transform: translateY(-4px);
      box-shadow: 0 16px 40px rgba(0,0,0,0.4), 0 0 20px rgba(96,165,250,0.08);
    }
    .card-top {
      height: 90px;
      display: flex; align-items: center; justify-content: center;
      position: relative; overflow: hidden;
    }
    .card-top-img {
      position: absolute; inset: 0;
      filter: brightness(0.45) saturate(1.15);
      transition: opacity 0.3s;
    }
    .review-card:hover .card-top-img { opacity: 0.85; }
    .card-emoji { font-size: 2rem; position: relative; z-index: 1; }
    .card-body { padding: 15px; }
    .card-badge {
      font-size: 0.7rem; font-weight: 700; padding: 3px 10px;
      border-radius: 20px; display: inline-block; margin-bottom: 8px;
      letter-spacing: 0.03em;
    }
    .card-title { font-size: 0.92rem; font-weight: 700; color: #e2e8f0; margin-bottom: 6px; line-height: 1.35; }
    .card-desc { font-size: 0.78rem; color: #64748b; margin-bottom: 12px; line-height: 1.45; }
    .card-footer { display: flex; justify-content: space-between; align-items: center; }
    .card-price { font-weight: 700; color: #34d399; font-size: 0.88rem; }
    .card-rating {
      background: rgba(251,191,36,0.15); color: #fbbf24;
      font-size: 0.72rem; font-weight: 700; padding: 4px 9px; border-radius: 20px;
    }

    /* ── CTA ─────────────────────────────────────────────────── */
    .cta-bar { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 16px; }
    .cta-card {
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
      border-radius: 16px; padding: 24px; text-decoration: none; color: inherit;
      transition: transform 0.28s cubic-bezier(.22,1,.36,1), border-color 0.25s, box-shadow 0.28s;
      display: block; position: relative; overflow: hidden;
    }
    .cta-card::before {
      content: ""; position: absolute; inset: 0; opacity: 0;
      background: radial-gradient(ellipse at 0% 0%, rgba(167,139,250,0.12), transparent 60%);
      transition: opacity 0.3s;
    }
    .cta-card:hover::before { opacity: 1; }
    .cta-card:hover { border-color: rgba(167,139,250,0.4); transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.3); }
    .cta-icon { font-size: 1.8rem; margin-bottom: 10px; display: block; }
    .cta-title { font-size: 0.98rem; font-weight: 700; color: #e2e8f0; margin-bottom: 5px; }
    .cta-desc { font-size: 0.8rem; color: #64748b; line-height: 1.5; }

    /* ── MOBILE ──────────────────────────────────────────────── */
    @media (max-width: 768px) {
      .hero-inner { flex-direction: column; min-height: unset; }
      .hero-text { padding: 28px 20px 24px; }
      .hero h1 { font-size: 1.8rem; }
      .hero p { font-size: 0.92rem; max-width: 100%; margin-bottom: 22px; }
      .hero-btns { flex-direction: column; gap: 10px; }
      .hero-btn, .hero-btn-outline {
        text-align: center; padding: 13px 20px; width: 100%;
        font-size: 0.95rem;
      }
      .hero-img { display: none; }
      .stats-bar { grid-template-columns: repeat(2,1fr); gap: 10px; margin-bottom: 28px; }
      .stat-angka { font-size: 1.7rem; }
      .stat-card { padding: 16px 12px; border-radius: 12px; }
      .kategori-grid { grid-template-columns: repeat(2,1fr); gap: 10px; margin-bottom: 28px; }
      .kat-card { aspect-ratio: unset; min-height: 90px; }
      .kat-content { padding: 12px; }
      .kat-icon { font-size: 1.4rem; }
      .kat-name { font-size: 0.88rem; }
      .review-grid { grid-template-columns: 1fr; gap: 14px; }
      .card-top { height: 140px; }
      .cta-bar { grid-template-columns: 1fr; gap: 10px; }
      .section-title { font-size: 1.15rem; }
      .hero-badge { font-size: 0.7rem; }
    }
    @media (max-width: 400px) {
      .hero h1 { font-size: 1.6rem; }
      .stats-bar { gap: 8px; }
      .stat-angka { font-size: 1.5rem; }
    }

    /* ── PANDUAN PAKAI ── */
    .panduan-hint { font-size: 0.82rem; color: #64748b; }
    .panduan-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 12px;
    }
    .panduan-card {
      display: flex; align-items: flex-start; gap: 13px;
      background: rgba(255,255,255,0.035);
      border: 1px solid rgba(255,255,255,0.09);
      border-radius: 12px; padding: 15px 16px;
      text-decoration: none; color: inherit;
      transition: border-color 0.22s, background 0.22s, transform 0.22s;
    }
    .panduan-card:hover {
      border-color: rgba(96,165,250,0.45);
      background: rgba(96,165,250,0.07);
      transform: translateY(-2px);
    }
    .panduan-icon { font-size: 1.4rem; line-height: 1.2; flex-shrink: 0; }
    .panduan-text { flex: 1; min-width: 0; }
    .panduan-nama {
      font-size: 0.95rem; font-weight: 700; color: #e2e8f0; margin-bottom: 3px;
    }
    .panduan-text p {
      font-size: 0.82rem; color: #94a3b8; line-height: 1.5; margin: 0;
    }
    .panduan-arrow {
      color: #475569; font-size: 1rem; flex-shrink: 0; align-self: center;
      transition: color 0.22s, transform 0.22s;
    }
    .panduan-card:hover .panduan-arrow { color: #60a5fa; transform: translateX(3px); }

    /* ── LIGHT MODE: perbaiki keterbacaan judul kartu review (sebelumnya near-white di background terang) ── */
    :global(html[data-theme="light"]) .card-title { color: #0f172a; }
    :global(html[data-theme="light"]) .card-desc { color: #475569; }
    :global(html[data-theme="light"]) .panduan-card {
      background: rgba(255,255,255,0.85);
      border-color: rgba(0,0,0,0.1);
      box-shadow: 0 1px 6px rgba(0,0,0,0.05);
    }
    :global(html[data-theme="light"]) .panduan-card:hover {
      background: rgba(96,165,250,0.08);
      border-color: rgba(37,99,235,0.45);
    }
    :global(html[data-theme="light"]) .panduan-nama { color: #0f172a; }
    :global(html[data-theme="light"]) .panduan-text p { color: #475569; }
  </style>

