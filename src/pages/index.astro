const stats = [
  { angka: "25", label: "Laptop Diulas" },
  { angka: "3", label: "Kategori" },
  { angka: "9", label: "Brand" },
  { angka: "6\u201320 Jt", label: "Rentang Harga" },
];

const kategoriBadgeColor: Record<string, string> = {
  Produktivitas: "#eff6ff",
  Budget: "#f0fdf4",
  Gaming: "#fef3c7",
};
const kategoriBadgeText: Record<string, string> = {
  Produktivitas: "#2563eb",
  Budget: "#16a34a",
  Gaming: "#b45309",
};
---

<BaseLayout title="Home" description="Review laptop Indonesia jujur & terpercaya — 25 laptop dari budget hingga gaming">
  <style>
    .hero { background: linear-gradient(135deg, #1e40af, #2563eb); color: white; padding: 56px 40px; border-radius: 16px; text-align: center; margin-bottom: 40px; }
    .hero h1 { font-size: 2.4rem; font-weight: 800; margin-bottom: 12px; }
    .hero p { font-size: 1.05rem; opacity: 0.9; max-width: 520px; margin: 0 auto 24px; }
    .hero-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .hero-btn { background: white; color: #2563eb; padding: 11px 24px; border-radius: 8px; font-weight: 600; text-decoration: none; font-size: 0.95rem; display: inline-block; transition: transform 0.2s; }
    .hero-btn:hover { transform: translateY(-2px); }
    .hero-btn-outline { background: transparent; color: white; border: 2px solid rgba(255,255,255,0.6); padding: 11px 24px; border-radius: 8px; font-weight: 600; text-decoration: none; font-size: 0.95rem; display: inline-block; transition: all 0.2s; }
    .hero-btn-outline:hover { background: rgba(255,255,255,0.15); border-color: white; }
    .stats-bar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 40px; }
    .stat-card { background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; text-align: center; }
    .stat-angka { font-size: 1.8rem; font-weight: 800; color: #2563eb; line-height: 1; margin-bottom: 4px; }
    .stat-label { font-size: 0.8rem; color: #6b7280; font-weight: 500; }
    .section-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 20px; }
    .section-title { font-size: 1.4rem; font-weight: 700; color: #111; }
    .section-link { font-size: 0.875rem; color: #2563eb; text-decoration: none; font-weight: 500; }
    .section-link:hover { text-decoration: underline; }
    .kategori-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 40px; }
    .kat-card { background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 24px 20px; text-align: center; text-decoration: none; color: inherit; transition: box-shadow 0.2s, transform 0.2s; }
    .kat-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); transform: translateY(-3px); }
    .kat-icon { font-size: 2rem; margin-bottom: 8px; }
    .kat-name { font-size: 1rem; font-weight: 700; margin-bottom: 4px; }
    .kat-count { font-size: 0.8rem; color: #6b7280; }
    .review-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 20px; margin-bottom: 48px; }
    .review-card { background: white; border-radius: 12px; border: 1px solid #e5e7eb; transition: box-shadow 0.2s, transform 0.2s; text-decoration: none; color: inherit; display: block; }
    .review-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.09); transform: translateY(-3px); }
    .card-top { height: 120px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; border-radius: 12px 12px 0 0; }
    .card-body { padding: 16px; }
    .card-badge { font-size: 0.72rem; font-weight: 600; padding: 3px 9px; border-radius: 20px; display: inline-block; margin-bottom: 8px; }
    .card-title { font-size: 0.95rem; font-weight: 700; margin-bottom: 6px; line-height: 1.3; }
    .card-desc { font-size: 0.8rem; color: #6b7280; margin-bottom: 12px; line-height: 1.4; }
    .card-footer { display: flex; justify-content: space-between; align-items: center; }
    .card-price { font-weight: 700; color: #059669; font-size: 0.9rem; }
    .card-rating { background: #fef9c3; color: #92400e; font-size: 0.75rem; font-weight: 700; padding: 3px 8px; border-radius: 20px; }
    .cta-bar { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
    .cta-card { background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 24px; text-decoration: none; color: inherit; transition: box-shadow 0.2s, transform 0.2s; display: block; }
    .cta-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); transform: translateY(-3px); }
    .cta-icon { font-size: 1.8rem; margin-bottom: 8px; }
    .cta-title { font-size: 1rem; font-weight: 700; margin-bottom: 4px; }
    .cta-desc { font-size: 0.82rem; color: #6b7280; }
    @media (max-width: 640px) {
      .hero { padding: 40px 20px; }
      .hero h1 { font-size: 1.8rem; }
      .stats-bar { grid-template-columns: repeat(2, 1fr); }
      .kategori-grid { grid-template-columns: 1fr; }
      .cta-bar { grid-template-columns: 1fr; }
    }
  </style>

  <section class="hero">
    <h1>Review Laptop Indonesia \U0001F1EE\U0001F1E9</h1>
    <p>Panduan jujur memilih laptop sesuai kebutuhan dan budget — dari pelajar sampai gamer.</p>
    <div class="hero-btns">
      <a href="/review" class="hero-btn">Lihat Semua Review \u2192</a>
      <a href="/compare" class="hero-btn-outline">Bandingkan Laptop</a>
    </div>
  </section>

  <div class="stats-bar">
    {stats.map(s => (
      <div class="stat-card">
        <div class="stat-angka">{s.angka}</div>
        <div class="stat-label">{s.label}</div>
      </div>
    ))}
  </div>

  <section>
    <div class="section-header">
      <h2 class="section-title">Jelajahi Kategori</h2>
    </div>
    <div class="kategori-grid">
      <a href="/review?kategori=Budget" class="kat-card">
        <div class="kat-icon">\U0001F4B0</div>
        <div class="kat-name">Budget</div>
        <div class="kat-count">7 laptop \u00B7 Rp 6\u20139 Juta</div>
      </a>
      <a href="/review?kategori=Produktivitas" class="kat-card">
        <div class="kat-icon">\U0001F4BC</div>
        <div class="kat-name">Produktivitas</div>
        <div class="kat-count">12 laptop \u00B7 Rp 7\u201312 Juta</div>
      </a>
      <a href="/review?kategori=Gaming" class="kat-card">
        <div class="kat-icon">\U0001F3AE</div>
        <div class="kat-name">Gaming</div>
        <div class="kat-count">6 laptop \u00B7 Rp 11\u201320 Juta</div>
      </a>
    </div>
  </section>

  <section>
    <div class="section-header">
      <h2 class="section-title">Semua Review ({reviews.length} Laptop)</h2>
      <a href="/review" class="section-link">Filter lengkap \u2192</a>
    </div>
    <div class="review-grid">
      {reviews.map((laptop) => (
        <a href={`/review/${laptop.slug}`} class="review-card">
          <div class="card-top">\U0001F4BB</div>
          <div class="card-body">
            <span class="card-badge" style={`background:${kategoriBadgeColor[laptop.kategori]};color:${kategoriBadgeText[laptop.kategori]}`}>
              {laptop.kategori}
            </span>
            <div class="card-title">{laptop.nama}</div>
            <div class="card-desc">{laptop.ringkasan}</div>
            <div class="card-footer">
              <span class="card-price">{laptop.harga}</span>
              <span class="card-rating">\u2B50 {laptop.rating}/5</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section>
    <div class="section-header">
      <h2 class="section-title">Tools Perbandingan</h2>
    </div>
    <div class="cta-bar">
      <a href="/compare" class="cta-card">
        <div class="cta-icon">\U0001F4CA</div>
        <div class="cta-title">Tabel Perbandingan</div>
        <div class="cta-desc">Bandingkan semua 25 laptop side-by-side. Sortir dan filter per kolom.</div>
      </a>
      <a href="/h2h" class="cta-card">
        <div class="cta-icon">\u2694\uFE0F</div>
        <div class="cta-title">Head-to-Head</div>
        <div class="cta-desc">Pilih 2 laptop, bandingkan spesifikasi + data benchmark secara detail.</div>
      </a>
    </div>
  </section>
</BaseLayout>
