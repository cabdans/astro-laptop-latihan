const stats = [
  { angka: "26", label: "Laptop Diulas" },
  { angka: "3", label: "Kategori" },
  { angka: "9", label: "Brand" },
  { angka: "6–20 Jt", label: "Rentang Harga" },
];

const kategoriBadgeColor: Record<string, string> = {
  Produktivitas: "#eff6ff",
  Budget: "#f0fdf4",
  Gaming: "#fef3c7",
};
const kategoriBadgeText: Record<string, string> = {
  Produktivitas: "#2563eb",
  Budget: "#16a34a",
  Gaming: "#b45309",
};
---

<BaseLayout title="Home" description="Review laptop Indonesia jujur & terpercaya — 26 laptop dari budget hingga gaming">
  <style>
    /* HERO — deep space split layout */
    .hero {
      background: linear-gradient(135deg, #02020e 0%, #07071f 35%, #0d1140 70%, #0a1832 100%);
      border: 1px solid rgba(96,165,250,0.2);
      color: white; border-radius: 16px; margin-bottom: 40px;
      overflow: hidden; display: flex; align-items: stretch; min-height: 340px;
      position: relative;
      box-shadow: 0 0 60px rgba(96,165,250,0.08);
    }
    .hero::before {
      content: "";
      position: absolute; inset: 0; pointer-events: none;
      background:
        radial-gradient(ellipse at 25% 60%, rgba(167,139,250,0.18) 0%, transparent 55%),
        radial-gradient(ellipse at 75% 20%, rgba(34,211,238,0.12) 0%, transparent 45%),
        radial-gradient(ellipse at 50% 90%, rgba(96,165,250,0.1) 0%, transparent 40%);
    }
    .hero-text { flex: 1; padding: 52px 44px; display: flex; flex-direction: column; justify-content: center; position: relative; z-index: 1; }
    .hero h1 { font-size: 2.3rem; font-weight: 800; margin-bottom: 12px; line-height: 1.15; text-shadow: 0 0 40px rgba(96,165,250,0.5); }
    .hero p { font-size: 1.02rem; opacity: 0.85; max-width: 420px; margin-bottom: 28px; line-height: 1.65; }
    .hero-btns { display: flex; gap: 12px; flex-wrap: wrap; }
    .hero-img { width: 360px; flex-shrink: 0; position: relative; overflow: hidden; background: linear-gradient(135deg, #050518, #0c1444); }
    .hero-img img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
    .hero-btn {
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      color: white; padding: 11px 26px; border-radius: 8px;
      font-weight: 600; text-decoration: none; font-size: 0.95rem; display: inline-block;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 0 20px rgba(59,130,246,0.4);
    }
    .hero-btn:hover { transform: translateY(-2px); box-shadow: 0 0 30px rgba(59,130,246,0.6); }
    .hero-btn-outline {
      background: transparent; color: white;
      border: 1.5px solid rgba(255,255,255,0.4); padding: 11px 26px;
      border-radius: 8px; font-weight: 600; text-decoration: none;
      font-size: 0.95rem; display: inline-block; transition: all 0.2s;
    }
    .hero-btn-outline:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.7); }

    /* STATS */
    .stats-bar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 40px; }
    .stat-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.09); border-radius: 12px; padding: 20px; text-align: center; transition: border-color 0.2s; }
    .stat-card:hover { border-color: rgba(96,165,250,0.3); }
    .stat-angka { font-size: 1.8rem; font-weight: 800; color: #60a5fa; line-height: 1; margin-bottom: 4px; }
    .stat-label { font-size: 0.8rem; color: #94a3b8; font-weight: 500; }

    /* SECTIONS */
    .section-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 20px; }
    .section-title { font-size: 1.4rem; font-weight: 700; color: #e2e8f0; }
    .section-link { font-size: 0.875rem; color: #60a5fa; text-decoration: none; font-weight: 500; }
    .section-link:hover { text-decoration: underline; }

    /* KATEGORI */
    .kategori-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 40px; }
    .kat-card {
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.09);
      border-radius: 12px; padding: 28px 20px; text-align: center;
      text-decoration: none; color: inherit; transition: all 0.25s;
    }
    .kat-card:hover { border-color: rgba(96,165,250,0.4); background: rgba(96,165,250,0.06); transform: translateY(-3px); box-shadow: 0 8px 24px rgba(96,165,250,0.1); }
    .kat-icon { font-size: 2.2rem; margin-bottom: 10px; display: block; }
    .kat-name { font-size: 1rem; font-weight: 700; color: #e2e8f0; margin-bottom: 4px; }
    .kat-count { font-size: 0.8rem; color: #64748b; }

    /* REVIEW CARDS */
    .review-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 20px; margin-bottom: 48px; }
    .review-card {
      background: rgba(255,255,255,0.04); border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.09);
      transition: all 0.25s; text-decoration: none; color: inherit; display: block;
    }
    .review-card:hover { border-color: rgba(96,165,250,0.4); transform: translateY(-3px); box-shadow: 0 8px 24px rgba(96,165,250,0.1); }
    .card-top {
      height: 120px;
      background: linear-gradient(135deg, rgba(15,23,42,0.8), rgba(30,27,75,0.8));
      display: flex; align-items: center; justify-content: center;
      font-size: 2.5rem; border-radius: 12px 12px 0 0;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .card-body { padding: 16px; }
    .card-badge { font-size: 0.72rem; font-weight: 600; padding: 3px 9px; border-radius: 20px; display: inline-block; margin-bottom: 8px; }
    .card-title { font-size: 0.95rem; font-weight: 700; color: #e2e8f0; margin-bottom: 6px; line-height: 1.3; }
    .card-desc { font-size: 0.8rem; color: #64748b; margin-bottom: 12px; line-height: 1.4; }
    .card-footer { display: flex; justify-content: space-between; align-items: center; }
    .card-price { font-weight: 700; color: #34d399; font-size: 0.9rem; }
    .card-rating { background: rgba(251,191,36,0.15); color: #fbbf24; font-size: 0.75rem; font-weight: 700; padding: 3px 8px; border-radius: 20px; }

    /* CTA */
    .cta-bar { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
    .cta-card {
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.09);
      border-radius: 12px; padding: 24px; text-decoration: none; color: inherit;
      transition: all 0.25s; display: block;
    }
    .cta-card:hover { border-color: rgba(167,139,250,0.4); background: rgba(167,139,250,0.06); transform: translateY(-3px); }
    .cta-icon { font-size: 1.8rem; margin-bottom: 10px; display: block; }
    .cta-title { font-size: 1rem; font-weight: 700; color: #e2e8f0; margin-bottom: 4px; }
    .cta-desc { font-size: 0.82rem; color: #64748b; }

    @media (max-width: 768px) {
      .hero { flex-direction: column; min-height: unset; }
      .hero-text { padding: 36px 24px; }
      .hero h1 { font-size: 1.9rem; }
      .hero-img { width: 100%; height: 220px; }
      .stats-bar { grid-template-columns: repeat(2, 1fr); }
      .kategori-grid { grid-template-columns: 1fr; }
      .cta-bar { grid-template-columns: 1fr; }
    }
  </style>

  <section class="hero">
    <div class="hero-text">
      <h1>Review Laptop Indonesia 🇮🇩</h1>
      <p>Panduan jujur memilih laptop sesuai kebutuhan dan budget — dari pelajar sampai gamer.</p>
      <div class="hero-btns">
        <a href="/review" class="hero-btn">Lihat Semua Review →</a>
        <a href="/compare" class="hero-btn-outline">Bandingkan Laptop</a>
      </div>
    </div>
    <div class="hero-img">
      <img src="/astrolaptop-mascot.png" alt="AstroLaptop Mascot" />
    </div>
  </section>

  <div class="stats-bar">
    {stats.map(s => (
      <div class="stat-card">
        <div class="stat-angka">{s.angka}</div>
        <div class="stat-label">{s.label}</div>
      </div>
    ))}
  </div>

  <section>
    <div class="section-header">
      <h2 class="section-title">Jelajahi Kategori</h2>
    </div>
    <div class="kategori-grid">
      <a href="/review?kategori=Budget" class="kat-card">
        <div class="kat-icon">💰</div>
        <div class="kat-name">Budget</div>
        <div class="kat-count">7 laptop · Rp 6–9 Juta</div>
      </a>
      <a href="/review?kategori=Produktivitas" class="kat-card">
        <div class="kat-icon">💼</div>
        <div class="kat-name">Produktivitas</div>
        <div class="kat-count">12 laptop · Rp 7–12 Juta</div>
      </a>
      <a href="/review?kategori=Gaming" class="kat-card">
        <div class="kat-icon">🎮</div>
        <div class="kat-name">Gaming</div>
        <div class="kat-count">6 laptop · Rp 11–20 Juta</div>
      </a>
    </div>
  </section>

  <section>
    <div class="section-header">
      <h2 class="section-title">Semua Review ({reviews.length} Laptop)</h2>
      <a href="/review" class="section-link">Filter lengkap →</a>
    </div>
    <div class="review-grid">
      {reviews.map((laptop) => (
        <a href={`/review/${laptop.slug}`} class="review-card">
          <div class="card-top">💻</div>
          <div class="card-body">
            <span class="card-badge" style={`background:${kategoriBadgeColor[laptop.kategori]};color:${kategoriBadgeText[laptop.kategori]}`}>
              {laptop.kategori}
            </span>
            <div class="card-title">{laptop.nama}</div>
            <div class="card-desc">{laptop.ringkasan}</div>
            <div class="card-footer">
              <span class="card-price">{laptop.harga}</span>
              <span class="card-rating">⭐ {laptop.rating}/5</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section>
    <div class="section-header">
      <h2 class="section-title">Tools Perbandingan</h2>
    </div>
    <div class="cta-bar">
      <a href="/compare" class="cta-card">
        <div class="cta-icon">📊</div>
        <div class="cta-title">Tabel Perbandingan</div>
        <div class="cta-desc">Bandingkan semua 26 laptop side-by-side. Sortir dan filter per kolom.</div>
      </a>
      <a href="/h2h" class="cta-card">
        <div class="cta-icon">⚔️</div>
        <div class="cta-title">Head-to-Head</div>
        <div class="cta-desc">Pilih 2 laptop, bandingkan spesifikasi + data benchmark secara detail.</div>
      </a>
    </div>
  </section>
</BaseLayout>
