---
export interface Props {
  title: string;
  harga: string;
  rating: number;
  kategori: string;
  tanggal: string;
  ringkasan: string;
}

const { title, harga, rating, kategori, tanggal, ringkasan } = Astro.props;

// Generate bintang dari rating
const bintang = Math.round(rating);
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={ringkasan} />
    <title>Review {title} — AstroLaptop</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Segoe UI', system-ui, sans-serif;
        background: #f8f9fa;
        color: #1a1a1a;
        line-height: 1.7;
      }

      nav {
        background: #fff;
        border-bottom: 1px solid #e5e7eb;
        padding: 0 24px;
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .nav-inner {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 60px;
      }

      .nav-logo {
        font-size: 1.3rem;
        font-weight: 700;
        color: #2563eb;
        text-decoration: none;
      }

      .nav-links {
        display: flex;
        gap: 24px;
        list-style: none;
      }

      .nav-links a {
        text-decoration: none;
        color: #4b5563;
        font-size: 0.95rem;
      }

      .nav-links a:hover { color: #2563eb; }

      /* LAYOUT */
      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 24px;
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 40px;
      }

      @media (max-width: 768px) {
        .container { grid-template-columns: 1fr; }
      }

      /* ARTIKEL */
      .article-header {
        margin-bottom: 32px;
      }

      .badge {
        background: #eff6ff;
        color: #2563eb;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 20px;
        display: inline-block;
        margin-bottom: 12px;
      }

      h1 {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 12px;
        line-height: 1.3;
      }

      .meta {
        color: #6b7280;
        font-size: 0.875rem;
        margin-bottom: 16px;
      }

      .ringkasan {
        font-size: 1.05rem;
        color: #374151;
        background: #f0f9ff;
        border-left: 4px solid #2563eb;
        padding: 16px 20px;
        border-radius: 0 8px 8px 0;
        margin-bottom: 32px;
      }

      /* RATING BESAR */
      .rating-box {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 24px;
        text-align: center;
        margin-bottom: 32px;
      }

      .rating-angka {
        font-size: 4rem;
        font-weight: 800;
        color: #2563eb;
        line-height: 1;
      }

      .rating-bintang {
        font-size: 1.5rem;
        margin: 8px 0;
      }

      .rating-label {
        color: #6b7280;
        font-size: 0.875rem;
      }

      /* KONTEN ARTIKEL */
      .artikel-konten h2 {
        font-size: 1.4rem;
        font-weight: 700;
        margin: 32px 0 16px;
        padding-bottom: 8px;
        border-bottom: 2px solid #e5e7eb;
      }

      .artikel-konten p {
        margin-bottom: 16px;
        color: #374151;
      }

      /* TABEL SPESIFIKASI */
      .spek-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 32px;
        background: white;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e5e7eb;
      }

      .spek-table tr:nth-child(even) { background: #f9fafb; }

      .spek-table td {
        padding: 12px 16px;
        font-size: 0.9rem;
        border-bottom: 1px solid #f3f4f6;
      }

      .spek-table td:first-child {
        font-weight: 600;
        color: #374151;
        width: 40%;
      }

      /* KELEBIHAN KEKURANGAN */
      .pros-cons {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 32px;
      }

      @media (max-width: 500px) {
        .pros-cons { grid-template-columns: 1fr; }
      }

      .pros, .cons {
        background: white;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #e5e7eb;
      }

      .pros h3 { color: #059669; margin-bottom: 12px; }
      .cons h3 { color: #dc2626; margin-bottom: 12px; }

      .pros ul, .cons ul {
        padding-left: 20px;
        font-size: 0.9rem;
        color: #374151;
      }

      .pros li { margin-bottom: 6px; }
      .cons li { margin-bottom: 6px; }

      /* SIDEBAR */
      .sidebar {
        position: sticky;
        top: 80px;
        align-self: start;
      }

      .sidebar-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 20px;
      }

      .sidebar-card h3 {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 16px;
        color: #111;
      }

      .harga-display {
        font-size: 1.8rem;
        font-weight: 800;
        color: #059669;
        margin-bottom: 16px;
      }

      .btn-beli {
        display: block;
        background: #2563eb;
        color: white;
        text-align: center;
        padding: 14px;
        border-radius: 8px;
        font-weight: 700;
        text-decoration: none;
        font-size: 1rem;
        transition: background 0.2s;
        margin-bottom: 10px;
      }

      .btn-beli:hover { background: #1d4ed8; }

      .btn-beli-secondary {
        display: block;
        background: #f97316;
        color: white;
        text-align: center;
        padding: 12px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        font-size: 0.9rem;
        transition: background 0.2s;
      }

      .btn-beli-secondary:hover { background: #ea580c; }

      .disclaimer {
        font-size: 0.75rem;
        color: #9ca3af;
        margin-top: 10px;
        text-align: center;
      }

      footer {
        background: #1a1a1a;
        color: #9ca3af;
        text-align: center;
        padding: 24px;
        margin-top: 64px;
        font-size: 0.875rem;
      }
    </style>
  </head>
  <body>
    <nav>
      <div class="nav-inner">
        <a href="/" class="nav-logo">🖥️ AstroLaptop</a>
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/review">Review</a></li>
          <li><a href="/compare">Perbandingan</a></li>
          <li><a href="/about">Tentang</a></li>
        </ul>
      </div>
    </nav>

    <div class="container">
      <!-- KONTEN UTAMA -->
      <article>
        <div class="article-header">
          <span class="badge">{kategori}</span>
          <h1>Review {title}</h1>
          <div class="meta">Diterbitkan: {tanggal}</div>
          <div class="ringkasan">{ringkasan}</div>
        </div>

        <!-- RATING -->
        <div class="rating-box">
          <div class="rating-angka">{rating}</div>
          <div class="rating-bintang">
            {Array.from({length: 5}).map((_, i) => (
              <span>{i < bintang ? '⭐' : '☆'}</span>
            ))}
          </div>
          <div class="rating-label">Skor keseluruhan dari 5</div>
        </div>

        <div class="artikel-konten">
          <slot />
        </div>
      </article>

      <!-- SIDEBAR -->
      <aside class="sidebar">
        <div class="sidebar-card">
          <h3>💰 Harga</h3>
          <div class="harga-display">{harga}</div>
          <a href="#" class="btn-beli">🛒 Beli di Tokopedia</a>
          <a href="#" class="btn-beli-secondary">🛍️ Beli di Shopee</a>
          <p class="disclaimer">*Link afiliasi — harga dapat berubah</p>
        </div>

        <div class="sidebar-card">
          <h3>⚡ Ringkasan Cepat</h3>
          <div style="font-size: 0.875rem; color: #374151;">
            <p>✅ Cocok untuk pelajar & mahasiswa</p>
            <p style="margin-top: 8px;">⚠️ Tidak ideal untuk gaming berat</p>
          </div>
        </div>
      </aside>
    </div>

    <footer>
      <p>© 2025 AstroLaptop · Review laptop jujur untuk semua kalangan</p>
    </footer>
  </body>
</html>
