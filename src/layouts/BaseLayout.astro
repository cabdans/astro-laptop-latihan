---
export interface Props {
  title: string;
  description?: string;
}
const { title, description = "Review laptop jujur untuk semua kebutuhan dan budget." } = Astro.props;
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — AstroLaptop</title>
    <script is:inline>
      /* Apply saved theme before paint — prevents flash */
      (function(){
        if(localStorage.getItem('theme')==='light')
          document.documentElement.setAttribute('data-theme','light');
      })();
    </script>
    <style is:global>
      /* ── VARIABLES ───────────────────────────────────────────── */
      :root {
        --bg:          #050510;
        --bg-surface:  #0a0a1e;
        --bg-card:     rgba(255,255,255,0.04);
        --bg-card-h:   rgba(255,255,255,0.08);
        --border:      rgba(255,255,255,0.09);
        --border-glow: rgba(96,165,250,0.35);
        --primary:     #60a5fa;
        --primary-d:   #3b82f6;
        --accent:      #a78bfa;
        --gold:        #fbbf24;
        --cyan:        #22d3ee;
        --green:       #34d399;
        --text:        #e2e8f0;
        --text-muted:  #94a3b8;
        --text-dim:    #64748b;
      }

      /* ── RESET ───────────────────────────────────────────────── */
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        min-height: 100vh;
        overflow-x: hidden;
      }

      /* ── KEYFRAME ANIMATIONS ─────────────────────────────────── */
      @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50%       { transform: translateY(-8px); }
      }
      @keyframes glow-pulse {
        0%, 100% { box-shadow: 0 0 16px rgba(96,165,250,0.2); }
        50%       { box-shadow: 0 0 36px rgba(96,165,250,0.5); }
      }
      @keyframes shimmer {
        0%   { background-position: -200% center; }
        100% { background-position:  200% center; }
      }
      @keyframes fade-up {
        from { opacity: 0; transform: translateY(28px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @keyframes spin-slow {
        from { transform: rotate(0deg); }
        to   { transform: rotate(360deg); }
      }
      @keyframes badge-in {
        from { opacity: 0; transform: scale(0.85) translateY(-6px); }
        to   { opacity: 1; transform: scale(1) translateY(0); }
      }

      /* ── SCROLL REVEAL ───────────────────────────────────────── */
      .reveal {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.6s cubic-bezier(.22,1,.36,1),
                    transform 0.6s cubic-bezier(.22,1,.36,1);
      }
      .reveal.visible { opacity: 1; transform: none; }

      /* ── TOUCH ACTIVE STATES (mobile) ────────────────────────── */
      @media (hover: none) {
        .hero-btn:active, .hero-btn-outline:active {
          transform: scale(0.95); opacity: 0.8;
        }
        .kat-card:active, .review-card:active,
        .cta-card:active, .review-item:active {
          background: rgba(96,165,250,0.08) !important;
          border-color: rgba(96,165,250,0.35) !important;
          transform: scale(0.982);
        }
        .filter-btn:active {
          background: rgba(96,165,250,0.18) !important;
          color: #60a5fa !important;
        }
      }

      /* ── GLOBAL CARD OVERRIDES ───────────────────────────────── */
      .stat-card, .kat-card, .review-card, .cta-card,
      .about-card, .stat-box, .metod-item, .tool-card,
      .filters, .filter-card, .badge-card {
        background: var(--bg-card) !important;
        border-color: var(--border) !important;
        color: var(--text) !important;
      }
      .stat-card:hover, .kat-card:hover, .review-card:hover,
      .cta-card:hover, .tool-card:hover {
        background: var(--bg-card-h) !important;
        border-color: var(--border-glow) !important;
        box-shadow: 0 0 28px rgba(96,165,250,0.12) !important;
      }
      .card-desc, .kat-count, .cta-desc, .about-card p,
      .kat-desc, .metod-isi, .tool-desc, .stat-label { color: var(--text-muted) !important; }
      .stat-angka, .stat-num { color: var(--primary) !important; }
      .card-price { color: var(--green) !important; }
      .card-rating { background: rgba(251,191,36,0.15) !important; color: var(--gold) !important; }
      .section-title { color: var(--text) !important; }
      .section-link { color: var(--primary) !important; }
      .kat-range { color: var(--cyan) !important; }
      .kat-nama, .tool-title, .metod-judul, .card-name { color: var(--text) !important; }
      .metod-nomor { color: rgba(167,139,250,0.3) !important; }
      .kat-jumlah { background: rgba(96,165,250,0.12) !important; color: var(--primary) !important; }

      /* ── FORMS ───────────────────────────────────────────────── */
      select, input[type=text], input[type=search], input[type=number] {
        background: rgba(255,255,255,0.06) !important;
        color: var(--text) !important;
        border-color: var(--border) !important;
      }
      select option { background: #0a0a1e; color: var(--text); }

      /* ── TABLES ──────────────────────────────────────────────── */
      table { border-color: var(--border) !important; }
      th { background: rgba(255,255,255,0.06) !important; color: var(--text-muted) !important; }
      td { color: var(--text) !important; border-color: var(--border) !important; }
      tr:hover td { background: rgba(255,255,255,0.04) !important; }

      /* ── PAGE HERO ───────────────────────────────────────────── */
      .page-hero {
        background: linear-gradient(135deg,rgba(91,33,182,0.5),rgba(29,78,216,0.5),rgba(6,182,212,0.3)) !important;
        border: 1px solid rgba(96,165,250,0.2);
        position: relative; overflow: hidden;
      }
      .page-hero::before {
        content: ""; position: absolute; inset: 0; pointer-events: none;
        background: radial-gradient(ellipse at 80% 50%,rgba(167,139,250,0.15),transparent 60%);
      }
      .page-hero h1, .page-hero p { position: relative; z-index: 1; }

      /* ── SCROLLBAR ───────────────────────────────────────────── */
      ::-webkit-scrollbar { width: 5px; height: 5px; }
      ::-webkit-scrollbar-track { background: var(--bg); }
      ::-webkit-scrollbar-thumb { background: rgba(96,165,250,0.3); border-radius: 3px; }
      ::-webkit-scrollbar-thumb:hover { background: rgba(96,165,250,0.6); }

      a { color: var(--primary); }

      /* ── LIGHT MODE VARIABLES ────────────────────────────── */
      html[data-theme="light"] {
        --bg:          #f0f4ff;
        --bg-surface:  #e8edf8;
        --bg-card:     rgba(0,0,0,0.04);
        --bg-card-h:   rgba(0,0,0,0.07);
        --border:      rgba(0,0,0,0.09);
        --border-glow: rgba(37,99,235,0.4);
        --primary:     #2563eb;
        --primary-d:   #1d4ed8;
        --accent:      #7c3aed;
        --gold:        #d97706;
        --cyan:        #0891b2;
        --green:       #059669;
        --text:        #1e293b;
        --text-muted:  #475569;
        --text-dim:    #94a3b8;
      }
      html[data-theme="light"] body { background: var(--bg); color: var(--text); }
      html[data-theme="light"] #starfield-canvas { display: none !important; }
      html[data-theme="light"] nav {
        background: rgba(240,244,255,0.92) !important;
        border-bottom-color: rgba(37,99,235,0.15) !important;
      }
      html[data-theme="light"] .nav-links {
        background: rgba(240,244,255,0.97) !important;
        border-left-color: rgba(37,99,235,0.1) !important;
      }
      html[data-theme="light"] select option { background: #e8edf8; }
      html[data-theme="light"] th {
        background: rgba(0,0,0,0.05) !important;
      }
      html[data-theme="light"] .page-hero {
        background: linear-gradient(135deg,rgba(91,33,182,0.12),rgba(29,78,216,0.12),rgba(6,182,212,0.08)) !important;
        border-color: rgba(37,99,235,0.12) !important;
      }
      html[data-theme="light"] footer {
        background: rgba(220,230,255,0.95) !important;
        border-top-color: rgba(37,99,235,0.1) !important;
      }
      html[data-theme="light"] ::-webkit-scrollbar-track { background: var(--bg); }
      html[data-theme="light"] ::-webkit-scrollbar-thumb { background: rgba(37,99,235,0.25); }

      /* ── THEME TRANSITION OVERLAY ────────────────────────── */
      #theme-overlay {
        position: fixed; inset: 0; z-index: 9999;
        pointer-events: none; opacity: 0;
      }
      @keyframes sunrise-anim {
        0%   { opacity: 0; background: radial-gradient(ellipse 160% 80% at 50% 115%, #ff9500 0%, #ff5500 25%, #2a1540 55%, #050510 100%); }
        25%  { opacity: 1; }
        70%  { opacity: 0.9; background: radial-gradient(ellipse 160% 80% at 50% 88%, #ffe066 0%, #ffb347 30%, #93c5fd 65%, #e8f0ff 100%); }
        100% { opacity: 0; }
      }
      @keyframes sunset-anim {
        0%   { opacity: 0; background: radial-gradient(ellipse 160% 80% at 50% 88%, #ffe066 0%, #ff7043 25%, #6a1a7a 55%, #050510 100%); }
        25%  { opacity: 1; }
        70%  { opacity: 0.9; background: radial-gradient(ellipse 160% 80% at 50% 115%, #ff4500 0%, #8b008b 30%, #1a0a2e 65%, #050510 100%); }
        100% { opacity: 0; }
      }
    </style>

    <style>
      /* ── NAVBAR ──────────────────────────────────────────────── */
      nav {
        background: rgba(5,5,16,0.9);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(96,165,250,0.18);
        padding: 0 20px;
        position: sticky; top: 0; z-index: 300;
      }
      .nav-inner {
        max-width: 1100px; margin: 0 auto;
        display: flex; align-items: center;
        justify-content: space-between; height: 58px;
      }
      .nav-logo {
        font-size: 1.2rem; font-weight: 700;
        color: var(--primary); text-decoration: none;
        letter-spacing: 0.02em;
        text-shadow: 0 0 24px rgba(96,165,250,0.6);
        transition: text-shadow 0.3s; z-index: 2;
      }
      .nav-logo:hover { text-shadow: 0 0 36px rgba(96,165,250,0.9); }

      /* Desktop links */
      .nav-links {
        display: flex; gap: 4px; list-style: none;
      }
      .nav-links a {
        text-decoration: none; color: var(--text-muted);
        font-size: 0.875rem; padding: 6px 13px;
        border-radius: 20px; border: 1px solid transparent;
        transition: all 0.2s;
      }
      .nav-links a:hover {
        color: var(--primary);
        border-color: rgba(96,165,250,0.3);
        background: rgba(96,165,250,0.08);
      }

      /* Theme toggle button */
      .theme-toggle {
        background: rgba(251,191,36,0.12);
        border: 1.5px solid rgba(251,191,36,0.45);
        border-radius: 50%;
        width: 42px; height: 42px;
        cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        color: #fbbf24;
        transition: all 0.25s;
        flex-shrink: 0; margin-right: 8px; padding: 0;
        box-shadow: 0 0 12px rgba(251,191,36,0.25), inset 0 0 8px rgba(251,191,36,0.08);
        animation: sun-pulse 2.8s ease-in-out infinite;
      }
      @keyframes sun-pulse {
        0%, 100% { box-shadow: 0 0 10px rgba(251,191,36,0.25), inset 0 0 8px rgba(251,191,36,0.08); }
        50%       { box-shadow: 0 0 22px rgba(251,191,36,0.55), inset 0 0 12px rgba(251,191,36,0.15); }
      }
      .theme-toggle:hover {
        background: rgba(251,191,36,0.22);
        border-color: rgba(251,191,36,0.8);
        color: #fde68a;
        transform: scale(1.1) rotate(20deg);
        box-shadow: 0 0 28px rgba(251,191,36,0.6);
      }
      /* Light mode: tombol jadi biru bulan */
      html[data-theme="light"] .theme-toggle {
        background: rgba(37,99,235,0.1);
        border-color: rgba(37,99,235,0.35);
        color: #2563eb;
        box-shadow: 0 0 12px rgba(37,99,235,0.15);
        animation: none;
      }
      html[data-theme="light"] .theme-toggle:hover {
        background: rgba(37,99,235,0.18);
        border-color: rgba(37,99,235,0.7);
        color: #1d4ed8;
        transform: scale(1.1);
        box-shadow: 0 0 20px rgba(37,99,235,0.35);
      }
      html:not([data-theme="light"]) .icon-moon { display: none; }
      html[data-theme="light"] .icon-sun { display: none; }

      /* Hamburger button */
      .nav-toggle {
        display: none;
        background: none; border: none;
        cursor: pointer; padding: 8px;
        z-index: 302;
      }
      .nav-toggle span {
        display: block; width: 22px; height: 2px;
        background: var(--text-muted);
        border-radius: 2px; transition: all 0.3s;
        position: relative;
      }
      .nav-toggle span::before,
      .nav-toggle span::after {
        content: ""; position: absolute; left: 0;
        width: 22px; height: 2px;
        background: var(--text-muted); border-radius: 2px;
        transition: all 0.3s;
      }
      .nav-toggle span::before { top: -7px; }
      .nav-toggle span::after  { top:  7px; }
      /* Open state */
      .nav-toggle.open span    { background: transparent; }
      .nav-toggle.open span::before { transform: rotate(45deg); top: 0; }
      .nav-toggle.open span::after  { transform: rotate(-45deg); top: 0; }

      /* Mobile nav drawer */
      @media (max-width: 640px) {
        .nav-toggle { display: flex; align-items: center; }
        .nav-links {
          position: fixed; inset: 0; top: 58px;
          flex-direction: column; gap: 0;
          background: rgba(5,5,16,0.97);
          backdrop-filter: blur(24px);
          padding: 20px 24px;
          transform: translateX(100%);
          transition: transform 0.32s cubic-bezier(.22,1,.36,1);
          z-index: 301; border-left: 1px solid rgba(96,165,250,0.15);
        }
        .nav-links.open { transform: translateX(0); }
        .nav-links li { border-bottom: 1px solid rgba(255,255,255,0.05); }
        .nav-links a {
          display: block; padding: 16px 8px;
          font-size: 1.05rem; border-radius: 0;
          border: none; color: var(--text-muted);
        }
        .nav-links a:active { color: var(--primary); }
      }

      /* ── MAIN ────────────────────────────────────────────────── */
      main {
        max-width: 1100px; margin: 0 auto;
        padding: 28px 20px;
        position: relative; z-index: 1;
      }
      @media (max-width: 480px) {
        main { padding: 20px 14px; }
      }

      /* ── FOOTER ──────────────────────────────────────────────── */
      footer {
        background: rgba(5,5,16,0.95);
        border-top: 1px solid rgba(96,165,250,0.1);
        color: var(--text-dim);
        text-align: center;
        padding: 28px 20px;
        margin-top: 64px;
        font-size: 0.82rem;
        position: relative; z-index: 1;
      }
      footer a { color: var(--primary); text-decoration: none; }
      .footer-stars {
        font-size: 1.1rem; letter-spacing: 0.3em;
        display: block; margin-bottom: 8px; opacity: 0.5;
      }
      .nasa-badge {
        display: inline-flex; align-items: center;
        gap: 5px; font-size: 0.7rem;
        color: var(--text-dim); margin-top: 6px; opacity: 0.6;
      }
    </style>
  </head>
  <body>

    <div id="theme-overlay"></div>

    <nav>
      <div class="nav-inner">
        <a href="/" class="nav-logo">🚀 AstroLaptop</a>
        <button class="theme-toggle" id="themeToggle" aria-label="Toggle tema">
          <!-- Sun: tampil saat dark mode -->
          <svg class="icon-sun" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <!-- Moon: tampil saat light mode -->
          <svg class="icon-moon" width="19" height="19" viewBox="0 0 24 24" fill="currentColor">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
        <button class="nav-toggle" id="navToggle" aria-label="Menu">
          <span></span>
        </button>
        <ul class="nav-links" id="navLinks">
          <li><a href="/" onclick="closeNav()">Home</a></li>
          <li><a href="/review" onclick="closeNav()">Review</a></li>
          <li><a href="/rekomendasi" onclick="closeNav()">Temukan Laptop</a></li>
          <li><a href="/compare" onclick="closeNav()">Perbandingan</a></li>
          <li><a href="/h2h" onclick="closeNav()">H2H</a></li>
          <li><a href="/tentang" onclick="closeNav()">Tentang</a></li>
        </ul>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <span class="footer-stars">✦ ✦ ✦ ✦ ✦</span>
      <p>© 2025 AstroLaptop · Review laptop jujur untuk semua kalangan</p>
      <div class="nasa-badge">🌌 Space visuals terinspirasi NASA APOD</div>
    </footer>

    <script>
      /* ── HAMBURGER MENU ──────────────────────────────────────── */
      const toggle = document.getElementById("navToggle");
      const links  = document.getElementById("navLinks");
      toggle.addEventListener("click", () => {
        toggle.classList.toggle("open");
        links.classList.toggle("open");
        document.body.style.overflow = links.classList.contains("open") ? "hidden" : "";
      });
      function closeNav() {
        toggle.classList.remove("open");
        links.classList.remove("open");
        document.body.style.overflow = "";
      }
      // Close on outside tap
      document.addEventListener("click", (e) => {
        if (!toggle.contains(e.target) && !links.contains(e.target)) closeNav();
      });

      /* ── SCROLL REVEAL ───────────────────────────────────────── */
      (function () {
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("visible");
              obs.unobserve(e.target);
            }
          });
        }, { threshold: 0.07, rootMargin: "0px 0px -30px 0px" });

        document.querySelectorAll(".reveal").forEach((el) => {
          const parent = el.parentElement;
          const siblings = parent ? [...parent.querySelectorAll(".reveal")] : [];
          const idx = siblings.indexOf(el);
          if (idx > 0) el.style.transitionDelay = `${Math.min(idx * 0.09, 0.45)}s`;
          obs.observe(el);
        });

        /* Stats counter */
        document.querySelectorAll(".stat-angka").forEach((el) => {
          const raw = el.textContent.trim();
          const num = parseInt(raw);
          if (isNaN(num) || String(num) !== raw) return;
          const co = new IntersectionObserver((entries) => {
            if (!entries[0].isIntersecting) return;
            co.disconnect();
            const dur = 1100; let start = null;
            (function step(ts) {
              if (!start) start = ts;
              const p = Math.min((ts - start) / dur, 1);
              const ease = 1 - Math.pow(1 - p, 3);
              el.textContent = Math.round(ease * num);
              if (p < 1) requestAnimationFrame(step);
            })(performance.now());
          }, { threshold: 0.6 });
          co.observe(el);
        });
      })();
    </script>

    <script>
      /* ── STARFIELD CANVAS ──────────────────────────────────── */
      (function () {
        const isMobile = window.innerWidth < 640;
        const canvas = document.createElement("canvas");
        canvas.id = "starfield-canvas";
        canvas.style.cssText =
          "position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;pointer-events:none;";
        document.body.insertBefore(canvas, document.body.firstChild);
        const ctx = canvas.getContext("2d");
        let W, H, stars = [];
        const COLS = [[255,255,255],[147,197,253],[196,181,253],[253,230,138],[167,243,208]];

        function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }

        function initStars() {
          stars = [];
          const tiny = isMobile ? 200 : 500;
          const med  = isMobile ? 40  : 100;
          const big  = isMobile ? 8   : 18;
          for (let i = 0; i < tiny; i++) {
            stars.push({ x:Math.random()*W, y:Math.random()*H, r:Math.random()*0.6+0.2,
              base:Math.random()*0.5+0.1, phase:Math.random()*Math.PI*2,
              spd:Math.random()*0.6+0.2, c:COLS[0], glow:false });
          }
          for (let i = 0; i < med; i++) {
            const c = COLS[Math.floor(Math.random()*COLS.length)];
            stars.push({ x:Math.random()*W, y:Math.random()*H, r:Math.random()*1.0+0.6,
              base:Math.random()*0.6+0.2, phase:Math.random()*Math.PI*2,
              spd:Math.random()*0.4+0.1, c, glow:false });
          }
          for (let i = 0; i < big; i++) {
            const c = COLS[Math.floor(Math.random()*COLS.length)];
            stars.push({ x:Math.random()*W, y:Math.random()*H, r:Math.random()*1.4+1.2,
              base:0.85, phase:Math.random()*Math.PI*2, spd:Math.random()*0.2+0.05, c, glow:true });
          }
        }

        const NEB = [
          { cx:0.15,cy:0.25,rx:0.45,ry:0.3, rgb:"91,33,182", a:0.055 },
          { cx:0.85,cy:0.75,rx:0.40,ry:0.35,rgb:"29,78,216", a:0.06  },
          { cx:0.55,cy:0.15,rx:0.30,ry:0.25,rgb:"6,182,212", a:0.04  },
          { cx:0.05,cy:0.85,rx:0.28,ry:0.22,rgb:"124,58,237",a:0.035 },
          { cx:0.75,cy:0.35,rx:0.22,ry:0.2, rgb:"220,38,38", a:0.025 },
        ];

        function drawNeb() {
          NEB.forEach(({cx,cy,rx,ry,rgb,a}) => {
            const gx = ctx.createRadialGradient(cx*W,cy*H,0,cx*W,cy*H,Math.max(rx*W,ry*H));
            gx.addColorStop(0,  `rgba(${rgb},${a})`);
            gx.addColorStop(0.5,`rgba(${rgb},${a*0.4})`);
            gx.addColorStop(1,  "transparent");
            ctx.fillStyle = gx;
            ctx.fillRect(0,0,W,H);
          });
        }

        function draw() {
          ctx.clearRect(0,0,W,H);
          drawNeb();
          for (const s of stars) {
            s.phase += s.spd * 0.008;
            const op = s.base*(0.5+0.5*Math.sin(s.phase));
            const [r,g,b] = s.c;
            if (s.glow) {
              const gl = ctx.createRadialGradient(s.x,s.y,0,s.x,s.y,s.r*5);
              gl.addColorStop(0,`rgba(${r},${g},${b},${op*0.6})`);
              gl.addColorStop(1,"transparent");
              ctx.fillStyle=gl; ctx.beginPath();
              ctx.arc(s.x,s.y,s.r*5,0,Math.PI*2); ctx.fill();
            }
            ctx.beginPath(); ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
            ctx.fillStyle=`rgba(${r},${g},${b},${op})`; ctx.fill();
          }
          requestAnimationFrame(draw);
        }

        window.addEventListener("resize",()=>{ resize(); initStars(); });
        resize(); initStars(); draw();
      })();
    </script>

    <script>
      /* ── LIGHT / DARK MODE TOGGLE ────────────────────────── */
      (function () {
        const root    = document.documentElement;
        const btn     = document.getElementById('themeToggle');
        const overlay = document.getElementById('theme-overlay');
        if (!btn || !overlay) return;

        function applyTheme(theme) {
          if (theme === 'light') {
            root.setAttribute('data-theme', 'light');
          } else {
            root.removeAttribute('data-theme');
          }
          localStorage.setItem('theme', theme);
        }

        btn.addEventListener('click', () => {
          const isLight = root.getAttribute('data-theme') === 'light';
          const going   = isLight ? 'dark' : 'light';

          /* Reset & trigger overlay animation */
          overlay.style.animation = 'none';
          void overlay.offsetHeight; /* force reflow */
          overlay.style.animation = (isLight ? 'sunset-anim' : 'sunrise-anim') + ' 0.85s ease-in-out forwards';

          /* Switch theme at animation midpoint */
          setTimeout(() => applyTheme(going), 280);
        });

        overlay.addEventListener('animationend', () => {
          overlay.style.animation = 'none';
        });
      })();
    </script>
  </body>
</html>
