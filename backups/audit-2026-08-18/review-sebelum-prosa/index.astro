---

<BaseLayout title="Review Laptop" description="Semua review laptop jujur dari AstroLaptop">
  <style>
    .page-header {
      margin-bottom: 32px;
      background:
        linear-gradient(135deg, rgba(8,5,18,0.92) 0%, rgba(14,8,28,0.82) 40%, rgba(6,4,16,0.90) 100%),
        url('/planet-merkuri.jpg') center/cover no-repeat;
      border: 1px solid rgba(167,139,250,0.25);
      border-radius: 16px; padding: 48px 40px; position: relative; overflow: hidden;
      box-shadow: 0 0 60px rgba(167,139,250,0.10);
    }
    .page-header::before {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background:
        radial-gradient(ellipse at 40% 50%, rgba(167,139,250,0.18) 0%, transparent 55%),
        radial-gradient(ellipse at 80% 25%, rgba(251,191,36,0.10) 0%, transparent 45%);
    }
    .page-header h1 {
      font-size: 2rem; font-weight: 800; color: #e2e8f0; margin-bottom: 8px;
      position: relative; z-index: 1;
      text-shadow: 0 0 32px rgba(167,139,250,0.65);
    }
    .page-header p { color: rgba(255,255,255,0.7); position: relative; z-index: 1; }

    .search-bar { margin-bottom: 16px; }
    #review-search {
      width: 100%; padding: 10px 16px; font-size: 0.95rem;
      border: 1px solid rgba(255,255,255,0.1); border-radius: 10px;
      background: rgba(255,255,255,0.05); color: #e2e8f0;
      box-sizing: border-box; outline: none;
    }
    #review-search:focus { border-color: rgba(96,165,250,0.5); }
    #review-search::placeholder { color: #475569; }

    .filter-bar { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; }
    .filter-btn {
      padding: 8px 18px; border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.04);
      font-size: 0.875rem; cursor: pointer; color: #94a3b8; transition: all 0.2s;
      text-decoration: none; display: inline-block;
    }
    .filter-btn:hover, .filter-btn.active {
      background: rgba(96,165,250,0.15); color: #60a5fa; border-color: rgba(96,165,250,0.4);
    }

    .review-list { display: grid; gap: 20px; }
    .review-item {
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.09);
      border-radius: 12px; padding: 16px 20px;
      display: grid; grid-template-columns: 1fr auto;
      gap: 18px; align-items: center;
      text-decoration: none; color: inherit; transition: all 0.25s;
    }
    @media (max-width: 768px) {
      .review-item { grid-template-columns: 1fr; }
      .item-right { text-align: left; display: flex; gap: 12px; align-items: center; }
    }
    .review-item:hover {
      border-color: rgba(96,165,250,0.35); transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(96,165,250,0.08);
    }
    .item-meta { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; flex-wrap: wrap; }
    .badge { background: rgba(96,165,250,0.12); color: #60a5fa; font-size: 0.75rem; font-weight: 600; padding: 3px 10px; border-radius: 20px; }
    .badge-gaming { background: rgba(251,191,36,0.12); color: #fbbf24; }
    .badge-highgaming { background: rgba(167,139,250,0.15); color: #a78bfa; }
    .item-date { font-size: 0.8rem; color: #475569; }
    .item-title { font-size: 1.15rem; font-weight: 700; color: var(--text); margin-bottom: 4px; }
    .item-model { font-size: 0.8rem; color: #475569; margin-bottom: 8px; }
    .item-desc { font-size: 0.875rem; color: #64748b; margin-bottom: 12px; }
    .item-tags { display: flex; gap: 6px; flex-wrap: wrap; }
    .tag { background: rgba(255,255,255,0.06); color: #64748b; font-size: 0.75rem; padding: 3px 8px; border-radius: 6px; }
    .item-right { text-align: right; min-width: 120px; }
    .item-price { font-size: 1.1rem; font-weight: 700; color: #34d399; margin-bottom: 8px; }
    .item-rating { background: rgba(251,191,36,0.12); color: #fbbf24; font-size: 0.85rem; font-weight: 700; padding: 6px 12px; border-radius: 20px; display: inline-block; }
    .total-count { color: #64748b; font-size: 0.9rem; margin-bottom: 16px; }

    /* ── LIGHT MODE ─────────────────────────────────────────── */
    :global(html[data-theme="light"]) .page-header {
      background: linear-gradient(135deg,rgba(91,33,182,0.1),rgba(29,78,216,0.1),rgba(6,182,212,0.06)) !important;
    }
    :global(html[data-theme="light"]) .page-header h1 { color: #1e293b; text-shadow: none; }
    :global(html[data-theme="light"]) .page-header p { color: #475569; }
    :global(html[data-theme="light"]) #review-search {
      background: rgba(255,255,255,0.9); border-color: rgba(0,0,0,0.14); color: #1e293b;
    }
    :global(html[data-theme="light"]) #review-search:focus { border-color: rgba(37,99,235,0.5); }
    :global(html[data-theme="light"]) .filter-btn {
      background: rgba(0,0,0,0.04); border-color: rgba(0,0,0,0.12); color: #475569;
    }
    :global(html[data-theme="light"]) .filter-btn:hover,
    :global(html[data-theme="light"]) .filter-btn.active {
      background: rgba(37,99,235,0.1); color: #2563eb; border-color: rgba(37,99,235,0.35);
    }
    :global(html[data-theme="light"]) .review-item {
      background: rgba(255,255,255,0.88); border-color: rgba(0,0,0,0.09);
    }
    :global(html[data-theme="light"]) .review-item:hover {
      border-color: rgba(37,99,235,0.3); box-shadow: 0 8px 24px rgba(37,99,235,0.08);
    }
    :global(html[data-theme="light"]) .item-title { color: #1e293b; }
    :global(html[data-theme="light"]) .item-desc  { color: #64748b; }
    :global(html[data-theme="light"]) .tag { background: rgba(0,0,0,0.05); color: #64748b; }
  </style>

  <div class="page-header">
    <h1>📋 Semua Review Laptop</h1>
    <p>Review jujur berdasarkan pengujian langsung, bukan sekadar spesifikasi kertas.</p>
  </div>

  <!-- SEARCH -->
  <div class="search-bar">
    <input type="text" id="review-search" placeholder="Cari nama laptop, CPU, merk..." autocomplete="off" />
  </div>

  <!-- FILTER KATEGORI -->
  <div class="filter-bar">
    {kategoris.map((k) => (
      <a href="#" class={`filter-btn ${k === "Semua" ? "active" : ""}`}>{k}</a>
    ))}
  </div>

  <p class="total-count">{reviews.length} review tersedia</p>

  <!-- DAFTAR REVIEW -->
  <div class="review-list">
    {reviews.map((laptop) => (
      <a href={`/review/${laptop.slug}`} class="review-item" data-kategori={laptop.kategori} style={`border-left: 3px solid ${katColor[laptop.kategori] ?? '#60a5fa'}`}>
        <div class="item-left">
          <div class="item-meta">
            <span class={`badge ${laptop.kategori === "Gaming" ? "badge-gaming" : laptop.kategori === "High Gaming" ? "badge-highgaming" : ""}`}>
              {laptop.kategori}
            </span>
            <span class="item-date">{laptop.tanggal}</span>
          </div>
          <div class="item-title">{laptop.nama}</div>
          <div class="item-model">{laptop.model}</div>
          <div class="item-desc">{laptop.ringkasan}</div>
          <div class="item-tags">
            {laptop.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>

        <div class="item-right">
          <div class="item-price">{laptop.harga}</div>
          <div class="item-rating">⭐ {laptop.rating}/5</div>
        </div>
      </a>
    ))}
  </div>

  <script>
    const btns = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.review-item');
    const countEl = document.querySelector('.total-count');
    const searchInput = document.getElementById('review-search');
    let activeKategori = 'Semua';

    function applyFilter() {
      const q = searchInput.value.toLowerCase().trim();
      let visible = 0;
      items.forEach(item => {
        const kat = item.dataset.kategori;
        const text = item.textContent.toLowerCase();
        const matchKat = activeKategori === 'Semua' || kat === activeKategori;
        const matchSearch = !q || text.includes(q);
        const show = matchKat && matchSearch;
        item.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      countEl.textContent = `${visible} review tersedia`;
    }

    btns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        activeKategori = btn.textContent.trim();
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyFilter();
      });
    });

    searchInput.addEventListener('input', applyFilter);
  </script>

</BaseLayout>
