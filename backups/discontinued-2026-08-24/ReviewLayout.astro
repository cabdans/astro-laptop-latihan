---
export interface Props {
  title: string;
  harga: string;
  rating: number;
  kategori: string;
  tanggal: string;
  ringkasan: string;
  /* Link afiliasi. Opsional — kalau tidak diisi, tombol tetap tampil
     dengan href="#" seperti sebelumnya, jadi 65 halaman review lain
     tidak terpengaruh sama sekali. */
  linkTokopedia?: string;
  linkShopee?: string;
  /* Penanda kapan data terakhir diperiksa ulang. Opsional — badge hanya
     muncul di halaman yang mengisinya. */
  update?: string;
  hargaUpdate?: string;
  /* Penanda unit langka / sulit dicari stoknya di pasar. */
  rare?: boolean;
  /* Override "Ringkasan Cepat" untuk kasus khusus. Kalau tidak diisi,
     isinya diturunkan otomatis dari kategori laptop. */
  cocokUntuk?: string[];
  kurangUntuk?: string[];
}

const { title, harga, rating, kategori, tanggal, ringkasan, linkTokopedia, linkShopee, update, hargaUpdate, rare, cocokUntuk, kurangUntuk } = Astro.props;

/* ── RINGKASAN CEPAT ──
   Sebelumnya dua kalimat ini hardcoded sama untuk semua 89 halaman, jadi
   laptop gaming pun tertulis "tidak ideal untuk gaming berat". Sekarang
   diturunkan dari kategori — data yang sudah ada, jadi tidak ada angka
   atau spesifikasi apa pun yang diubah. Halaman tertentu bisa menimpanya
   lewat prop cocokUntuk / kurangUntuk. */
const RINGKAS_KATEGORI: Record<string, { cocok: string[]; kurang: string[] }> = {
  'Budget': {
    cocok:  ['Tugas kuliah, Office, dan browsing harian', 'Pemakaian pertama dengan dana terbatas'],
    kurang: ['Gaming AAA dan rendering berat', 'Multitasking aplikasi berat sekaligus'],
  },
  'Produktivitas': {
    cocok:  ['Multitasking kerja dan kuliah seharian', 'Office, data, dan editing ringan'],
    kurang: ['Gaming AAA di setelan tinggi', 'Rendering 3D yang butuh GPU dedicated'],
  },
  'Gaming': {
    cocok:  ['Gaming 1080p di setelan medium ke tinggi', 'Editing video dan streaming'],
    kurang: ['Dipakai jauh dari colokan', 'Dibawa bepergian tiap hari karena bobotnya'],
  },
  'High Gaming': {
    cocok:  ['Gaming AAA 1440p dan e-sport high refresh', 'Rendering, 3D, dan beban kerja berat'],
    kurang: ['Mobilitas tinggi karena bobot dan charger besar', 'Pemakaian baterai tanpa adaptor'],
  },
  'Ultrabook': {
    cocok:  ['Dibawa bepergian, tipis dan ringan', 'Kerja mobile dengan baterai panjang'],
    kurang: ['Gaming berat dan rendering lama', 'Upgrade komponen di kemudian hari'],
  },
};
const dasar = RINGKAS_KATEGORI[kategori] ?? RINGKAS_KATEGORI['Produktivitas'];
const ringkas = {
  cocok:  cocokUntuk  ?? dasar.cocok,
  kurang: kurangUntuk ?? dasar.kurang,
};

/* Kalau ada link afiliasi, buka di tab baru dengan rel yang aman.
   Kalau kosong, perilaku lama dipertahankan (href="#", tanpa target). */
const tokoHref = linkTokopedia || '#';
const shopHref = linkShopee || '#';
const tokoExt = Boolean(linkTokopedia);
const shopExt = Boolean(linkShopee);

const bintang = Math.round(rating);

// Gambar hero per kategori
// FIX: '/nasa-galaxy.jpg' & '/nasa-nebula.jpg' adalah file 0-byte (rusak) sehingga
// hero 30 dari 39 halaman review kosong. Dialihkan ke aset valid yang ada di /public.
const heroBg: Record<string, string> = {
  'Budget':      '/nasa-earth-night.jpg',
  'Produktivitas': '/nasa-milkyway.jpg',
  'Gaming':      '/nasa-lagoon.jpg',
  'High Gaming': '/nasa-ngc248.jpg',
  'Ultrabook':   '/nasa-helix.jpg',
};
const bg = heroBg[kategori] ?? '/nasa-milkyway.jpg';

// Warna badge per kategori
const badgeColor: Record<string, string> = {
  'Budget':       '#16a34a',
  'Produktivitas':'#2563eb',
  'Gaming':       '#b45309',
  'High Gaming':  '#9333ea',
  'Ultrabook':    '#0891b2',
};
const bColor = badgeColor[kategori] ?? '#2563eb';
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={ringkasan} />
    <title>Review {title} — AstroLaptop</title>
    <script is:inline>
      /* Terapkan tema tersimpan sebelum paint: cegah flash, samakan dgn halaman lain */
      (function(){
        if(localStorage.getItem('theme')==='light')
          document.documentElement.setAttribute('data-theme','light');
      })();
    </script>
    <style>
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Segoe UI', system-ui, sans-serif;
        background: #02020e;
        color: #e2e8f0;
        line-height: 1.7;
        min-height: 100vh;
      }

      /* ── NAV ── */
      nav {
        background: rgba(2,2,14,0.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(96,165,250,0.15);
        padding: 0 24px;
        position: sticky;
        top: 0;
        z-index: 100;
      }
      .nav-inner {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 60px;
      }
      .nav-logo {
        font-size: 1.2rem;
        font-weight: 800;
        color: #60a5fa;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .nav-links { display: flex; gap: 20px; list-style: none; }
      .nav-links a {
        text-decoration: none;
        color: #94a3b8;
        font-size: 0.92rem;
        transition: color 0.2s;
      }
      .nav-links a:hover { color: #e2e8f0; }

      /* ── HERO BANNER ── */
      .review-hero {
        position: relative;
        height: 280px;
        overflow: hidden;
        display: flex;
        align-items: flex-end;
      }
      .review-hero-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        filter: brightness(0.45) saturate(1.2);
      }
      .review-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to top,
          rgba(2,2,14,1) 0%,
          rgba(2,2,14,0.6) 50%,
          rgba(2,2,14,0.1) 100%
        );
      }
      .review-hero-content {
        position: relative;
        z-index: 2;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 24px 32px;
        width: 100%;
      }
      .badge {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 4px 14px;
        border-radius: 20px;
        margin-bottom: 10px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: white;
      }
      /* Penanda kapan data terakhir diperiksa ulang */
      .badge-update {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 4px 13px;
        border-radius: 20px;
        margin-bottom: 10px;
        margin-left: 8px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #34d399;
        background: rgba(52,211,153,0.14);
        border: 1px solid rgba(52,211,153,0.45);
        backdrop-filter: blur(4px);
      }
      /* Penanda periode harga yang dipakai di halaman ini */
      .badge-harga {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 4px 13px;
        border-radius: 20px;
        margin-bottom: 10px;
        margin-left: 8px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #fbbf24;
        background: rgba(251,191,36,0.14);
        border: 1px solid rgba(251,191,36,0.45);
        backdrop-filter: blur(4px);
      }
      /* Penanda unit langka — ungu, supaya beda dari badge update dan harga */
      .badge-rare {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 4px 13px;
        border-radius: 20px;
        margin-bottom: 10px;
        margin-left: 8px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #c4b5fd;
        background: rgba(167,139,250,0.16);
        border: 1px solid rgba(167,139,250,0.5);
        backdrop-filter: blur(4px);
      }
      .review-hero-content h1 {
        font-size: 1.9rem;
        font-weight: 800;
        line-height: 1.2;
        color: #f1f5f9;
        text-shadow: 0 2px 20px rgba(0,0,0,0.8);
        margin-bottom: 6px;
      }
      .meta { font-size: 0.82rem; color: #94a3b8; }

      /* ── LAYOUT ── */
      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 32px 24px 64px;
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 32px;
      }
      @media (max-width: 768px) {
        .container { grid-template-columns: 1fr; }
        .review-hero { height: 200px; }
        .review-hero-content h1 { font-size: 1.4rem; }
      }

      /* ── RINGKASAN ── */
      .ringkasan {
        font-size: 1rem;
        color: #cbd5e1;
        background: rgba(96,165,250,0.07);
        border-left: 3px solid #3b82f6;
        padding: 14px 18px;
        border-radius: 0 8px 8px 0;
        margin-bottom: 28px;
        line-height: 1.7;
      }

      /* ── RATING ── */
      .rating-box {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 14px;
        padding: 24px;
        text-align: center;
        margin-bottom: 28px;
        backdrop-filter: blur(8px);
      }
      .rating-angka {
        font-size: 3.8rem;
        font-weight: 800;
        color: #60a5fa;
        line-height: 1;
        text-shadow: 0 0 30px rgba(96,165,250,0.4);
      }
      .rating-bintang { font-size: 1.4rem; margin: 8px 0; }
      .rating-label { color: #64748b; font-size: 0.82rem; }

      /* ── ARTIKEL KONTEN ── */
      .artikel-konten h2 {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 28px 0 14px;
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        color: #e2e8f0;
      }
      .artikel-konten p { margin-bottom: 14px; color: #94a3b8; }

      /* ── TABEL SPEK ──
         table-layout: fixed dipakai supaya lebar kolom label selalu tetap.
         Tanpa ini, label panjang seperti "Backlit Keyboard" mendorong dan
         menabrak kolom nilainya. Isi tabel tidak diubah sama sekali —
         seluruh perbaikan di sini murni tampilan. */
      .spek-table {
        width: 100%;
        table-layout: fixed;
        border-collapse: separate;
        border-spacing: 0;
        margin-bottom: 28px;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(96,165,250,0.22);
        box-shadow: 0 4px 16px rgba(0,0,0,0.35);
      }
      .spek-table tr { transition: background 0.15s ease; }
      .spek-table tr:nth-child(even) { background: rgba(96,165,250,0.055); }
      .spek-table tr:nth-child(odd)  { background: rgba(255,255,255,0.012); }
      .spek-table tr:hover { background: rgba(96,165,250,0.13); }
      .spek-table td {
        padding: 12px 18px;
        font-size: 0.9rem;
        vertical-align: top;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        overflow-wrap: anywhere;
      }
      .spek-table tr:last-child td { border-bottom: none; }
      /* Kolom label: lebar tetap, huruf kecil berspasi, garis aksen di kiri */
      .spek-table td:first-child {
        width: 38%;
        font-weight: 700;
        font-size: 0.73rem;
        line-height: 1.5;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #7dd3fc;
        padding-top: 14px;
        border-left: 3px solid rgba(96,165,250,0.55);
        border-right: 1px solid rgba(96,165,250,0.16);
        background: rgba(2,6,23,0.28);
      }
      /* Kolom nilai: lebih besar dan lebih terang supaya jadi fokus baca */
      .spek-table td:last-child {
        color: #f8fafc;
        font-weight: 600;
        font-size: 0.92rem;
        line-height: 1.55;
      }
      @media (max-width: 768px) {
        .spek-table td { padding: 10px 12px; font-size: 0.85rem; }
        .spek-table td:first-child { width: 42%; font-size: 0.68rem; padding-top: 12px; }
        .spek-table td:last-child  { font-size: 0.87rem; }
      }

      /* ── PROS CONS ── */
      .pros-cons {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-bottom: 28px;
      }
      @media (max-width: 500px) { .pros-cons { grid-template-columns: 1fr; } }

      .pros, .cons {
        background: rgba(255,255,255,0.04);
        border-radius: 12px;
        padding: 18px;
        border: 1px solid rgba(255,255,255,0.08);
      }
      .pros { border-top: 3px solid #059669; }
      .cons { border-top: 3px solid #dc2626; }
      .pros h3 { color: #34d399; margin-bottom: 10px; font-size: 0.95rem; }
      .cons h3 { color: #f87171; margin-bottom: 10px; font-size: 0.95rem; }
      .pros ul, .cons ul {
        padding-left: 18px;
        font-size: 0.875rem;
        color: #94a3b8;
      }
      .pros li, .cons li { margin-bottom: 5px; }

      /* ── BENCHMARK OVERRIDES untuk dark theme ── */
      /* Hanya berlaku di dark mode; di light mode, inline styles asli (yang memang
         didesain untuk latar terang) dibiarkan tampil apa adanya. */
      /* Label teks */
      html:not([data-theme="light"]) .artikel-konten [style*="color:#374151"] { color: #cbd5e1 !important; }
      /* Badge score sekunder (abu di light theme) */
      html:not([data-theme="light"]) .artikel-konten [style*="background:#e5e7eb"][style*="padding:2px"] {
        background: rgba(96,165,250,0.15) !important;
        color: #e2e8f0 !important;
        border-color: rgba(96,165,250,0.3) !important;
      }
      /* Track progress bar */
      html:not([data-theme="light"]) .artikel-konten [style*="background:#e5e7eb"][style*="height:6px"] {
        background: rgba(255,255,255,0.1) !important;
      }
      /* Fill progress bar */
      html:not([data-theme="light"]) .artikel-konten [style*="background:#1e3a8a"] {
        background: linear-gradient(90deg, #3b82f6, #60a5fa) !important;
      }
      /* Wrapper benchmark */
      html:not([data-theme="light"]) .artikel-konten [style*="display:grid"][style*="gap:16px"] {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 20px !important;
      }

      /* ── SIDEBAR ── */
      .sidebar { position: sticky; top: 76px; align-self: start; }

      .sidebar-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 16px;
        backdrop-filter: blur(8px);
      }
      .sidebar-card h3 {
        font-size: 0.95rem;
        font-weight: 700;
        margin-bottom: 14px;
        color: #e2e8f0;
      }
      .harga-display {
        font-size: 1.6rem;
        font-weight: 800;
        color: #34d399;
        margin-bottom: 16px;
        line-height: 1.2;
      }
      .btn-beli {
        display: block;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
        text-align: center;
        padding: 13px;
        border-radius: 8px;
        font-weight: 700;
        text-decoration: none;
        font-size: 0.95rem;
        margin-bottom: 10px;
        transition: opacity 0.2s;
        box-shadow: 0 0 20px rgba(59,130,246,0.3);
      }
      .btn-beli:hover { opacity: 0.85; }
      .btn-beli-secondary {
        display: block;
        background: linear-gradient(135deg, #f97316, #ea580c);
        color: white;
        text-align: center;
        padding: 11px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        font-size: 0.875rem;
        transition: opacity 0.2s;
      }
      .btn-beli-secondary:hover { opacity: 0.85; }
      .disclaimer { font-size: 0.72rem; color: #475569; margin-top: 8px; text-align: center; }

      .sidebar-card p { font-size: 0.875rem; color: #94a3b8; line-height: 1.6; }
      /* Baris Ringkasan Cepat: ikon sejajar, teks tidak menabrak ikon */
      .rc-ya, .rc-tidak {
        display: flex;
        gap: 8px;
        align-items: flex-start;
        font-size: 0.85rem;
        line-height: 1.55;
        padding: 7px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
      }
      .sidebar-card .rc-ya:last-child,
      .sidebar-card .rc-tidak:last-child { border-bottom: none; padding-bottom: 0; }
      .rc-ya    { color: #a7f3d0; }
      .rc-tidak { color: #fcd9a4; }
      html[data-theme="light"] .rc-ya    { color: #047857; }
      html[data-theme="light"] .rc-tidak { color: #b45309; }
      html[data-theme="light"] .rc-ya,
      html[data-theme="light"] .rc-tidak { border-bottom-color: rgba(0,0,0,0.06); }

      /* ── FOOTER ── */
      footer {
        background: rgba(0,0,0,0.4);
        border-top: 1px solid rgba(255,255,255,0.06);
        color: #475569;
        text-align: center;
        padding: 24px;
        font-size: 0.82rem;
      }

      /* ── THEME TOGGLE (pill) ── */
      .theme-toggle {
        display: flex; align-items: center; gap: 6px;
        background: rgba(251,191,36,0.13);
        border: 1.5px solid rgba(251,191,36,0.5);
        border-radius: 22px; height: 34px; padding: 0 13px;
        color: #fbbf24; cursor: pointer; font: inherit;
        font-size: 0.78rem; font-weight: 600; letter-spacing: 0.03em;
        white-space: nowrap; transition: all 0.25s;
      }
      .theme-toggle:hover {
        background: rgba(251,191,36,0.24);
        border-color: rgba(251,191,36,0.85); color: #fde68a;
      }
      .tt-icon { font-size: 0.95rem; line-height: 1; }
      html:not([data-theme="light"]) .icon-moon,
      html:not([data-theme="light"]) .label-moon { display: none; }
      html[data-theme="light"] .icon-sun,
      html[data-theme="light"] .label-sun { display: none; }

      /* =========================================================
         LIGHT MODE OVERRIDES (FIX 5.8: sebelumnya halaman review
         selalu dark dan mengabaikan tema yang dipilih user)
         ========================================================= */
      html[data-theme="light"] body { background: #f0f4ff; color: #1e293b; }
      html[data-theme="light"] nav {
        background: rgba(240,244,255,0.9);
        border-bottom-color: rgba(37,99,235,0.15);
      }
      html[data-theme="light"] .nav-logo { color: #2563eb; }
      html[data-theme="light"] .nav-links a { color: #475569; }
      html[data-theme="light"] .nav-links a:hover { color: #1e293b; }
      html[data-theme="light"] .theme-toggle {
        background: rgba(37,99,235,0.1); border-color: rgba(37,99,235,0.4); color: #2563eb;
      }
      html[data-theme="light"] .theme-toggle:hover {
        background: rgba(37,99,235,0.2); border-color: rgba(37,99,235,0.75); color: #1d4ed8;
      }
      html[data-theme="light"] .review-hero-overlay {
        background: linear-gradient(to top,
          rgba(240,244,255,1) 0%, rgba(240,244,255,0.55) 50%, rgba(240,244,255,0.1) 100%);
      }
      html[data-theme="light"] .review-hero-content h1 { color: #1e293b; text-shadow: 0 2px 14px rgba(255,255,255,0.6); }
      html[data-theme="light"] .meta { color: #475569; }
      html[data-theme="light"] .ringkasan {
        background: rgba(37,99,235,0.07); color: #1e293b; border-left-color: #2563eb;
      }
      html[data-theme="light"] .rating-box {
        background: #ffffff; border-color: rgba(0,0,0,0.1);
      }
      html[data-theme="light"] .rating-angka { color: #2563eb; text-shadow: none; }
      html[data-theme="light"] .rating-label { color: #64748b; }
      html[data-theme="light"] .artikel-konten h2 {
        color: #1e293b; border-bottom-color: rgba(0,0,0,0.1);
      }
      html[data-theme="light"] .artikel-konten p { color: #475569; }
      html[data-theme="light"] .spek-table {
        border-color: rgba(37,99,235,0.22);
        box-shadow: 0 2px 10px rgba(15,23,42,0.08);
      }
      html[data-theme="light"] .spek-table td { border-bottom-color: rgba(0,0,0,0.07); }
      html[data-theme="light"] .spek-table tr:nth-child(even) { background: rgba(37,99,235,0.05); }
      html[data-theme="light"] .spek-table tr:nth-child(odd)  { background: rgba(0,0,0,0.012); }
      html[data-theme="light"] .spek-table tr:hover { background: rgba(37,99,235,0.11); }
      html[data-theme="light"] .spek-table td:first-child {
        color: #1d4ed8;
        border-left-color: rgba(37,99,235,0.55);
        border-right-color: rgba(37,99,235,0.18);
        background: rgba(37,99,235,0.05);
      }
      html[data-theme="light"] .spek-table td:last-child  { color: #0f172a; }
      html[data-theme="light"] .pros, html[data-theme="light"] .cons {
        background: #ffffff; border-color: rgba(0,0,0,0.08);
      }
      html[data-theme="light"] .pros ul, html[data-theme="light"] .cons ul { color: #475569; }
      html[data-theme="light"] .sidebar-card {
        background: #ffffff; border-color: rgba(0,0,0,0.1);
      }
      html[data-theme="light"] .sidebar-card h3 { color: #1e293b; }
      html[data-theme="light"] .sidebar-card p { color: #475569; }
      html[data-theme="light"] .harga-display { color: #059669; }
      html[data-theme="light"] .disclaimer { color: #64748b; }
      html[data-theme="light"] footer {
        background: rgba(220,230,255,0.6);
        border-top-color: rgba(0,0,0,0.06); color: #64748b;
      }
    </style>
  </head>
  <body>
    <!-- NAV -->
    <nav>
      <div class="nav-inner">
        <a href="/" class="nav-logo">🚀 AstroLaptop</a>
        <div style="display:flex;align-items:center;gap:18px;">
          <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/hotdeals">🔥 Hot Deals</a></li>
            <li><a href="/review">Review</a></li>
            <li><a href="/compare">Perbandingan</a></li>
            <li><a href="/h2h">H2H</a></li>
            <li><a href="/tentang">Tentang</a></li>
          </ul>
          <button class="theme-toggle" id="themeToggle" aria-label="Ganti tema terang/gelap">
            <span class="tt-icon icon-sun">☀️</span><span class="theme-label label-sun">Sunrise</span>
            <span class="tt-icon icon-moon">🌙</span><span class="theme-label label-moon">Sunset</span>
          </button>
        </div>
      </div>
    </nav>

    <!-- HERO BANNER -->
    <div class="review-hero">
      <div class="review-hero-bg" style={`background-image: url('${bg}');`}></div>
      <div class="review-hero-overlay"></div>
      <div class="review-hero-content">
        <span class="badge" style={`background:${bColor};`}>{kategori}</span>
        {update && <span class="badge-update">Update: {update}</span>}
        {hargaUpdate && <span class="badge-harga">[ Harga {hargaUpdate} ]</span>}
        {rare && <span class="badge-rare">[ Rare ]</span>}
        <h1>Review {title}</h1>
        <div class="meta">Diterbitkan: {tanggal}</div>
      </div>
    </div>

    <!-- MAIN -->
    <div class="container">
      <article>
        <div class="ringkasan">{ringkasan}</div>

        <!-- RATING -->
        <div class="rating-box">
          <div class="rating-angka">{rating}</div>
          <div class="rating-bintang">
            {Array.from({length: 5}).map((_, i) => (
              <span>{i < bintang ? '⭐' : '☆'}</span>
            ))}
          </div>
          <div class="rating-label">Skor keseluruhan dari 5</div>
        </div>

        <div class="artikel-konten">
          <slot />
        </div>
      </article>

      <!-- SIDEBAR -->
      <aside class="sidebar">
        <div class="sidebar-card">
          <h3>💰 Harga</h3>
          <div class="harga-display">{harga}</div>
          <a href={tokoHref} class="btn-beli"
             target={tokoExt ? '_blank' : undefined}
             rel={tokoExt ? 'nofollow sponsored noopener' : undefined}>🛒 Beli di Tokopedia</a>
          <a href={shopHref} class="btn-beli-secondary"
             target={shopExt ? '_blank' : undefined}
             rel={shopExt ? 'nofollow sponsored noopener' : undefined}>🛍️ Beli di Shopee</a>
          <p class="disclaimer">*Link afiliasi — harga dapat berubah</p>
        </div>

        <div class="sidebar-card">
          <h3>⚡ Ringkasan Cepat</h3>
          {ringkas.cocok.map((t) => <p class="rc-ya">✅ {t}</p>)}
          {ringkas.kurang.map((t) => <p class="rc-tidak">⚠️ {t}</p>)}
        </div>
      </aside>
    </div>

    <footer>
      <p>© 2025 AstroLaptop · Review laptop jujur untuk semua kalangan</p>
    </footer>

    <script>
      /* Theme toggle light/dark, sinkron dengan localStorage 'theme' */
      (function () {
        const root = document.documentElement;
        const btn  = document.getElementById('themeToggle');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const isLight = root.getAttribute('data-theme') === 'light';
          if (isLight) {
            root.removeAttribute('data-theme');
            localStorage.setItem('theme', 'dark');
          } else {
            root.setAttribute('data-theme', 'light');
            localStorage.setItem('theme', 'light');
          }
        });
      })();
    </script>
  </body>
</html>
