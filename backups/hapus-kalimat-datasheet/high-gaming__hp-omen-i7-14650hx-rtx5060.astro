---
import ReviewLayout from '../../../layouts/ReviewLayout.astro';
---

<ReviewLayout
  title="HP Omen i7-14650HX RTX 5060"
  harga=" - "
  rating={4.3}
  kategori="High Gaming"
  tanggal="22 Juli 2026"
  ringkasan="HP Omen varian Intel memasangkan Core i7-14650HX dengan RTX 5060 8 GB di TGP 115 W, panel WQXGA 180 Hz 100% sRGB, dan RAM 24 GB DDR5 yang masih bisa di-upgrade. Garansi 2 tahun plus 2 tahun ADP jadi salah satu yang terpanjang, namun tradeoffnya adalah baterai yang cuman 70 Wh."
>

  <h2>Spesifikasi</h2>
  <table class="spek-table">
    <tr><td>CPU</td><td>Intel Core i7-14650HX</td></tr>
    <tr><td>GPU</td><td>NVIDIA RTX 5060 8 GB - TGP 115 W</td></tr>
    <tr><td>Layar</td><td>WQXGA (2560x1600) 180 Hz, 100% sRGB</td></tr>
    <tr><td>RAM</td><td>24 GB DDR5 (upgradeable)</td></tr>
    <tr><td>Upgrade</td><td>RAM & SSD (slot tersedia)</td></tr>
    <tr><td>Baterai / Charger</td><td>70 Wh / 230-280 W</td></tr>
    <tr><td>Cooling</td><td>2x Fan</td></tr>
    <tr><td>Bobot</td><td>±2.21 kg</td></tr>
    <tr><td>Garansi</td><td>2 Tahun + 2 Tahun ADP</td></tr>
    <tr><td>OS</td><td>Windows 11</td></tr>
    <tr><td>Merk</td><td>HP</td></tr>
    <tr><td>Harga</td><td> - </td></tr>
  </table>

  <p style="font-size:0.85rem;color:#f59e0b;"><strong>Catatan data:</strong> Nama produk pada sumber tertulis "HyperXomen" - diinterpretasikan sebagai HP Omen. Mohon konfirmasi.</p>


